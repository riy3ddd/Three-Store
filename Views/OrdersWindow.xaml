<Window x:Class="WpfApp1.Views.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="طلبيات العملاء"
        Width="1350"
        Height="800"
        MinWidth="1150"
        MinHeight="700"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="#0F172A">

    <Window.Resources>

        <!-- =========================================================
             SHADOW
        ========================================================== -->

        <DropShadowEffect x:Key="CardShadow"
                          Color="#020617"
                          Opacity="0.08"
                          BlurRadius="18"
                          ShadowDepth="3"
                          Direction="270"/>


        <!-- =========================================================
             TAB BUTTON
        ========================================================== -->

        <Style x:Key="TabButtonStyle"
               TargetType="Button">

            <Setter Property="Margin"
                    Value="4"/>

            <Setter Property="Padding"
                    Value="20,10"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#64748B"/>

            <Setter Property="Background"
                    Value="#F8FAFC"/>

            <Setter Property="BorderBrush"
                    Value="#E2E8F0"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="#FAFCFF"/>

                                <Setter TargetName="border"
                                        Property="BorderBrush"
                                        Value="#BFDBFE"/>

                                <Setter Property="Foreground"
                                        Value="#F8FBFF"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="#DBEAFE"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- =========================================================
             DATA GRID HEADER
        ========================================================== -->

        <Style TargetType="DataGridColumnHeader">

            <Setter Property="Background"
                    Value="#F8FAFC"/>

            <Setter Property="Foreground"
                    Value="#475569"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Padding"
                    Value="0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="BorderBrush"
                    Value="#E2E8F0"/>

            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>

        </Style>


        <!-- =========================================================
             DATA GRID ROW
        ========================================================== -->

        <Style TargetType="DataGridRow">

            <Setter Property="Height"
                    Value="60"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#F8FAFC"/>

                </Trigger>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="#EFF6FF"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- =========================================================
             DATA GRID CELL
        ========================================================== -->

        <Style TargetType="DataGridCell">

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>

            <Setter Property="BorderBrush"
                    Value="#F1F5F9"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Foreground"
                    Value="#334155"/>

            <Setter Property="Padding"
                    Value="6,0"/>

            <Style.Triggers>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Foreground"
                            Value="#1D4ED8"/>

                </Trigger>

            </Style.Triggers>

        </Style>

    </Window.Resources>


    <!-- =============================================================
         MAIN CONTAINER
    ============================================================= -->

    <Grid Margin="24">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- =========================================================
             HEADER
        ========================================================== -->

        <Grid Grid.Row="0"
              Margin="0,0,0,20">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>


            <!-- TITLE -->

            <StackPanel Grid.Column="0"
                        VerticalAlignment="Center">

                <TextBlock Text="طلبيات العملاء"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock Text="إدارة ومتابعة جميع طلبيات العملاء بمرونة وسهولة"
                           Margin="0,5,0,0"
                           FontSize="13"
                           Foreground="#94A3B8"/>

            </StackPanel>


            <!-- ADD ORDER -->

            <Button x:Name="AddOrderButton"
                    Grid.Column="1"
                    Click="AddOrderButton_Click"
                    Background="#3B82F6"
                    Foreground="White"
                    BorderThickness="0"
                    Padding="22,12"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Margin="15,0,0,0">

                <Button.Template>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="AddButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="+"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Margin="0,-2,8,0"
                                           VerticalAlignment="Center"/>

                                <TextBlock Text="إضافة طلبية"
                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="AddButtonBorder"
                                        Property="Background"
                                        Value="#2563EB"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="AddButtonBorder"
                                        Property="Background"
                                        Value="#1D4ED8"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Button.Template>

            </Button>

        </Grid>


        <!-- =========================================================
             STATUS FILTERS
        ========================================================== -->

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="10"
                Margin="0,0,0,16"
                Effect="{StaticResource CardShadow}">

            <WrapPanel HorizontalAlignment="Center"
                       VerticalAlignment="Center">

                <Button Content="الجميع"
                        Click="AllButton_Click"
                        Style="{StaticResource TabButtonStyle}"/>

                <Button Content="قيد الانتظار"
                        Click="PendingButton_Click"
                        Style="{StaticResource TabButtonStyle}"/>

                <Button Content="الجاهزة"
                        Click="ReadyButton_Click"
                        Style="{StaticResource TabButtonStyle}"/>

                <Button Content="تمت"
                        Click="CompletedButton_Click"
                        Style="{StaticResource TabButtonStyle}"/>

                <Button Content="تم التسليم"
                        Click="DeliveredButton_Click"
                        Style="{StaticResource TabButtonStyle}"/>

                <Button Content="الملغية"
                        Click="CancelledButton_Click"
                        Style="{StaticResource TabButtonStyle}"/>

            </WrapPanel>

        </Border>


        <!-- =========================================================
             INFO BAR
        ========================================================== -->

        <Border Grid.Row="2"
                Background="#EFF6FF"
                BorderBrush="#DBEAFE"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14"
                Margin="0,0,0,16">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <TextBlock Text="💡"
                           FontSize="13"
                           Margin="0,0,6,0"
                           VerticalAlignment="Center"/>

                <TextBlock Text="اضغط مرتين على أي طلبية لعرض بيانات العميل والتفاصيل الكاملة."
                           Foreground="#1E40AF"
                           FontSize="13"
                           FontWeight="Medium"
                           VerticalAlignment="Center"/>

            </StackPanel>

        </Border>


        <!-- =========================================================
             ORDERS TABLE
        ========================================================== -->

        <Border Grid.Row="3"
                Background="White"
                CornerRadius="14"
                Padding="8"
                Effect="{StaticResource CardShadow}">

            <DataGrid x:Name="OrdersGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      CanUserResizeColumns="False"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F1F5F9"
                      VerticalGridLinesBrush="#F8FAFC"
                      Background="White"
                      BorderThickness="0"
                      HeadersVisibility="Column"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      RowHeaderWidth="0"
                      RowHeight="60"
                      ColumnHeaderHeight="48"
                      MouseDoubleClick="OrdersGrid_MouseDoubleClick"
                      LoadingRow="OrdersGrid_LoadingRow"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">


                <DataGrid.Columns>


                    <!-- =================================================
                         العميل
                    ================================================== -->

                    <DataGridTemplateColumn Header="العميل"
                                            Width="1.45*"
                                            MinWidth="180">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <Grid HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center">

                                    <TextBlock Text="{Binding CustomerName}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#1E293B"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="190"/>

                                </Grid>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>


                    <!-- =================================================
                         رقم الهاتف
                    ================================================== -->

                    <DataGridTemplateColumn Header="رقم الهاتف"
                                            Width="1.35*"
                                            MinWidth="170">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <Grid HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center">

                                    <TextBlock Text="{Binding CustomerPhone}"
                                               FontSize="13"
                                               Foreground="#334155"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"/>

                                </Grid>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>


                    <!-- =================================================
                         المنتج
                    ================================================== -->

                    <DataGridTemplateColumn Header="المنتج"
                                            Width="1.65*"
                                            MinWidth="190">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <Grid HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center">

                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center">

                                        <TextBlock Text="{Binding ProductName}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1E293B"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="220"/>

                                        <Border Background="#FFF7ED"
                                                CornerRadius="5"
                                                Padding="7,2"
                                                Margin="0,4,0,0"
                                                HorizontalAlignment="Center">

                                            <TextBlock Text="منتج يدوي"
                                                       FontSize="10"
                                                       Foreground="#EA580C">

                                                <TextBlock.Style>

                                                    <Style TargetType="TextBlock">

                                                        <Setter Property="Visibility"
                                                                Value="Collapsed"/>

                                                        <Style.Triggers>

                                                            <DataTrigger Binding="{Binding IsManualProduct}"
                                                                         Value="True">

                                                                <Setter Property="Visibility"
                                                                        Value="Visible"/>

                                                            </DataTrigger>

                                                            <DataTrigger Binding="{Binding IsManualProduct}"
                                                                         Value="1">

                                                                <Setter Property="Visibility"
                                                                        Value="Visible"/>

                                                            </DataTrigger>

                                                        </Style.Triggers>

                                                    </Style>

                                                </TextBlock.Style>

                                            </TextBlock>

                                        </Border>

                                    </StackPanel>

                                </Grid>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>


                    <!-- =================================================
                         الكمية
                    ================================================== -->

                    <DataGridTemplateColumn Header="الكمية"
                                            Width="0.75*"
                                            MinWidth="100">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <Grid HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center">

                                    <Border Background="#F8FAFC"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="7"
                                            Padding="12,5"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">

                                        <TextBlock Text="{Binding Quantity}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#334155"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"/>

                                    </Border>

                                </Grid>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>


                    <!-- =================================================
                         التاريخ والوقت
                    ================================================== -->

                    <DataGridTemplateColumn Header="التاريخ والوقت"
                                            Width="1.55*"
                                            MinWidth="190">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <Grid HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center">

                                    <TextBlock FontSize="13"
                                               Foreground="#334155"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center">

                                        <TextBlock.Text>

                                            <Binding Path="OrderDate"
                                                     StringFormat="{}{0:yyyy/MM/dd - HH:mm}"/>

                                        </TextBlock.Text>

                                    </TextBlock>

                                </Grid>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>


                    <!-- =================================================
                         الحالة
                    ================================================== -->

                    <DataGridTemplateColumn Header="الحالة"
                                            Width="1.25*"
                                            MinWidth="150">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <Grid HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center">

                                    <ComboBox Width="130"
                                              Height="34"
                                              SelectedValuePath="Content"
                                              SelectedValue="{Binding Status, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectionChanged="StatusComboBox_SelectionChanged"
                                              VerticalContentAlignment="Center"
                                              HorizontalContentAlignment="Center"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center">

                                        <ComboBoxItem Content="قيد الانتظار"/>
                                        <ComboBoxItem Content="الجاهزة"/>
                                        <ComboBoxItem Content="تمت"/>
                                        <ComboBoxItem Content="تم التسليم"/>
                                        <ComboBoxItem Content="الملغية"/>

                                    </ComboBox>

                                </Grid>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>


                    <!-- =================================================
                         الإجراء
                    ================================================== -->

                    <DataGridTemplateColumn Header="الإجراء"
                                            Width="1.10*"
                                            MinWidth="140">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <Grid HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center">

                                    <Button Content="حفظ التعديل"
                                            Click="SaveStatusButton_Click"
                                            Height="34"
                                            Padding="14,0"
                                            Background="#A7F3D0
"
                                            Foreground="#475569"
                                            BorderBrush="#A7F3D0"
                                            BorderThickness="1"
                                            Cursor="Hand"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">

                                        <Button.Template>

                                            <ControlTemplate TargetType="Button">

                                                <Border x:Name="SaveButtonBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="7"
                                                        Padding="{TemplateBinding Padding}">

                                                    <ContentPresenter
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>

                                                </Border>

                                                <ControlTemplate.Triggers>

                                                    <Trigger Property="IsMouseOver"
                                                             Value="True">

                                                        <Setter TargetName="SaveButtonBorder"
                                                                Property="Background"
                                                                Value="#3B82F6"/>

                                                        <Setter TargetName="SaveButtonBorder"
                                                                Property="BorderBrush"
                                                                Value="#3B82F6"/>

                                                        <Setter Property="Foreground"
                                                                Value="White"/>

                                                    </Trigger>

                                                    <Trigger Property="IsPressed"
                                                             Value="True">

                                                        <Setter TargetName="SaveButtonBorder"
                                                                Property="Background"
                                                                Value="#1D4ED8"/>

                                                    </Trigger>

                                                </ControlTemplate.Triggers>

                                            </ControlTemplate>

                                        </Button.Template>

                                    </Button>

                                </Grid>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>


                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</Window>