<Window x:Class="WpfApp1.Views.OffersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="العروض"
        Height="780"
        Width="1280"
        MinHeight="680"
        MinWidth="1050"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="#F5F7FB"
        FontFamily="Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>

        <!-- =========================================================
             COLORS
        ========================================================== -->

        <SolidColorBrush x:Key="PrimaryBrush"
                         Color="#2563EB"/>

        <SolidColorBrush x:Key="PrimaryHoverBrush"
                         Color="#1D4ED8"/>

        <SolidColorBrush x:Key="PrimaryLightBrush"
                         Color="#EFF6FF"/>

        <SolidColorBrush x:Key="TextDarkBrush"
                         Color="#172033"/>

        <SolidColorBrush x:Key="TextBrush"
                         Color="#334155"/>

        <SolidColorBrush x:Key="TextSecondaryBrush"
                         Color="#64748B"/>

        <SolidColorBrush x:Key="TextMutedBrush"
                         Color="#94A3B8"/>

        <SolidColorBrush x:Key="BorderBrushLight"
                         Color="#E8EDF4"/>

        <SolidColorBrush x:Key="SurfaceBrush"
                         Color="#FFFFFF"/>


        <!-- =========================================================
             SHADOWS
        ========================================================== -->

        <DropShadowEffect x:Key="SoftShadow"
                          Color="#64748B"
                          Opacity="0.09"
                          BlurRadius="22"
                          ShadowDepth="3"/>

        <DropShadowEffect x:Key="SmallShadow"
                          Color="#64748B"
                          Opacity="0.07"
                          BlurRadius="14"
                          ShadowDepth="2"/>


        <!-- =========================================================
             PRIMARY BUTTON
        ========================================================== -->

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="46"/>

            <Setter Property="MinWidth"
                    Value="145"/>

            <Setter Property="Padding"
                    Value="20,0"/>

            <Setter Property="Background"
                    Value="{StaticResource PrimaryBrush}"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="11"
                                SnapsToDevicePixels="True">

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Margin="{TemplateBinding Padding}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource PrimaryHoverBrush}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.88"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.45"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- =========================================================
             ACTION BUTTON
        ========================================================== -->

        <Style x:Key="ActionButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="35"/>

            <Setter Property="Padding"
                    Value="13,0"/>

            <Setter Property="Margin"
                    Value="3,0"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Margin="{TemplateBinding Padding}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.78"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.60"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- =========================================================
             DATA GRID HEADER
        ========================================================== -->

        <Style TargetType="DataGridColumnHeader">

            <Setter Property="Background"
                    Value="#F8FAFC"/>

            <Setter Property="Foreground"
                    Value="#475569"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Padding"
                    Value="8,0"/>

            <Setter Property="Height"
                    Value="48"/>

            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>

            <Setter Property="BorderBrush"
                    Value="#E2E8F0"/>

        </Style>


        <!-- =========================================================
             DATA GRID ROW
        ========================================================== -->

        <Style TargetType="DataGridRow">

            <Setter Property="Height"
                    Value="58"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#F1F5F9"/>

            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>

            <Setter Property="SnapsToDevicePixels"
                    Value="True"/>

            <Style.Triggers>

                <!-- Hover -->
                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#F8FBFF"/>

                </Trigger>


                <!-- Selected -->
                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="#F5F8FF"/>

                    <Setter Property="BorderBrush"
                            Value="#E6EDFF"/>

                </Trigger>


                <!-- Selected + Hover -->
                <MultiTrigger>

                    <MultiTrigger.Conditions>

                        <Condition Property="IsSelected"
                                   Value="True"/>

                        <Condition Property="IsMouseOver"
                                   Value="True"/>

                    </MultiTrigger.Conditions>

                    <Setter Property="Background"
                            Value="#F1F6FF"/>

                    <Setter Property="BorderBrush"
                            Value="#DCE7FF"/>

                </MultiTrigger>

            </Style.Triggers>

        </Style>


        <!-- =========================================================
             DATA GRID CELL
        ========================================================== -->

        <Style TargetType="DataGridCell">

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="8,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Style.Triggers>

                <!--
                    Remove the default WPF blue selection
                    from individual cells.
                -->

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="Transparent"/>

                    <Setter Property="Foreground"
                            Value="#334155"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- =========================================================
             STAT CARD
        ========================================================== -->

        <Style x:Key="StatCardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="CornerRadius"
                    Value="16"/>

            <Setter Property="Padding"
                    Value="20"/>

            <Setter Property="Effect"
                    Value="{StaticResource SmallShadow}"/>

        </Style>

    </Window.Resources>


    <!-- =============================================================
         MAIN PAGE
    ============================================================= -->

    <Grid Margin="28">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- =========================================================
             HEADER
        ========================================================== -->

        <Border Grid.Row="0"
                Background="White"
                CornerRadius="18"
                Padding="24"
                Margin="0,0,0,20"
                Effect="{StaticResource SoftShadow}">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <!-- TITLE -->

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">

                    <StackPanel Orientation="Horizontal">

                        <Border Width="48"
                                Height="48"
                                CornerRadius="14"
                                Background="#EFF6FF">

                            <TextBlock Text="🏷"
                                       FontSize="24"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>


                        <StackPanel Margin="15,0,0,0"
                                    VerticalAlignment="Center">

                            <TextBlock Text="إدارة العروض"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Foreground="#172033"/>

                            <TextBlock Text="إدارة الخصومات والعروض الخاصة بالمنتجات"
                                       FontSize="13"
                                       Foreground="#64748B"
                                       Margin="0,5,0,0"/>

                        </StackPanel>

                    </StackPanel>

                </StackPanel>


                <!-- ADD OFFER -->

                <Button Grid.Column="1"
                        Content="+  إضافة عرض"
                        Width="155"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="AddOfferButton_Click"/>

            </Grid>

        </Border>


        <!-- =========================================================
             STATISTICS
        ========================================================== -->

        <Grid Grid.Row="1"
              Margin="0,0,0,20">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="18"/>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="18"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>


            <!-- ACTIVE OFFERS -->

            <Border Grid.Column="0"
                    Style="{StaticResource StatCardStyle}">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <Border Grid.Column="0"
                            Width="54"
                            Height="54"
                            CornerRadius="15"
                            Background="#EFF6FF">

                        <TextBlock Text="✓"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="#2563EB"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>


                    <StackPanel Grid.Column="1"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="العروض النشطة"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#64748B"/>

                        <TextBlock x:Name="ActiveOffersTextBlock"
                                   Text="0"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="#2563EB"
                                   Margin="0,3,0,0"/>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- TOTAL DISCOUNTS -->

            <Border Grid.Column="2"
                    Style="{StaticResource StatCardStyle}">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <Border Grid.Column="0"
                            Width="54"
                            Height="54"
                            CornerRadius="15"
                            Background="#ECFDF5">

                        <TextBlock Text="%"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="#16A34A"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>


                    <StackPanel Grid.Column="1"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="إجمالي الخصومات"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#64748B"/>

                        <TextBlock x:Name="TotalDiscountTextBlock"
                                   Text="0.00 ج.م"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#16A34A"
                                   Margin="0,3,0,0"/>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- PRODUCTS -->

            <Border Grid.Column="4"
                    Style="{StaticResource StatCardStyle}">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <Border Grid.Column="0"
                            Width="54"
                            Height="54"
                            CornerRadius="15"
                            Background="#F5F3FF">

                        <TextBlock Text="▦"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="#7C3AED"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>


                    <StackPanel Grid.Column="1"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="المنتجات المعروضة"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#64748B"/>

                        <TextBlock x:Name="ProductsWithOffersTextBlock"
                                   Text="0"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="#7C3AED"
                                   Margin="0,3,0,0"/>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>


        <!-- =========================================================
             TABLE
        ========================================================== -->

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="18"
                Padding="18"
                Effect="{StaticResource SoftShadow}">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>


                <!-- TABLE HEADER -->

                <Grid Grid.Row="0"
                      Margin="4,2,4,15">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>


                    <StackPanel Grid.Column="0">

                        <TextBlock Text="سجل العروض"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#172033"/>

                        <TextBlock Text="جميع العروض والخصومات المسجلة في النظام"
                                   FontSize="12"
                                   Foreground="#94A3B8"
                                   Margin="0,4,0,0"/>

                    </StackPanel>


                    <Border Grid.Column="1"
                            Background="#F8FAFC"
                            BorderBrush="#E8EDF4"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="13,7">

                        <TextBlock Text="قائمة العروض"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#64748B"/>

                    </Border>

                </Grid>


                <!-- =================================================
                     DATA GRID
                ================================================== -->

                <DataGrid x:Name="OffersDataGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          CanUserSortColumns="True"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EEF2F7"
                          VerticalGridLinesBrush="Transparent"
                          RowHeight="58"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          Background="White"
                          Foreground="#334155"
                          AlternationCount="2"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">


                    <DataGrid.Columns>


                        <!-- PRODUCT -->

                        <DataGridTextColumn Header="المنتج"
                                            Binding="{Binding ProductName}"
                                            Width="2*">

                            <DataGridTextColumn.ElementStyle>

                                <Style TargetType="TextBlock">

                                    <Setter Property="HorizontalAlignment"
                                            Value="Center"/>

                                    <Setter Property="VerticalAlignment"
                                            Value="Center"/>

                                    <Setter Property="TextAlignment"
                                            Value="Center"/>

                                    <Setter Property="FontSize"
                                            Value="13"/>

                                    <Setter Property="FontWeight"
                                            Value="SemiBold"/>

                                    <Setter Property="Foreground"
                                            Value="#1E293B"/>

                                </Style>

                            </DataGridTextColumn.ElementStyle>

                        </DataGridTextColumn>


                        <!-- ORIGINAL PRICE -->

                        <DataGridTextColumn Header="السعر الأصلي"
                                            Binding="{Binding OriginalPrice, StringFormat={}{0:N2} ج.م}"
                                            Width="1.25*">

                            <DataGridTextColumn.ElementStyle>

                                <Style TargetType="TextBlock">

                                    <Setter Property="HorizontalAlignment"
                                            Value="Center"/>

                                    <Setter Property="VerticalAlignment"
                                            Value="Center"/>

                                    <Setter Property="TextAlignment"
                                            Value="Center"/>

                                    <Setter Property="FontSize"
                                            Value="13"/>

                                    <Setter Property="Foreground"
                                            Value="#64748B"/>

                                </Style>

                            </DataGridTextColumn.ElementStyle>

                        </DataGridTextColumn>


                        <!-- OFFER PRICE -->

                        <DataGridTextColumn Header="سعر العرض"
                                            Binding="{Binding OfferPrice, StringFormat={}{0:N2} ج.م}"
                                            Width="1.25*">

                            <DataGridTextColumn.ElementStyle>

                                <Style TargetType="TextBlock">

                                    <Setter Property="HorizontalAlignment"
                                            Value="Center"/>

                                    <Setter Property="VerticalAlignment"
                                            Value="Center"/>

                                    <Setter Property="TextAlignment"
                                            Value="Center"/>

                                    <Setter Property="FontSize"
                                            Value="13"/>

                                    <Setter Property="FontWeight"
                                            Value="Bold"/>

                                    <Setter Property="Foreground"
                                            Value="#16A34A"/>

                                </Style>

                            </DataGridTextColumn.ElementStyle>

                        </DataGridTextColumn>


                        <!-- DISCOUNT -->

                        <DataGridTextColumn Header="الخصم"
                                            Binding="{Binding DiscountPercent, StringFormat={}{0:N1}%}"
                                            Width="1*">

                            <DataGridTextColumn.ElementStyle>

                                <Style TargetType="TextBlock">

                                    <Setter Property="HorizontalAlignment"
                                            Value="Center"/>

                                    <Setter Property="VerticalAlignment"
                                            Value="Center"/>

                                    <Setter Property="TextAlignment"
                                            Value="Center"/>

                                    <Setter Property="FontSize"
                                            Value="13"/>

                                    <Setter Property="FontWeight"
                                            Value="Bold"/>

                                    <Setter Property="Foreground"
                                            Value="#DC2626"/>

                                </Style>

                            </DataGridTextColumn.ElementStyle>

                        </DataGridTextColumn>


                        <!-- START DATE -->

                        <DataGridTextColumn Header="بداية العرض"
                                            Binding="{Binding StartDate, StringFormat=dd/MM/yyyy}"
                                            Width="1.15*">

                            <DataGridTextColumn.ElementStyle>

                                <Style TargetType="TextBlock">

                                    <Setter Property="HorizontalAlignment"
                                            Value="Center"/>

                                    <Setter Property="VerticalAlignment"
                                            Value="Center"/>

                                    <Setter Property="TextAlignment"
                                            Value="Center"/>

                                    <Setter Property="FontSize"
                                            Value="13"/>

                                    <Setter Property="Foreground"
                                            Value="#64748B"/>

                                </Style>

                            </DataGridTextColumn.ElementStyle>

                        </DataGridTextColumn>


                        <!-- STATUS -->

                        <DataGridTemplateColumn Header="الحالة"
                                                Width="1.05*">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <Border CornerRadius="9"
                                            Padding="12,6"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">

                                        <Border.Style>

                                            <Style TargetType="Border">

                                                <Setter Property="Background"
                                                        Value="#ECFDF5"/>

                                                <Setter Property="BorderBrush"
                                                        Value="#BBF7D0"/>

                                                <Setter Property="BorderThickness"
                                                        Value="1"/>

                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding IsActive}"
                                                                 Value="False">

                                                        <Setter Property="Background"
                                                                Value="#FFF7ED"/>

                                                        <Setter Property="BorderBrush"
                                                                Value="#FED7AA"/>

                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>

                                        </Border.Style>


                                        <TextBlock Text="{Binding StatusText}"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">

                                            <TextBlock.Style>

                                                <Style TargetType="TextBlock">

                                                    <Setter Property="Foreground"
                                                            Value="#15803D"/>

                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding IsActive}"
                                                                     Value="False">

                                                            <Setter Property="Foreground"
                                                                    Value="#C2410C"/>

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </TextBlock.Style>

                                        </TextBlock>

                                    </Border>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>


                        <!-- ACTIONS -->

                        <DataGridTemplateColumn Header="الإجراءات"
                                                Width="285">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">


                                        <!-- EDIT -->

                                        <Button Content="تعديل"
                                                Width="70"
                                                Style="{StaticResource ActionButtonStyle}"
                                                Background="#F8FAFC"
                                                Foreground="#334155"
                                                BorderBrush="#CBD5E1"
                                                Click="EditOfferButton_Click"/>


                                        <!-- TOGGLE -->

                                        <Button Width="82"
                                                Height="35"
                                                Margin="3,0"
                                                Padding="10,0"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Cursor="Hand"
                                                BorderThickness="1"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                Click="ToggleOfferButton_Click">

                                            <Button.Style>

                                                <Style TargetType="Button">

                                                    <Setter Property="Background"
                                                            Value="#FFF7ED"/>

                                                    <Setter Property="Foreground"
                                                            Value="#B45309"/>

                                                    <Setter Property="BorderBrush"
                                                            Value="#FDBA74"/>

                                                    <Setter Property="Content"
                                                            Value="إيقاف"/>

                                                    <Setter Property="Template">

                                                        <Setter.Value>

                                                            <ControlTemplate TargetType="Button">

                                                                <Border x:Name="ToggleBorder"
                                                                        Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        CornerRadius="8">

                                                                    <ContentPresenter
                                                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                        Margin="{TemplateBinding Padding}"/>

                                                                </Border>

                                                                <ControlTemplate.Triggers>

                                                                    <Trigger Property="IsMouseOver"
                                                                             Value="True">

                                                                        <Setter TargetName="ToggleBorder"
                                                                                Property="Opacity"
                                                                                Value="0.78"/>

                                                                    </Trigger>

                                                                    <Trigger Property="IsPressed"
                                                                             Value="True">

                                                                        <Setter TargetName="ToggleBorder"
                                                                                Property="Opacity"
                                                                                Value="0.60"/>

                                                                    </Trigger>

                                                                </ControlTemplate.Triggers>

                                                            </ControlTemplate>

                                                        </Setter.Value>

                                                    </Setter>


                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding IsActive}"
                                                                     Value="False">

                                                            <Setter Property="Content"
                                                                    Value="تشغيل"/>

                                                            <Setter Property="Background"
                                                                    Value="#F0FDF4"/>

                                                            <Setter Property="Foreground"
                                                                    Value="#15803D"/>

                                                            <Setter Property="BorderBrush"
                                                                    Value="#86EFAC"/>

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </Button.Style>

                                        </Button>


                                        <!-- DELETE -->

                                        <Button Content="حذف"
                                                Width="70"
                                                Style="{StaticResource ActionButtonStyle}"
                                                Background="#FFF7F7"
                                                Foreground="#DC2626"
                                                BorderBrush="#FECACA"
                                                Click="DeleteOfferButton_Click"/>

                                    </StackPanel>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>


                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

        </Border>

    </Grid>

</Window>