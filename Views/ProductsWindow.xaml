<Window x:Class="WpfApp1.Views.ProductsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إدارة المنتجات والمخزون"
        Height="800"
        Width="1350"
        FlowDirection="RightToLeft"
        FontFamily="29 LT BUKRA REGULAR"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9">

    <Window.Resources>

        <!-- ===================================================== -->
        <!-- ستايل عصري للأزرار العامة -->
        <!-- ===================================================== -->

        <Style TargetType="Button"
               x:Key="ModernButtonStyle">

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ===================================================== -->
        <!-- ستايل مخصص للـ TextBox -->
        <!-- ===================================================== -->

        <Style TargetType="TextBox">

            <Setter Property="BorderBrush"
                    Value="#CBD5E1"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">

                            <ScrollViewer x:Name="PART_ContentHost"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ===================================================== -->
        <!-- ستايل قيم أعمدة المنتجات -->
        <!-- ===================================================== -->

        <Style x:Key="ProductCellTextStyle"
               TargetType="TextBlock">

            <Setter Property="HorizontalAlignment"
                    Value="Center"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="TextAlignment"
                    Value="Center"/>

            <Setter Property="TextWrapping"
                    Value="NoWrap"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="Foreground"
                    Value="#1E293B"/>

        </Style>


        <!-- ===================================================== -->
        <!-- ستايل عناوين الأعمدة -->
        <!-- ===================================================== -->

        <Style TargetType="DataGridColumnHeader">

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="FontSize"
                    Value="16"/>

            <Setter Property="Foreground"
                    Value="#334155"/>

            <Setter Property="Background"
                    Value="#F8FAFC"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="5,0"/>

        </Style>


        <!-- ===================================================== -->
        <!-- ستايل خلايا الجدول -->
        <!-- ===================================================== -->

        <Style TargetType="DataGridCell">

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="5,0"/>

        </Style>

    </Window.Resources>


    <Grid Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- 1. عنوان الصفحة -->
        <!-- ===================================================== -->

        <Grid Grid.Row="0"
              Margin="0,0,0,15">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>


            <StackPanel Grid.Column="0"
                        VerticalAlignment="Center">

                <TextBlock Text="📦 إدارة المنتجات"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#1E293B"/>

                <TextBlock Text="تابع وأدر منتجات المحل والمخزون بكفاءة عالية"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#64748B"
                           Margin="0,4,0,0"/>

            </StackPanel>


            <!-- ================================================= -->
            <!-- زر إضافة منتج -->
            <!-- ================================================= -->

            <Button Grid.Column="1"
                    Content="+ إضافة منتج جديد"
                    Width="160"
                    Height="45"
                    Background="#2563EB"
                    Foreground="White"
                    FontSize="15"
                    FontWeight="Bold"
                    Style="{StaticResource ModernButtonStyle}"
                    Click="Button_Click"/>

        </Grid>


        <!-- ===================================================== -->
        <!-- 2. مربع البحث -->
        <!-- ===================================================== -->

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="12"
                Margin="0,0,0,15">

            <Border.Effect>

                <DropShadowEffect Color="#CBD5E1"
                                  BlurRadius="10"
                                  ShadowDepth="2"
                                  Direction="270"/>

            </Border.Effect>


            <Grid>

                <TextBox x:Name="SearchTextBox"
                         Height="48"
                         FontSize="20"
                         FontWeight="Bold"
                         Padding="1"
                         VerticalContentAlignment="Center"
                         Text="🔍 ابحث عن منتج بالاسم..."
                         Foreground="#94A3B8"
                         TextChanged="SearchTextBox_TextChanged"
                         GotFocus="SearchTextBox_GotFocus"
                         LostFocus="SearchTextBox_LostFocus"/>

            </Grid>

        </Border>


        <!-- ===================================================== -->
        <!-- 3. جدول المنتجات -->
        <!-- ===================================================== -->

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="12"
                Padding="15">

            <Border.Effect>

                <DropShadowEffect Color="#CBD5E1"
                                  BlurRadius="10"
                                  ShadowDepth="2"
                                  Direction="270"/>

            </Border.Effect>


            <DataGrid x:Name="ProductsDataGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      Background="Transparent"
                      BorderBrush="#F1F5F9"
                      FontSize="18"
                      FontWeight="Bold"
                      RowHeight="50"
                      LoadingRow="ProductsDataGrid_LoadingRow"
                      SelectionChanged="ProductsDataGrid_SelectionChanged"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      CanUserReorderColumns="False">


                <DataGrid.Columns>


                    <!-- ================================================= -->
                    <!-- الرقم -->
                    <!-- ================================================= -->

                    <DataGridTemplateColumn Header="الرقم"
                                            Width="70">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Header}"
                                           Style="{StaticResource ProductCellTextStyle}"
                                           Foreground="#475569"/>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>


                    <!-- ================================================= -->
                    <!-- التصنيف -->
                    <!-- ================================================= -->

                    <DataGridTextColumn Header="التصنيف"
                                        Binding="{Binding CategoryName}"
                                        Width="200">

                        <DataGridTextColumn.ElementStyle>

                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource ProductCellTextStyle}"/>

                        </DataGridTextColumn.ElementStyle>

                    </DataGridTextColumn>


                    <!-- ================================================= -->
                    <!-- اسم المنتج -->
                    <!-- ================================================= -->

                    <DataGridTextColumn Header="اسم المنتج"
                                        Binding="{Binding ProductName}"
                                        Width="*">

                        <DataGridTextColumn.ElementStyle>

                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource ProductCellTextStyle}"/>

                        </DataGridTextColumn.ElementStyle>

                    </DataGridTextColumn>


                    <!-- ================================================= -->
                    <!-- الكمية -->
                    <!-- ================================================= -->

                    <DataGridTextColumn Header="الكمية"
                                        Binding="{Binding Quantity}"
                                        Width="90">

                        <DataGridTextColumn.ElementStyle>

                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource ProductCellTextStyle}"/>

                        </DataGridTextColumn.ElementStyle>

                    </DataGridTextColumn>


                    <!-- ================================================= -->
                    <!-- سعر الشراء -->
                    <!-- ================================================= -->

                    <DataGridTextColumn Header="سعر الشراء"
                                        Binding="{Binding PurchasePrice}"
                                        Width="120">

                        <DataGridTextColumn.ElementStyle>

                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource ProductCellTextStyle}"/>

                        </DataGridTextColumn.ElementStyle>

                    </DataGridTextColumn>


                    <!-- ================================================= -->
                    <!-- سعر البيع -->
                    <!-- ================================================= -->

                    <DataGridTextColumn Header="سعر البيع"
                                        Binding="{Binding SellingPrice}"
                                        Width="120">

                        <DataGridTextColumn.ElementStyle>

                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource ProductCellTextStyle}"/>

                        </DataGridTextColumn.ElementStyle>

                    </DataGridTextColumn>


                    <!-- ================================================= -->
                    <!-- الإجراءات -->
                    <!-- ================================================= -->

                    <DataGridTemplateColumn Header="الإجراءات"
                                            Width="170">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">


                                    <!-- تعديل -->

                                    <Button Content="تعديل"
                                            Width="65"
                                            Height="32"
                                            Background="#DCFCE7"
                                            Foreground="#16A34A"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            BorderThickness="0"
                                            Margin="0,0,8,0"
                                            Style="{StaticResource ModernButtonStyle}"
                                            Click="EditProductButton_Click"/>


                                    <!-- حذف -->

                                    <Button Content="حذف"
                                            Width="65"
                                            Height="32"
                                            Background="#FEE2E2"
                                            Foreground="#DC2626"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            BorderThickness="0"
                                            Style="{StaticResource ModernButtonStyle}"
                                            Click="DeleteProductButton_Click"/>

                                </StackPanel>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>


                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</Window>