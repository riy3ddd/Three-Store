<Window x:Class="WpfApp1.EditUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Three Store - تعديل العضو"
        Width="510"
        Height="750"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        ResizeMode="NoResize"
        Background="#F8FAFC">

    <Window.Resources>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontFamily" Value="Calibri"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Background" Value="#FFFFFF"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="8">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsFocused"
                                     Value="True">

                                <Setter Property="BorderBrush"
                                        Value="#3B82F6"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style TargetType="{x:Type PasswordBox}">
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Background" Value="#FFFFFF"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type PasswordBox}">

                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="8">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsFocused"
                                     Value="True">

                                <Setter Property="BorderBrush"
                                        Value="#3B82F6"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontFamily" Value="Calibri"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

    </Window.Resources>


    <Grid Margin="24">

        <Border Background="White"
                CornerRadius="16"
                Padding="28,24">

            <Border.Effect>
                <DropShadowEffect Color="#000000"
                                  Direction="270"
                                  ShadowDepth="4"
                                  BlurRadius="16"
                                  Opacity="0.06"/>
            </Border.Effect>


            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel>

                    <!-- العنوان -->

                    <TextBlock Text="تعديل بيانات العضو"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               HorizontalAlignment="Center"/>


                    <TextBlock Text="قم بتحديث بيانات الحساب والصلاحيات المطلوبة"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#64748B"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,24"
                               Height="34"/>


                    <!-- اسم المستخدم -->

                    <TextBlock Text="اسم المستخدم"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#334155"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="UsernameTextBox"
                             Margin="0,0,0,16"
                             Height="54"/>


                    <!-- الصلاحية -->

                    <TextBlock Text="صلاحية العضو"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#334155"
                               Margin="0,0,0,6"/>


                    <ComboBox x:Name="RoleComboBox"
                              Margin="0,0,0,16"
                              SelectedIndex="1"
                              Height="55">

                        <ComboBoxItem Content="مشرف النظام (Admin)"
                                      Tag="Admin"/>

                        <ComboBoxItem Content="موظف (Employee)"
                                      Tag="Employee"/>

                    </ComboBox>


                    <!-- حالة الحساب -->

                    <TextBlock Text="حالة الحساب"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#334155"
                               Margin="0,0,0,6"/>


                    <ComboBox x:Name="StatusComboBox"
                              Margin="0,0,0,16"
                              SelectedIndex="0"
                              Height="54">

                        <ComboBoxItem Content="نشط"/>

                        <ComboBoxItem Content="غير نشط"/>

                    </ComboBox>


                    <!-- كلمة المرور الجديدة -->

                    <TextBlock Text="كلمة المرور الجديدة"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#334155"
                               Margin="0,0,0,6"/>


                    <PasswordBox x:Name="PasswordBox"
                                 Margin="0,0,0,4"
                                 Height="55"/>


                    <TextBlock Text="اترك الحقل فارغاً إذا كنت لا ترغب في تغيير كلمة المرور."
                               Foreground="#64748B"
                               FontSize="15"
                               Margin="0,0,0,16"/>


                    <!-- رسالة الخطأ -->

                    <TextBlock x:Name="ErrorTextBlock"
                               Foreground="#EF4444"
                               FontSize="13"
                               FontWeight="Medium"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12"/>


                    <!-- زر الحفظ -->

                    <Button Content="حفظ التعديلات"
                            Height="48"
                            Margin="0,8,0,0"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="25"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Click="SaveButton_Click">

                        <Button.Template>

                            <ControlTemplate TargetType="Button">

                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="8">

                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>

                                </Border>


                                <ControlTemplate.Triggers>

                                    <Trigger Property="IsMouseOver"
                                             Value="True">

                                        <Setter Property="Background"
                                                Value="#1D4ED8"/>

                                    </Trigger>

                                </ControlTemplate.Triggers>

                            </ControlTemplate>

                        </Button.Template>

                    </Button>

                </StackPanel>

            </ScrollViewer>

        </Border>

    </Grid>

</Window>