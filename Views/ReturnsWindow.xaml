<Window x:Class="WpfApp1.Views.ReturnsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="المسترجعات"
        Height="820"
        Width="1400"
        MinHeight="720"
        MinWidth="1150"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- =====================================================
             COLORS
             ===================================================== -->

        <SolidColorBrush x:Key="PrimaryBrush"
                         Color="#0F172A"/>

        <SolidColorBrush x:Key="RedBrush"
                         Color="#DC2626"/>

        <SolidColorBrush x:Key="GreenBrush"
                         Color="#16A34A"/>

        <SolidColorBrush x:Key="BlueBrush"
                         Color="#2563EB"/>

        <SolidColorBrush x:Key="TextBrush"
                         Color="#0F172A"/>

        <SolidColorBrush x:Key="SecondaryTextBrush"
                         Color="#64748B"/>

        <SolidColorBrush x:Key="MutedTextBrush"
                         Color="#94A3B8"/>

        <SolidColorBrush x:Key="BorderBrush"
                         Color="#E2E8F0"/>


        <!-- =====================================================
             SHADOW
             ===================================================== -->

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="18"
                          ShadowDepth="2"
                          Direction="270"
                          Opacity="0.08"/>


        <!-- =====================================================
             CARD STYLE
             ===================================================== -->

        <Style x:Key="CardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="CornerRadius"
                    Value="16"/>

            <Setter Property="BorderBrush"
                    Value="#E2E8F0"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Effect"
                    Value="{StaticResource CardShadow}"/>

        </Style>


        <!-- =====================================================
             HEADER BUTTON
             ===================================================== -->

        <Style x:Key="AddReturnButtonStyle"
               TargetType="Button">

            <Setter Property="Width"
                    Value="175"/>

            <Setter Property="Height"
                    Value="44"/>

            <Setter Property="Background"
                    Value="#16A34A"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10">

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#15803D"/>

                </Trigger>

                <Trigger Property="IsPressed"
                         Value="True">

                    <Setter Property="Background"
                            Value="#166534"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- =====================================================
             REFRESH BUTTON
             ===================================================== -->

        <Style x:Key="RefreshButtonStyle"
               TargetType="Button">

            <Setter Property="Width"
                    Value="105"/>

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="Background"
                    Value="#F1F5F9"/>

            <Setter Property="Foreground"
                    Value="#334155"/>

            <Setter Property="BorderBrush"
                    Value="#E2E8F0"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#E2E8F0"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- =====================================================
             SEARCH BOX
             ===================================================== -->

        <Style x:Key="SearchTextBoxStyle"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="FontSize"
                    Value="13.5"/>

            <Setter Property="Padding"
                    Value="42,0,14,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Background"
                    Value="#F8FAFC"/>

            <Setter Property="Foreground"
                    Value="#0F172A"/>

            <Setter Property="BorderBrush"
                    Value="#CBD5E1"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

        </Style>


        <!-- =====================================================
             DATAGRID
             ===================================================== -->

        <Style x:Key="ModernDataGridStyle"
               TargetType="DataGrid">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Foreground"
                    Value="#0F172A"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="RowHeight"
                    Value="58"/>

            <Setter Property="FontSize"
                    Value="13.5"/>

            <Setter Property="GridLinesVisibility"
                    Value="None"/>

            <Setter Property="HeadersVisibility"
                    Value="Column"/>

            <Setter Property="CanUserAddRows"
                    Value="False"/>

            <Setter Property="CanUserDeleteRows"
                    Value="False"/>

            <Setter Property="CanUserResizeRows"
                    Value="False"/>

            <Setter Property="AutoGenerateColumns"
                    Value="False"/>

            <Setter Property="SelectionMode"
                    Value="Single"/>

            <Setter Property="SelectionUnit"
                    Value="FullRow"/>

            <Setter Property="IsReadOnly"
                    Value="True"/>

            <Setter Property="HorizontalGridLinesBrush"
                    Value="#F1F5F9"/>

            <Setter Property="VerticalGridLinesBrush"
                    Value="Transparent"/>

        </Style>


        <!-- =====================================================
             DATAGRID HEADER
             ===================================================== -->

        <Style TargetType="DataGridColumnHeader">

            <Setter Property="Background"
                    Value="#F8FAFC"/>

            <Setter Property="Foreground"
                    Value="#475569"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Height"
                    Value="50"/>

            <Setter Property="Padding"
                    Value="10,0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>

            <Setter Property="BorderBrush"
                    Value="#E2E8F0"/>

        </Style>


        <!-- =====================================================
             DATAGRID ROW
             ===================================================== -->

        <Style TargetType="DataGridRow">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#F8FAFC"/>

                </Trigger>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="#FEF2F2"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- =====================================================
             DATAGRID CELL
             ===================================================== -->

        <Style TargetType="DataGridCell">

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="10,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

        </Style>


        <!-- =====================================================
             TABLE TEXT
             ===================================================== -->

        <Style x:Key="TableTextStyle"
               TargetType="TextBlock">

            <Setter Property="HorizontalAlignment"
                    Value="Center"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="TextAlignment"
                    Value="Center"/>

            <Setter Property="TextWrapping"
                    Value="NoWrap"/>

            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis"/>

        </Style>


        <!-- =====================================================
             NUMBER BADGE
             ===================================================== -->

        <Style x:Key="NumberBadgeStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="#F1F5F9"/>

            <Setter Property="CornerRadius"
                    Value="8"/>

            <Setter Property="MinWidth"
                    Value="34"/>

            <Setter Property="Height"
                    Value="30"/>

            <Setter Property="HorizontalAlignment"
                    Value="Center"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

        </Style>


        <!-- =====================================================
             ID BADGE
             ===================================================== -->

        <Style x:Key="IdBadgeStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="#EFF6FF"/>

            <Setter Property="CornerRadius"
                    Value="8"/>

            <Setter Property="MinWidth"
                    Value="52"/>

            <Setter Property="Height"
                    Value="30"/>

            <Setter Property="HorizontalAlignment"
                    Value="Center"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

        </Style>

    </Window.Resources>


    <!-- =========================================================
         MAIN
         ========================================================= -->

    <Grid Margin="26">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- =====================================================
             HEADER
             ===================================================== -->

        <Grid Grid.Row="0"
              Margin="4,0,4,22">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>


            <!-- Title -->

            <Grid Grid.Column="0">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>


                <Border Grid.Column="0"
                        Width="54"
                        Height="54"
                        Background="#FEF2F2"
                        CornerRadius="15"
                        Margin="0,0,14,0">

                    <TextBlock Text="↩"
                               FontSize="27"
                               FontWeight="Bold"
                               Foreground="#DC2626"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Border>


                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">

                    <TextBlock Text="المسترجعات"
                               FontSize="27"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               TextAlignment="Left"/>

                    <TextBlock Text="إدارة ومتابعة عمليات استرجاع المبيعات والفواتير."
                               FontSize="13"
                               Foreground="#64748B"
                               Margin="0,5,0,0"
                               TextAlignment="Left"/>

                </StackPanel>

            </Grid>


            <!-- Add -->

            <Button Grid.Column="1"
                    x:Name="AddReturnButton"
                    Content="＋  إضافة مسترجع"
                    Style="{StaticResource AddReturnButtonStyle}"
                    Click="AddReturnButton_Click"/>

        </Grid>


        <!-- =====================================================
             KPI CARDS
             ===================================================== -->

        <Grid Grid.Row="1"
              Margin="0,0,0,20">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="16"/>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="16"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>


            <!-- Total Returns -->

            <Border Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    Padding="20">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <Border Width="58"
                            Height="58"
                            Background="#FEF2F2"
                            CornerRadius="15"
                            VerticalAlignment="Center">

                        <TextBlock Text="↩"
                                   FontSize="27"
                                   FontWeight="Bold"
                                   Foreground="#DC2626"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>


                    <StackPanel Grid.Column="1"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="إجمالي المسترجعات"
                                   FontSize="13"
                                   Foreground="#64748B"/>

                        <TextBlock x:Name="TotalReturnsTextBlock"
                                   Text="0.00 ج"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#DC2626"
                                   Margin="0,4,0,0"/>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- Returns Count -->

            <Border Grid.Column="2"
                    Style="{StaticResource CardStyle}"
                    Padding="20">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <Border Width="58"
                            Height="58"
                            Background="#EFF6FF"
                            CornerRadius="15"
                            VerticalAlignment="Center">

                        <TextBlock Text="🧾"
                                   FontSize="24"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>


                    <StackPanel Grid.Column="1"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="عدد عمليات الاسترجاع"
                                   FontSize="13"
                                   Foreground="#64748B"/>

                        <TextBlock x:Name="ReturnsCountTextBlock"
                                   Text="0"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#2563EB"
                                   Margin="0,4,0,0"/>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- Net Sales -->

            <Border Grid.Column="4"
                    Style="{StaticResource CardStyle}"
                    Padding="20">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <Border Width="58"
                            Height="58"
                            Background="#ECFDF5"
                            CornerRadius="15"
                            VerticalAlignment="Center">

                        <TextBlock Text="↗"
                                   FontSize="27"
                                   FontWeight="Bold"
                                   Foreground="#16A34A"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>


                    <StackPanel Grid.Column="1"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="صافي إيرادات المبيعات"
                                   FontSize="13"
                                   Foreground="#64748B"/>

                        <TextBlock x:Name="NetSalesTextBlock"
                                   Text="0.00 ج"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#16A34A"
                                   Margin="0,4,0,0"/>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>


        <!-- =====================================================
             TABLE CARD
             ===================================================== -->

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="16"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                Padding="14"
                Effect="{StaticResource CardShadow}">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>


                <!-- =================================================
                     SEARCH BAR
                     ================================================= -->

                <Grid Grid.Row="0"
                      Height="44"
                      Margin="0,0,0,14">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="12"/>

                        <ColumnDefinition Width="105"/>

                    </Grid.ColumnDefinitions>


                    <!-- Search -->

                    <Grid Grid.Column="0">

                        <TextBox x:Name="SearchTextBox"
                                 Style="{StaticResource SearchTextBoxStyle}"
                                 TextChanged="SearchTextBox_TextChanged"/>

                        <TextBlock Text="🔍"
                                   FontSize="15"
                                   Foreground="#64748B"
                                   IsHitTestVisible="False"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Margin="0,0,14,0"/>

                        <TextBlock Text="ابحث برقم الفاتورة أو رقم المسترجع..."
                                   IsHitTestVisible="False"
                                   Foreground="#94A3B8"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left" Width="224" Margin="21,0,0,0"/>

                    </Grid>


                    <!-- Refresh -->

                    <Button Grid.Column="2"
                            Content="⟳  تحديث"
                            Style="{StaticResource RefreshButtonStyle}"
                            Click="RefreshButton_Click"/>

                </Grid>


                <!-- =================================================
                     DATA GRID
                     ================================================= -->

                <Border Grid.Row="1"
                        Background="White"
                        CornerRadius="10"
                        ClipToBounds="True">

                    <DataGrid x:Name="ReturnsDataGrid"
                              Style="{StaticResource ModernDataGridStyle}"
                              MouseDoubleClick="ReturnsDataGrid_MouseDoubleClick">

                        <DataGrid.Columns>


                            <!-- ===============================
                                 #
                                 =============================== -->

                            <DataGridTemplateColumn Header="#"
                                                    Width="70">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <Border Style="{StaticResource NumberBadgeStyle}">

                                            <TextBlock Text="{Binding DisplayNumber}"
                                                       FontWeight="Bold"
                                                       Foreground="#475569"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Center"/>

                                        </Border>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>


                            <!-- ===============================
                                 Return ID
                                 =============================== -->

                            <DataGridTemplateColumn Header="رقم المسترجع"
                                                    Width="135">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <Border Style="{StaticResource IdBadgeStyle}">

                                            <TextBlock Text="{Binding ReturnID}"
                                                       FontWeight="SemiBold"
                                                       Foreground="#2563EB"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Center"/>

                                        </Border>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>


                            <!-- ===============================
                                 Sale ID
                                 =============================== -->

                            <DataGridTemplateColumn Header="رقم الفاتورة"
                                                    Width="135">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <Border Background="#F8FAFC"
                                                BorderBrush="#E2E8F0"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                MinWidth="52"
                                                Height="30"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">

                                            <TextBlock Text="{Binding SaleID}"
                                                       FontWeight="SemiBold"
                                                       Foreground="#475569"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Center"/>

                                        </Border>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>


                            <!-- ===============================
                                 Date
                                 =============================== -->

                            <DataGridTemplateColumn Header="التاريخ"
                                                    Width="190">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <TextBlock Text="{Binding ReturnDate, StringFormat={}{0:dd/MM/yyyy hh:mm tt}}"
                                                   Style="{StaticResource TableTextStyle}"
                                                   Foreground="#475569"/>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>


                            <!-- ===============================
                                 Return Amount
                                 =============================== -->

                            <DataGridTemplateColumn Header="قيمة الاسترجاع"
                                                    Width="175">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <Border Background="#FEF2F2"
                                                CornerRadius="8"
                                                Padding="12,0"
                                                Height="32"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">

                                            <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:N2} ج}"
                                                       FontWeight="Bold"
                                                       Foreground="#DC2626"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Center"/>

                                        </Border>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>


                            <!-- ===============================
                                 Notes
                                 =============================== -->

                            <DataGridTemplateColumn Header="الملاحظات"
                                                    Width="*">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <TextBlock Text="{Binding Notes}"
                                                   Style="{StaticResource TableTextStyle}"
                                                   Foreground="#64748B"
                                                   MaxWidth="380"/>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>


                        </DataGrid.Columns>

                    </DataGrid>

                </Border>

            </Grid>

        </Border>

    </Grid>

</Window>