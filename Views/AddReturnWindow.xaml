<Window x:Class="WpfApp1.Views.AddReturnWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إضافة مسترجع"
        Height="760"
        Width="1180"
        MinHeight="680"
        MinWidth="950"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="#F1F5F9"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- ========================================================= -->
        <!-- الألوان -->
        <!-- ========================================================= -->

        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A"/>
        <SolidColorBrush x:Key="SuccessDarkBrush" Color="#15803D"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>
        <SolidColorBrush x:Key="TextBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E2E8F0"/>


        <!-- ========================================================= -->
        <!-- زر أزرق -->
        <!-- ========================================================= -->

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#2563EB"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Padding"
                    Value="16,0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1D4ED8"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1E40AF"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.55"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ========================================================= -->
        <!-- زر الحفظ -->
        <!-- ========================================================= -->

        <Style x:Key="SaveButtonStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#16A34A"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Padding"
                    Value="16,0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="SaveBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="SaveBorder"
                                        Property="Background"
                                        Value="#15803D"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="SaveBorder"
                                        Property="Background"
                                        Value="#166534"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="SaveBorder"
                                        Property="Opacity"
                                        Value="0.55"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ========================================================= -->
        <!-- TextBox -->
        <!-- ========================================================= -->

        <Style x:Key="ModernTextBoxStyle"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="44"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Foreground"
                    Value="#0F172A"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#CBD5E1"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="12,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border x:Name="TextBoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsFocused"
                                     Value="True">

                                <Setter TargetName="TextBoxBorder"
                                        Property="BorderBrush"
                                        Value="#2563EB"/>

                                <Setter TargetName="TextBoxBorder"
                                        Property="BorderThickness"
                                        Value="2"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="TextBoxBorder"
                                        Property="Opacity"
                                        Value="0.6"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ========================================================= -->
        <!-- DataGrid -->
        <!-- ========================================================= -->

        <Style x:Key="ModernDataGridStyle"
               TargetType="DataGrid">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Foreground"
                    Value="#334155"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="GridLinesVisibility"
                    Value="Horizontal"/>

            <Setter Property="HorizontalGridLinesBrush"
                    Value="#EEF2F7"/>

            <Setter Property="VerticalGridLinesBrush"
                    Value="#EEF2F7"/>

            <Setter Property="RowBackground"
                    Value="White"/>

            <Setter Property="AlternatingRowBackground"
                    Value="#F8FAFC"/>

            <Setter Property="SelectionMode"
                    Value="Single"/>

            <Setter Property="SelectionUnit"
                    Value="FullRow"/>

        </Style>


        <!-- ========================================================= -->
        <!-- DataGrid Header -->
        <!-- ========================================================= -->

        <Style TargetType="DataGridColumnHeader">

            <Setter Property="Background"
                    Value="#F8FAFC"/>

            <Setter Property="Foreground"
                    Value="#475569"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Height"
                    Value="48"/>

            <Setter Property="Padding"
                    Value="8,0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>

            <Setter Property="BorderBrush"
                    Value="#E2E8F0"/>

        </Style>


        <!-- ========================================================= -->
        <!-- DataGrid Cell -->
        <!-- ========================================================= -->

        <Style TargetType="DataGridCell">

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="8,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Style.Triggers>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="#EFF6FF"/>

                    <Setter Property="Foreground"
                            Value="#1E40AF"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ========================================================= -->
        <!-- DataGrid Row -->
        <!-- ========================================================= -->

        <Style TargetType="DataGridRow">

            <Setter Property="Height"
                    Value="52"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#F8FAFC"/>

                </Trigger>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="#EFF6FF"/>

                </Trigger>

            </Style.Triggers>

        </Style>

    </Window.Resources>


    <!-- ============================================================= -->
    <!-- الصفحة الرئيسية -->
    <!-- ============================================================= -->

    <Grid Margin="28">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>


        <!-- ========================================================= -->
        <!-- HEADER -->
        <!-- ========================================================= -->

        <Grid Grid.Row="0"
              Margin="0,0,0,22">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>


            <!-- العنوان -->

            <StackPanel Grid.Column="0">

                <StackPanel Orientation="Horizontal">

                    <Border Width="48"
                            Height="48"
                            Background="#DBEAFE"
                            CornerRadius="12"
                            Margin="0,0,14,0">

                        <TextBlock Text="↩"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="#2563EB"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>


                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="إضافة مسترجع"
                                   FontSize="27"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>

                        <TextBlock Text="إنشاء عملية استرجاع مرتبطة بفاتورة مبيعات"
                                   FontSize="13"
                                   Foreground="#64748B"
                                   Margin="0,4,0,0"/>

                    </StackPanel>

                </StackPanel>

            </StackPanel>


            <!-- Badge -->

            <Border Grid.Column="1"
                    Background="#FEF2F2"
                    BorderBrush="#FECACA"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="16,8"
                    VerticalAlignment="Center">

                <StackPanel Orientation="Horizontal">

                    <Ellipse Width="8"
                             Height="8"
                             Fill="#DC2626"
                             Margin="0,0,7,0"/>

                    <TextBlock Text="عملية استرجاع"
                               Foreground="#B91C1C"
                               FontSize="13"
                               FontWeight="SemiBold"/>

                </StackPanel>

            </Border>

        </Grid>


        <!-- ========================================================= -->
        <!-- اختيار الفاتورة -->
        <!-- ========================================================= -->

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="14"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                Padding="20"
                Margin="0,0,0,18">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="180"/>

                    <ColumnDefinition Width="115"/>

                    <ColumnDefinition Width="115"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>


                <!-- الأيقونة -->

                <Border Grid.Column="0"
                        Width="42"
                        Height="42"
                        Background="#EFF6FF"
                        CornerRadius="10"
                        Margin="0,0,14,0">

                    <TextBlock Text="▣"
                               FontSize="18"
                               Foreground="#2563EB"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Border>


                <!-- العنوان -->

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">

                    <TextBlock Text="الفاتورة الأصلية"
                               FontSize="12"
                               Foreground="#64748B"/>

                    <TextBlock Text="رقم فاتورة المبيعات"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#334155"
                               Margin="0,2,0,0"/>

                </StackPanel>


                <!-- رقم الفاتورة -->

                <TextBox Grid.Column="2"
                         x:Name="SaleIDTextBox"
                         Width="105"
                         Height="42"
                         HorizontalAlignment="Left"
                         Style="{StaticResource ModernTextBoxStyle}"
                         HorizontalContentAlignment="Center"
                         ToolTip="أدخل رقم الفاتورة"/>


                <!-- زر تحميل -->

                <Button Grid.Column="3"
                        Width="100"
                        Height="42"
                        Margin="5,0,0,0"
                        HorizontalAlignment="Left"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="LoadSaleButton_Click">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="↻"
                                   FontSize="17"
                                   Margin="0,0,6,0"/>

                        <TextBlock Text="تحميل"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>


                <!-- معلومات الفاتورة -->

                <Border Grid.Column="4"
                        Background="#F8FAFC"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="9"
                        Margin="18,0,0,0"
                        Padding="14,0">

                    <TextBlock x:Name="SaleInfoTextBlock"
                               Text="أدخل رقم الفاتورة ثم اضغط تحميل لعرض المنتجات"
                               Foreground="#64748B"
                               FontSize="13"
                               VerticalAlignment="Center"/>

                </Border>

            </Grid>

        </Border>


        <!-- ========================================================= -->
        <!-- المنتجات -->
        <!-- ========================================================= -->

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="14"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                Padding="18">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>


                <!-- عنوان الجدول -->

                <Grid Grid.Row="0"
                      Margin="4,0,4,14">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>


                    <StackPanel Grid.Column="0">

                        <TextBlock Text="منتجات الفاتورة"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>

                        <TextBlock Text="حدد الكمية التي تريد إرجاعها لكل منتج"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   Margin="0,4,0,0"/>

                    </StackPanel>


                    <Border Grid.Column="1"
                            Background="#F1F5F9"
                            CornerRadius="8"
                            Padding="12,6">

                        <TextBlock Text="الكمية المتاحة للاسترجاع"
                                   FontSize="12"
                                   Foreground="#475569"/>

                    </Border>

                </Grid>


                <!-- ================================================= -->
                <!-- جدول المنتجات - أبعاد متزنة -->
                <!-- ================================================= -->

                <DataGrid Grid.Row="1"
                          x:Name="SaleItemsDataGrid"
                          Style="{StaticResource ModernDataGridStyle}"
                          AutoGenerateColumns="False"
                          IsReadOnly="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          CanUserResizeColumns="False"
                          RowHeight="52"
                          FontSize="13"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True">

                    <DataGrid.Columns>


                        <!-- ================================================= -->
                        <!-- المنتج -->
                        <!-- ================================================= -->

                        <DataGridTextColumn Header="المنتج"
                                            Binding="{Binding ProductName}"
                                            Width="*"
                                            MinWidth="200"
                                            IsReadOnly="True">

                            <DataGridTextColumn.ElementStyle>

                                <Style TargetType="TextBlock">

                                    <Setter Property="VerticalAlignment"
                                            Value="Center"/>

                                    <Setter Property="HorizontalAlignment"
                                            Value="Right"/>

                                    <Setter Property="TextAlignment"
                                            Value="Right"/>

                                    <Setter Property="FontWeight"
                                            Value="SemiBold"/>

                                    <Setter Property="Foreground"
                                            Value="#0F172A"/>

                                    <Setter Property="Padding"
                                            Value="8,0"/>

                                </Style>

                            </DataGridTextColumn.ElementStyle>

                        </DataGridTextColumn>


                        <!-- ================================================= -->
                        <!-- المباع -->
                        <!-- ================================================= -->

                        <DataGridTextColumn Header="المباع"
                                            Binding="{Binding SoldQuantity}"
                                            Width="100"
                                            IsReadOnly="True">

                            <DataGridTextColumn.ElementStyle>

                                <Style TargetType="TextBlock">

                                    <Setter Property="VerticalAlignment"
                                            Value="Center"/>

                                    <Setter Property="HorizontalAlignment"
                                            Value="Center"/>

                                    <Setter Property="TextAlignment"
                                            Value="Center"/>

                                    <Setter Property="FontWeight"
                                            Value="SemiBold"/>

                                    <Setter Property="Foreground"
                                            Value="#334155"/>

                                </Style>

                            </DataGridTextColumn.ElementStyle>

                        </DataGridTextColumn>


                        <!-- ================================================= -->
                        <!-- مسترجع سابقًا -->
                        <!-- ================================================= -->

                        <DataGridTextColumn Header="مسترجع سابقًا"
                                            Binding="{Binding AlreadyReturned}"
                                            Width="135"
                                            IsReadOnly="True">

                            <DataGridTextColumn.ElementStyle>

                                <Style TargetType="TextBlock">

                                    <Setter Property="VerticalAlignment"
                                            Value="Center"/>

                                    <Setter Property="HorizontalAlignment"
                                            Value="Center"/>

                                    <Setter Property="TextAlignment"
                                            Value="Center"/>

                                    <Setter Property="Foreground"
                                            Value="#64748B"/>

                                </Style>

                            </DataGridTextColumn.ElementStyle>

                        </DataGridTextColumn>


                        <!-- ================================================= -->
                        <!-- متاح للاسترجاع -->
                        <!-- ================================================= -->

                        <DataGridTextColumn Header="متاح للاسترجاع"
                                            Binding="{Binding AvailableToReturn}"
                                            Width="145"
                                            IsReadOnly="True">

                            <DataGridTextColumn.ElementStyle>

                                <Style TargetType="TextBlock">

                                    <Setter Property="VerticalAlignment"
                                            Value="Center"/>

                                    <Setter Property="HorizontalAlignment"
                                            Value="Center"/>

                                    <Setter Property="TextAlignment"
                                            Value="Center"/>

                                    <Setter Property="FontWeight"
                                            Value="Bold"/>

                                    <Setter Property="Foreground"
                                            Value="#2563EB"/>

                                </Style>

                            </DataGridTextColumn.ElementStyle>

                        </DataGridTextColumn>


                        <!-- ================================================= -->
                        <!-- سعر البيع -->
                        <!-- ================================================= -->

                        <DataGridTextColumn Header="سعر البيع"
                                            Binding="{Binding UnitPrice, StringFormat={}{0:N2}}"
                                            Width="125"
                                            IsReadOnly="True">

                            <DataGridTextColumn.ElementStyle>

                                <Style TargetType="TextBlock">

                                    <Setter Property="VerticalAlignment"
                                            Value="Center"/>

                                    <Setter Property="HorizontalAlignment"
                                            Value="Center"/>

                                    <Setter Property="TextAlignment"
                                            Value="Center"/>

                                    <Setter Property="Foreground"
                                            Value="#334155"/>

                                </Style>

                            </DataGridTextColumn.ElementStyle>

                        </DataGridTextColumn>


                        <!-- ================================================= -->
                        <!-- كمية الاسترجاع -->
                        <!-- ================================================= -->

                        <DataGridTextColumn Header="كمية الاسترجاع"
                                            Binding="{Binding ReturnQuantity, UpdateSourceTrigger=PropertyChanged}"
                                            Width="145">

                            <DataGridTextColumn.ElementStyle>

                                <Style TargetType="TextBlock">

                                    <Setter Property="VerticalAlignment"
                                            Value="Center"/>

                                    <Setter Property="HorizontalAlignment"
                                            Value="Center"/>

                                    <Setter Property="TextAlignment"
                                            Value="Center"/>

                                    <Setter Property="FontWeight"
                                            Value="SemiBold"/>

                                    <Setter Property="Foreground"
                                            Value="#DC2626"/>

                                </Style>

                            </DataGridTextColumn.ElementStyle>

                        </DataGridTextColumn>


                        <!-- ================================================= -->
                        <!-- الإجمالي -->
                        <!-- ================================================= -->

                        <DataGridTextColumn Header="الإجمالي"
                                            Binding="{Binding ReturnTotal, StringFormat={}{0:N2} ج}"
                                            Width="135"
                                            IsReadOnly="True">

                            <DataGridTextColumn.ElementStyle>

                                <Style TargetType="TextBlock">

                                    <Setter Property="VerticalAlignment"
                                            Value="Center"/>

                                    <Setter Property="HorizontalAlignment"
                                            Value="Center"/>

                                    <Setter Property="TextAlignment"
                                            Value="Center"/>

                                    <Setter Property="FontWeight"
                                            Value="Bold"/>

                                    <Setter Property="Foreground"
                                            Value="#0F172A"/>

                                </Style>

                            </DataGridTextColumn.ElementStyle>

                        </DataGridTextColumn>


                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

        </Border>


        <!-- ========================================================= -->
        <!-- FOOTER -->
        <!-- ========================================================= -->

        <Border Grid.Row="3"
                Background="White"
                CornerRadius="14"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                Padding="16"
                Margin="0,18,0,0">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="180"/>

                    <ColumnDefinition Width="155"/>

                </Grid.ColumnDefinitions>


                <!-- الملاحظات -->

                <StackPanel Grid.Column="0"
                            Margin="0,0,20,0">

                    <TextBlock Text="ملاحظات"
                               FontSize="12"
                               Foreground="#64748B"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="NotesTextBox"
                             Height="46"
                             Style="{StaticResource ModernTextBoxStyle}"
                             ToolTip="اكتب أي ملاحظات تخص عملية الاسترجاع"/>

                </StackPanel>


                <!-- عنوان الإجمالي -->

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="0,0,20,0">

                    <TextBlock Text="إجمالي الاسترجاع"
                               FontSize="12"
                               Foreground="#64748B"
                               HorizontalAlignment="Right"/>

                    <TextBlock Text="القيمة المستردة"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#334155"
                               HorizontalAlignment="Right"
                               Margin="0,3,0,0"/>

                </StackPanel>


                <!-- قيمة الإجمالي -->

                <Border Grid.Column="2"
                        Background="#FEF2F2"
                        BorderBrush="#FECACA"
                        BorderThickness="1"
                        CornerRadius="10"
                        Height="52"
                        Padding="14,0">

                    <TextBlock x:Name="TotalReturnTextBlock"
                               Text="0.00 ج"
                               FontSize="21"
                               FontWeight="Bold"
                               Foreground="#DC2626"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Border>


                <!-- زر الحفظ -->

                <Button Grid.Column="3"
                        Height="52"
                        Margin="15,0,0,0"
                        Style="{StaticResource SaveButtonStyle}"
                        Click="SaveReturnButton_Click">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="✓"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Margin="0,0,8,0"/>

                        <TextBlock Text="حفظ الاسترجاع"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="Bold"/>

                    </StackPanel>

                </Button>

            </Grid>

        </Border>

    </Grid>

</Window>