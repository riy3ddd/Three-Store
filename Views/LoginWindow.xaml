<Window x:Class="WpfApp1.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Three Store - تسجيل الدخول"
        Height="580"
        Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Background="#F8FAFC">

    <Window.Resources>

        <!-- Style موحد لحقول الإدخال -->
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontFamily" Value="Calibri"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Background" Value="#FFFFFF"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="8">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush"
                                        Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PasswordBox Style -->
        <Style TargetType="{x:Type PasswordBox}">
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Background" Value="#FFFFFF"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type PasswordBox}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="8">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush"
                                        Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>


    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>


        <!-- ========================================= -->
        <!-- الجانب الأيمن - الهوية البصرية -->
        <!-- ========================================= -->

        <Border Grid.Column="0"
                Background="#0F172A">

            <Grid Margin="30">

                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center">

                    <TextBlock Text="Three Store"
                               Foreground="White"
                               FontSize="70"
                               FontFamily="Candara"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="إدارة المخزون والمبيعات"
                               Foreground="#94A3B8"
                               FontSize="22"
                               FontFamily="Calibri"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>

                    <Border Width="50"
                            Height="3"
                            Background="#3B82F6"
                            CornerRadius="2"
                            Margin="0,20,0,0"/>

                    <TextBlock Text="نظام متكامل لإدارة المتجر بكفاءة وسهولة"
                               Foreground="#64748B"
                               FontSize="18"
                               FontFamily="Calibri"
                               HorizontalAlignment="Center"
                               Margin="0,20,0,0"/>

                </StackPanel>


                <!-- السطرين في الأسفل -->
                <TextBlock VerticalAlignment="Top"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Height="92"
                           Margin="0,412,0,0">

                    <Run Text="إدارة : "
                         Foreground="#64748B"
                         FontSize="25"
                         FontFamily="Calibri"/>

                    <Run Text="م \ محمد عبدالهادي"
                         Foreground="#94A3B8"
                         FontSize="35"
                         FontWeight="SemiBold"
                         FontFamily="Traditional Arabic"/>

                </TextBlock>

            </Grid>

        </Border>


        <!-- ========================================= -->
        <!-- الجانب الأيسر - تسجيل الدخول -->
        <!-- ========================================= -->

        <Grid Grid.Column="1"
              Background="White">

            <StackPanel Width="340"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">


                <!-- الترحيب -->

                <TextBlock Text="مرحباً بك مجدداً"
                           FontSize="37"
                           FontFamily="Calibri"
                           FontWeight="Bold"
                           Foreground="#0F172A"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="قم بتسجيل الدخول للوصول إلى النظام"
                           FontSize="22"
                           FontFamily="Calibri"
                           Foreground="#64748B"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,28"
                           Height="61"/>


                <!-- اسم المستخدم -->

                <TextBlock Text="اسم المستخدم"
                           FontSize="18"
                           FontFamily="Calibri"
                           FontWeight="Bold"
                           Foreground="#334155"
                           Margin="0,0,0,6"/>

                <TextBox x:Name="UsernameTextBox"
                         Height="53"
                         KeyDown="UsernameTextBox_KeyDown"/>


                <!-- كلمة المرور -->

                <TextBlock Text="كلمة المرور"
                           FontSize="18"
                           FontFamily="Calibri"
                           FontWeight="Bold"
                           Foreground="#334155"
                           Margin="0,14,0,6"/>

                <PasswordBox x:Name="PasswordBox"
                             Height="49"
                             KeyDown="PasswordBox_KeyDown"/>


                <!-- رسالة الخطأ -->

                <TextBlock x:Name="ErrorTextBlock"
                           Text=""
                           Foreground="#EF4444"
                           FontSize="18"
                           FontFamily="Calibri"
                           FontWeight="Medium"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0"
                           HorizontalAlignment="Center"/>


                <!-- زر الدخول -->

                <Button x:Name="LoginButton"
                        Content="تسجيل الدخول"
                        Height="59"
                        Margin="0,20,0,0"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="25"
                        FontFamily="Calibri"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="LoginButton_Click">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="8">

                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>

                            </Border>

                            <ControlTemplate.Triggers>

                                <Trigger Property="IsMouseOver"
                                         Value="True">

                                    <Setter Property="Background"
                                            Value="#1D4ED8"/>

                                </Trigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>

                    </Button.Template>

                </Button>

            </StackPanel>

        </Grid>

    </Grid>

</Window>