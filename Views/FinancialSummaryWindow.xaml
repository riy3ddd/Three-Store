<Window x:Class="WpfApp1.Views.FinancialSummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="الملخص المالي"
        Height="500"
        Width="900"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="#F5F6FA">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <TextBlock Grid.Row="0"
                   Text="الملخص المالي"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#1E293B"
                   Margin="0,0,0,25"/>


        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>


            <!-- Sales -->

            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="14"
                    Margin="6"
                    Padding="20">

                <StackPanel HorizontalAlignment="Center">

                    <TextBlock Text="مبيعات المنتجات"
                               Foreground="#64748B"
                               FontSize="14"
                               HorizontalAlignment="Center"/>

                    <TextBlock x:Name="SalesText"
                               Text="0.00 ج.م"
                               FontSize="23"
                               FontWeight="Bold"
                               Foreground="#1E293B"
                               Margin="0,12,0,0"
                               HorizontalAlignment="Center"/>

                </StackPanel>

            </Border>


            <!-- Maintenance -->

            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="14"
                    Margin="6"
                    Padding="20">

                <StackPanel HorizontalAlignment="Center">

                    <TextBlock Text="إيرادات الصيانة"
                               Foreground="#64748B"
                               FontSize="14"
                               HorizontalAlignment="Center"/>

                    <TextBlock x:Name="MaintenanceText"
                               Text="0.00 ج.م"
                               FontSize="23"
                               FontWeight="Bold"
                               Foreground="#1E293B"
                               Margin="0,12,0,0"
                               HorizontalAlignment="Center"/>

                </StackPanel>

            </Border>


            <!-- Expenses -->

            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="14"
                    Margin="6"
                    Padding="20">

                <StackPanel HorizontalAlignment="Center">

                    <TextBlock Text="المصروفات"
                               Foreground="#64748B"
                               FontSize="14"
                               HorizontalAlignment="Center"/>

                    <TextBlock x:Name="ExpensesText"
                               Text="0.00 ج.م"
                               FontSize="23"
                               FontWeight="Bold"
                               Foreground="#DC2626"
                               Margin="0,12,0,0"
                               HorizontalAlignment="Center"/>

                </StackPanel>

            </Border>


            <!-- Net -->

            <Border Grid.Column="3"
                    Background="White"
                    CornerRadius="14"
                    Margin="6"
                    Padding="20">

                <StackPanel HorizontalAlignment="Center">

                    <TextBlock Text="صافي الإيراد"
                               Foreground="#64748B"
                               FontSize="14"
                               HorizontalAlignment="Center"/>

                    <TextBlock x:Name="NetText"
                               Text="0.00 ج.م"
                               FontSize="23"
                               FontWeight="Bold"
                               Foreground="#16A34A"
                               Margin="0,12,0,0"
                               HorizontalAlignment="Center"/>

                </StackPanel>

            </Border>

        </Grid>


        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,25,0,0">

            <Button Content="آخر 7 أيام"
                    Width="130"
                    Height="42"
                    Margin="5"
                    Click="Last7Days_Click"/>

            <Button Content="هذا الشهر"
                    Width="130"
                    Height="42"
                    Margin="5"
                    Click="ThisMonth_Click"/>

            <Button Content="اليوم"
                    Width="130"
                    Height="42"
                    Margin="5"
                    Click="Today_Click"/>

        </StackPanel>

    </Grid>

</Window>