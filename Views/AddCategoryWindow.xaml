<Window x:Class="WpfApp1.Views.AddCategoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إضافة تصنيف"
        Height="450"
        Width="500"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        FontFamily="29 LT BUKRA REGULAR"
        ResizeMode="NoResize"
        Background="#F4F6F9">

    <Window.Resources>
        <!-- ستايل عصري للأزرار -->
        <Style TargetType="Button" x:Key="ModernButtonStyle">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ستايل مخصص للـ TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="25,25,25,0" Height="365" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. العنوان -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock x:Name="WindowTitleTextBlock"
                       Text="🏷️ إضافة تصنيف جديد"
                       FontSize="25"
                       FontWeight="Bold"
                       Foreground="#1E293B"/>
            <TextBlock x:Name="InfoTextBlock"
                       Text="أدخل بيانات التصنيف بدقة لضمان تنظيم المخزون"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="#64748B"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 2. حقول الإدخال (مرتبة داخل Border شيك وظل خفيف) -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="20">
            <Border.Effect>
                <DropShadowEffect Color="#CBD5E1" BlurRadius="10" ShadowDepth="2" Direction="270"/>
            </Border.Effect>

            <StackPanel>
                <!-- اسم التصنيف -->
                <TextBlock Text="اسم التصنيف"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#334155"
                           Margin="0,0,0,8"/>

                <TextBox x:Name="CategoryNameTextBox"
                         Height="56"
                         FontSize="16"
                         Padding="10,6"
                         VerticalContentAlignment="Center"
                         Margin="0,0,0,15"/>

                <!-- عدد الأنواع / المنتجات -->
                <TextBlock Text="عدد الأنواع / المنتجات"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#334155"
                           Margin="0,0,0,8"/>

                <TextBox x:Name="ProductCountTextBox"
                         Height="50"
                         FontSize="16"
                         Padding="10,6"
                         VerticalContentAlignment="Center"
                         MaxLength="6"/>
            </StackPanel>
        </Border>

        <!-- 3. الأزرار (حفظ وإلغاء متناسقين) -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    Margin="0,20,0,0">

            <Button x:Name="SaveCategoryButton"
                    Content="حفظ"
                    Width="120"
                    Height="42"
                    Background="#2563EB"
                    Foreground="White"
                    Margin="0,0,10,0"
                    Style="{StaticResource ModernButtonStyle}"
                    Click="SaveCategoryButton_Click"/>

            <Button Content="إلغاء"
                    Width="110"
                    Height="42"
                    Background="#F1F5F9"
                    Foreground="#64748B"
                    Style="{StaticResource ModernButtonStyle}"
                    Click="CancelButton_Click"/>

        </StackPanel>

    </Grid>
</Window>