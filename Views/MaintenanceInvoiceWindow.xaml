<Window x:Class="WpfApp1.MaintenanceInvoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="فاتورة الصيانة"
        Width="920"
        Height="920"
        MinWidth="850"
        MinHeight="720"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="#F6F8FB">

    <Window.Resources>

        <!-- =========================
             LABEL
        ========================== -->

        <Style x:Key="FieldLabelStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#344054"/>

            <Setter Property="Margin"
                    Value="0,0,0,7"/>

        </Style>


        <!-- =========================
             TEXTBOX
        ========================== -->

        <Style x:Key="FieldTextStyle"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Padding"
                    Value="12,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Foreground"
                    Value="#172033"/>

            <Setter Property="BorderBrush"
                    Value="#D9E0EA"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="SnapsToDevicePixels"
                    Value="True"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border x:Name="TextBoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="0"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="TextBoxBorder"
                                        Property="BorderBrush"
                                        Value="#B8C7DD"/>

                            </Trigger>

                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">

                                <Setter TargetName="TextBoxBorder"
                                        Property="BorderBrush"
                                        Value="#2563EB"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="TextBoxBorder"
                                        Property="Opacity"
                                        Value="0.6"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- =========================
             READ ONLY TEXTBOX
        ========================== -->

        <Style x:Key="ReadOnlyFieldStyle"
               BasedOn="{StaticResource FieldTextStyle}"
               TargetType="TextBox">

            <Setter Property="Background"
                    Value="#F8FAFC"/>

            <Setter Property="Foreground"
                    Value="#475467"/>

        </Style>


        <!-- =========================
             COMBOBOX
        ========================== -->

        <Style x:Key="ModernComboBox"
               TargetType="ComboBox">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Padding"
                    Value="10,0"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Foreground"
                    Value="#172033"/>

            <Setter Property="BorderBrush"
                    Value="#D9E0EA"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

        </Style>


        <!-- =========================
             DATE PICKER
        ========================== -->

        <Style x:Key="ModernDatePicker"
               TargetType="DatePicker">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Foreground"
                    Value="#172033"/>

            <Setter Property="BorderBrush"
                    Value="#D9E0EA"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

        </Style>


        <!-- =========================
             CARD
        ========================== -->

        <Style x:Key="InvoiceCard"
               TargetType="Border">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="CornerRadius"
                    Value="12"/>

            <Setter Property="Padding"
                    Value="22"/>

            <Setter Property="BorderBrush"
                    Value="#E6EAF0"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

        </Style>


        <!-- =========================
             SECTION TITLE
        ========================== -->

        <Style x:Key="SectionTitleStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="17"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="Foreground"
                    Value="#172033"/>

        </Style>


        <!-- =========================
             SECTION DESCRIPTION
        ========================== -->

        <Style x:Key="SectionDescriptionStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="Foreground"
                    Value="#667085"/>

            <Setter Property="Margin"
                    Value="0,5,0,0"/>

        </Style>


        <!-- =========================
             BUTTON
        ========================== -->

        <Style x:Key="ActionButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="MinWidth"
                    Value="125"/>

            <Setter Property="Padding"
                    Value="18,0"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Margin"
                    Value="5,0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.88"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.72"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- =========================
             INVOICE BADGE
        ========================== -->

        <Style x:Key="InvoiceBadgeStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="#EEF4FF"/>

            <Setter Property="CornerRadius"
                    Value="8"/>

            <Setter Property="Padding"
                    Value="14,8"/>

        </Style>

    </Window.Resources>


    <!-- =========================================================
         MAIN LAYOUT
    ========================================================== -->

    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="92"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="68"/>

        </Grid.RowDefinitions>


        <!-- =====================================================
             HEADER
        ====================================================== -->

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E6EAF0"
                BorderThickness="0,0,0,1">

            <Grid Margin="28,0">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">

                    <TextBlock Text="🧾  فاتورة الصيانة"
                               FontSize="23"
                               FontWeight="Bold"
                               Foreground="#172033"/>

                    <TextBlock Text="عرض وتعديل بيانات فاتورة الصيانة"
                               FontSize="12"
                               Foreground="#667085"
                               Margin="0,5,0,0"/>

                </StackPanel>


                <Border Grid.Column="1"
                        Style="{StaticResource InvoiceBadgeStyle}"
                        VerticalAlignment="Center">

                    <StackPanel>

                        <TextBlock Text="رقم الفاتورة"
                                   FontSize="11"
                                   Foreground="#667085"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="HeaderInvoiceNumberText"
                                   Text="MNT-000000"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#2563EB"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>


        <!-- =====================================================
             CONTENT
        ====================================================== -->

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="28,22,28,25">


                <!-- =================================================
                     INVOICE INFORMATION
                ================================================== -->

                <Border Style="{StaticResource InvoiceCard}"
                        Margin="0,0,0,16">

                    <StackPanel>

                        <StackPanel Margin="0,0,0,20">

                            <TextBlock Text="معلومات الفاتورة"
                                       Style="{StaticResource SectionTitleStyle}"/>

                            <TextBlock Text="البيانات الأساسية الخاصة بالفاتورة"
                                       Style="{StaticResource SectionDescriptionStyle}"/>

                        </StackPanel>


                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="20"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <StackPanel Grid.Column="0">

                                <TextBlock Text="رقم الفاتورة"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox x:Name="InvoiceNumberTextBox"
                                         Style="{StaticResource ReadOnlyFieldStyle}"
                                         IsReadOnly="True"/>

                            </StackPanel>


                            <StackPanel Grid.Column="2">

                                <TextBlock Text="تاريخ الاستلام"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox x:Name="ReceiveDateTextBox"
                                         Style="{StaticResource ReadOnlyFieldStyle}"
                                         IsReadOnly="True"/>

                            </StackPanel>

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- =================================================
                     CUSTOMER + DEVICE
                ================================================== -->

                <Border Style="{StaticResource InvoiceCard}"
                        Margin="0,0,0,16">

                    <StackPanel>

                        <StackPanel Margin="0,0,0,20">

                            <TextBlock Text="بيانات العميل والجهاز"
                                       Style="{StaticResource SectionTitleStyle}"/>

                            <TextBlock Text="المعلومات الأساسية للجهاز وصاحب الصيانة"
                                       Style="{StaticResource SectionDescriptionStyle}"/>

                        </StackPanel>


                        <Grid>

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto"/>

                                <RowDefinition Height="Auto"/>

                                <RowDefinition Height="Auto"/>

                            </Grid.RowDefinitions>


                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="20"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <StackPanel Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0,0,0,16">

                                <TextBlock Text="اسم العميل"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox x:Name="CustomerNameTextBox"
                                         Style="{StaticResource FieldTextStyle}"/>

                            </StackPanel>


                            <StackPanel Grid.Row="0"
                                        Grid.Column="2"
                                        Margin="0,0,0,16">

                                <TextBlock Text="رقم التليفون"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox x:Name="CustomerPhoneTextBox"
                                         Style="{StaticResource FieldTextStyle}"/>

                            </StackPanel>


                            <StackPanel Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="0,0,0,16">

                                <TextBlock Text="اسم الجهاز"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox x:Name="DeviceNameTextBox"
                                         Style="{StaticResource FieldTextStyle}"/>

                            </StackPanel>


                            <StackPanel Grid.Row="1"
                                        Grid.Column="2"
                                        Margin="0,0,0,16">

                                <TextBlock Text="الرقم التسلسلي"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox x:Name="SerialNumberTextBox"
                                         Style="{StaticResource FieldTextStyle}"/>

                            </StackPanel>


                            <StackPanel Grid.Row="2"
                                        Grid.Column="0">

                                <TextBlock Text="لون الجهاز"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox x:Name="DeviceColorTextBox"
                                         Style="{StaticResource FieldTextStyle}"/>

                            </StackPanel>


                            <StackPanel Grid.Row="2"
                                        Grid.Column="2">

                                <TextBlock Text="حالة الجهاز عند الاستلام"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox x:Name="DeviceConditionTextBox"
                                         Style="{StaticResource FieldTextStyle}"/>

                            </StackPanel>

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- =================================================
                     MAINTENANCE STATUS
                ================================================== -->

                <Border Style="{StaticResource InvoiceCard}"
                        Margin="0,0,0,16">

                    <StackPanel>

                        <StackPanel Margin="0,0,0,20">

                            <TextBlock Text="بيانات الصيانة"
                                       Style="{StaticResource SectionTitleStyle}"/>

                            <TextBlock Text="حدد نوع الصيانة والحالة الحالية للفاتورة"
                                       Style="{StaticResource SectionDescriptionStyle}"/>

                        </StackPanel>


                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="20"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <StackPanel Grid.Column="0">

                                <TextBlock Text="نوع الصيانة"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <ComboBox x:Name="MaintenanceTypeComboBox"
                                          Style="{StaticResource ModernComboBox}">

                                    <ComboBoxItem Content="برمجة"/>

                                    <ComboBoxItem Content="هاردوير"/>

                                    <ComboBoxItem Content="شامل"/>

                                </ComboBox>

                            </StackPanel>


                            <StackPanel Grid.Column="2">

                                <TextBlock Text="حالة الصيانة"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <ComboBox x:Name="StatusComboBox"
                                          Style="{StaticResource ModernComboBox}">

                                    <ComboBoxItem Content="مستلم"/>

                                    <ComboBoxItem Content="قيد الفحص"/>

                                    <ComboBoxItem Content="قيد الصيانة"/>

                                    <ComboBoxItem Content="جاهز للتسليم"/>

                                    <ComboBoxItem Content="تم التسليم"/>

                                </ComboBox>

                            </StackPanel>

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- =================================================
                     PROBLEM + ACCESSORIES
                ================================================== -->

                <Border Style="{StaticResource InvoiceCard}"
                        Margin="0,0,0,16">

                    <StackPanel>

                        <StackPanel Margin="0,0,0,20">

                            <TextBlock Text="تفاصيل الجهاز"
                                       Style="{StaticResource SectionTitleStyle}"/>

                            <TextBlock Text="الأعطال والملحقات التي تم استلامها مع الجهاز"
                                       Style="{StaticResource SectionDescriptionStyle}"/>

                        </StackPanel>


                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="20"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <StackPanel Grid.Column="0">

                                <TextBlock Text="الأعطال / المشكلة"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox x:Name="ProblemDescriptionTextBox"
                                         Height="100"
                                         Padding="12"
                                         FontSize="14"
                                         Background="White"
                                         Foreground="#172033"
                                         BorderBrush="#D9E0EA"
                                         BorderThickness="1"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"/>

                            </StackPanel>


                            <StackPanel Grid.Column="2">

                                <TextBlock Text="ملحقات الجهاز"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox x:Name="AccessoriesTextBox"
                                         Height="100"
                                         Padding="12"
                                         FontSize="14"
                                         Background="White"
                                         Foreground="#172033"
                                         BorderBrush="#D9E0EA"
                                         BorderThickness="1"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"/>

                            </StackPanel>

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- =================================================
                     NOTES
                ================================================== -->

                <Border Style="{StaticResource InvoiceCard}"
                        Margin="0,0,0,16">

                    <StackPanel>

                        <TextBlock Text="الملاحظات"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <TextBlock Text="أي ملاحظات إضافية خاصة بالفاتورة أو الجهاز"
                                   Style="{StaticResource SectionDescriptionStyle}"
                                   Margin="0,5,0,18"/>


                        <TextBox x:Name="NotesTextBox"
                                 Height="90"
                                 Padding="12"
                                 FontSize="14"
                                 Background="White"
                                 Foreground="#172033"
                                 BorderBrush="#D9E0EA"
                                 BorderThickness="1"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"/>

                    </StackPanel>

                </Border>


                <!-- =================================================
                     SPARE PART
                ================================================== -->

                <Border Background="#F8FAFC"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,0,0,16">

                    <StackPanel>


                        <!-- SPARE PART CHECKBOX -->

                        <CheckBox x:Name="AddSparePartCheckBox"
                                  Content=" قطع الغيار (اختياري)"
                                  IsChecked="False"
                                  FontSize="14"
                                  FontWeight="SemiBold"
                                  Foreground="#172033"
                                  Checked="AddSparePartCheckBox_Checked"
                                  Unchecked="AddSparePartCheckBox_Unchecked">

                            <CheckBox.Template>

                                <ControlTemplate TargetType="CheckBox">

                                    <StackPanel Orientation="Horizontal">

                                        <Border Width="18"
                                                Height="18"
                                                CornerRadius="9"
                                                BorderBrush="#64748B"
                                                BorderThickness="1.5"
                                                Background="White"
                                                VerticalAlignment="Center">

                                            <Ellipse x:Name="CheckDot"
                                                     Width="8"
                                                     Height="8"
                                                     Fill="Black"
                                                     Visibility="Collapsed"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>

                                        </Border>


                                        <ContentPresenter
                                            Content="{TemplateBinding Content}"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"/>

                                    </StackPanel>


                                    <ControlTemplate.Triggers>

                                        <Trigger Property="IsChecked"
                                                 Value="True">

                                            <Setter TargetName="CheckDot"
                                                    Property="Visibility"
                                                    Value="Visible"/>

                                        </Trigger>

                                    </ControlTemplate.Triggers>

                                </ControlTemplate>

                            </CheckBox.Template>

                        </CheckBox>


                        <!-- SPARE PART DATA -->

                        <StackPanel x:Name="SparePartPanel"
                                    Visibility="Collapsed"
                                    Margin="0,14,0,0">

                            <TextBlock Text="اسم قطعة الغيار"
                                       Style="{StaticResource FieldLabelStyle}"/>

                            <TextBox x:Name="SparePartsNameTextBox"
                                     Style="{StaticResource FieldTextStyle}"
                                     TextChanged="SparePartsNameTextBox_TextChanged"/>


                            <TextBlock Text="سعر قطعة الغيار"
                                       Style="{StaticResource FieldLabelStyle}"
                                       Margin="0,14,0,7"/>

                            <TextBox x:Name="SparePartsCostTextBox"
                                     Style="{StaticResource FieldTextStyle}"
                                     Text="0"
                                     TextChanged="SparePartsCostTextBox_TextChanged"/>

                        </StackPanel>

                    </StackPanel>

                </Border>


                <!-- =================================================
                     FINAL DATA + COST
                ================================================== -->

                <Border Style="{StaticResource InvoiceCard}"
                        Margin="0,0,0,5">

                    <StackPanel>

                        <StackPanel Margin="0,0,0,20">

                            <TextBlock Text="بيانات التسليم والتكلفة"
                                       Style="{StaticResource SectionTitleStyle}"/>

                            <TextBlock Text="السعر وموعد التسليم وبيانات المستخدم المسؤول"
                                       Style="{StaticResource SectionDescriptionStyle}"/>

                        </StackPanel>


                        <!-- COST SUMMARY -->

                        <Border Background="#EFF6FF"
                                BorderBrush="#BFDBFE"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14"
                                Margin="0,0,0,18">

                            <Grid>

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="Auto"/>

                                    <RowDefinition Height="Auto"/>

                                    <RowDefinition Height="Auto"/>

                                </Grid.RowDefinitions>


                                <!-- MAINTENANCE COST -->

                                <TextBlock Grid.Row="0"
                                           Text="التكلفة التقديرية"
                                           Foreground="#64748B"
                                           FontSize="12"/>

                                <!--
                                    أصبحت التكلفة التقديرية قابلة للتعديل
                                    بدل TextBlock ثابت
                                -->

                                <TextBox x:Name="MaintenanceCostTextBox"
                                         Grid.Row="0"
                                         Width="150"
                                         Height="34"
                                         HorizontalAlignment="Right"
                                         Text="0"
                                         Style="{StaticResource FieldTextStyle}"
                                         TextChanged="MaintenanceCostTextBox_TextChanged"/>


                                <!-- SPARE PART COST -->

                                <TextBlock Grid.Row="1"
                                           Text="سعر قطعة الغيار"
                                           Foreground="#64748B"
                                           FontSize="12"
                                           Margin="0,6,0,0"/>

                                <TextBlock x:Name="SparePartsCostSummaryText"
                                           Grid.Row="1"
                                           Text="0.00 جنيه"
                                           HorizontalAlignment="Right"
                                           Foreground="#334155"
                                           FontWeight="SemiBold"
                                           FontSize="11"
                                           Margin="0,6,0,0">

                                    <TextBlock.RenderTransform>

                                        <TranslateTransform X="8"/>

                                    </TextBlock.RenderTransform>

                                </TextBlock>


                                <!-- TOTAL -->

                                <Border Grid.Row="2"
                                        Background="#FFFFFF"
                                        CornerRadius="8"
                                        Padding="10"
                                        Margin="0,10,0,0">

                                    <Grid>

                                        <TextBlock Text="الإجمالي النهائي"
                                                   Foreground="#2563EB"
                                                   FontSize="15"
                                                   FontWeight="Bold"/>

                                        <TextBlock x:Name="TotalMaintenanceCostText"
                                                   Text="0.00 جنيه"
                                                   HorizontalAlignment="Right"
                                                   Foreground="#172033"
                                                   FontSize="16"
                                                   FontWeight="Bold">

                                            <TextBlock.RenderTransform>

                                                <TranslateTransform X="8"/>

                                            </TextBlock.RenderTransform>

                                        </TextBlock>

                                    </Grid>

                                </Border>

                            </Grid>

                        </Border>


                        <!-- MAIN FINAL DATA -->

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="20"/>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="20"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <!-- PRICE -->

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="السعر النهائي"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox x:Name="PriceTextBox"
                                         Style="{StaticResource ReadOnlyFieldStyle}"
                                         IsReadOnly="True"/>

                            </StackPanel>


                            <!-- DELIVERY DATE -->

                            <StackPanel Grid.Column="2">

                                <TextBlock Text="موعد التسليم"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <DatePicker x:Name="DeliveryDatePicker"
                                            Style="{StaticResource ModernDatePicker}"/>

                            </StackPanel>


                            <!-- USERNAME -->

                            <StackPanel Grid.Column="4">

                                <TextBlock Text="المستخدم / الشيفت"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox x:Name="UsernameTextBox"
                                         Style="{StaticResource ReadOnlyFieldStyle}"
                                         IsReadOnly="True"/>

                            </StackPanel>

                        </Grid>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>


        <!-- =====================================================
             FOOTER
        ====================================================== -->

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E6EAF0"
                BorderThickness="0,1,0,0">

            <Grid Margin="20,0">

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">

                    <Button Content="💾  حفظ التعديلات"
                            Background="#2563EB"
                            Foreground="White"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="SaveButton_Click"/>


                    <Button Content="🖨  طباعة"
                            Background="#EEF2F6"
                            Foreground="#172033"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="PrintButton_Click"/>


                    <Button Content="✕  إغلاق"
                            Background="#F3F4F6"
                            Foreground="#475467"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="CloseButton_Click"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</Window>