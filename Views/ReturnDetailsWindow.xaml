<Window x:Class="WpfApp1.Views.ReturnDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تفاصيل المسترجع"
        Height="850"
        Width="1400"
        MinHeight="720"
        MinWidth="1100"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- =========================================================
             COLORS
             ========================================================= -->

        <SolidColorBrush x:Key="TextBrush"
                         Color="#0F172A"/>

        <SolidColorBrush x:Key="SecondaryTextBrush"
                         Color="#64748B"/>

        <SolidColorBrush x:Key="MutedTextBrush"
                         Color="#94A3B8"/>

        <SolidColorBrush x:Key="BorderBrush"
                         Color="#E2E8F0"/>

        <SolidColorBrush x:Key="RedBrush"
                         Color="#DC2626"/>

        <SolidColorBrush x:Key="GreenBrush"
                         Color="#16A34A"/>

        <SolidColorBrush x:Key="BlueBrush"
                         Color="#2563EB"/>


        <!-- =========================================================
             SHADOW
             ========================================================= -->

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="20"
                          ShadowDepth="2"
                          Direction="270"
                          Opacity="0.07"/>


        <!-- =========================================================
             CARD
             ========================================================= -->

        <Style x:Key="CardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="#FFFFFF"/>

            <Setter Property="BorderBrush"
                    Value="#E2E8F0"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="16"/>

            <Setter Property="Effect"
                    Value="{StaticResource CardShadow}"/>

        </Style>


        <!-- =========================================================
             INFO LABEL
             ========================================================= -->

        <Style x:Key="InfoLabelStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="Foreground"
                    Value="#64748B"/>

            <Setter Property="Margin"
                    Value="0,0,0,6"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

        </Style>


        <!-- =========================================================
             INFO VALUE
             ========================================================= -->

        <Style x:Key="InfoValueStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#0F172A"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis"/>

        </Style>


        <!-- =========================================================
             CLOSE BUTTON
             ========================================================= -->

        <Style x:Key="CloseButtonStyle"
               TargetType="Button">

            <Setter Property="Width"
                    Value="120"/>

            <Setter Property="Height"
                    Value="44"/>

            <Setter Property="Background"
                    Value="#F1F5F9"/>

            <Setter Property="Foreground"
                    Value="#334155"/>

            <Setter Property="BorderBrush"
                    Value="#E2E8F0"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="13.5"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#E2E8F0"/>

                    <Setter Property="BorderBrush"
                            Value="#CBD5E1"/>

                </Trigger>

                <Trigger Property="IsPressed"
                         Value="True">

                    <Setter Property="Background"
                            Value="#CBD5E1"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- =========================================================
             DATAGRID
             ========================================================= -->

        <Style x:Key="ModernDataGridStyle"
               TargetType="DataGrid">

            <Setter Property="Background"
                    Value="#FFFFFF"/>

            <Setter Property="Foreground"
                    Value="#0F172A"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="GridLinesVisibility"
                    Value="None"/>

            <Setter Property="HeadersVisibility"
                    Value="Column"/>

            <Setter Property="RowHeight"
                    Value="54"/>

            <Setter Property="FontSize"
                    Value="13.5"/>

            <Setter Property="CanUserAddRows"
                    Value="False"/>

            <Setter Property="CanUserDeleteRows"
                    Value="False"/>

            <Setter Property="CanUserResizeRows"
                    Value="False"/>

            <Setter Property="CanUserSortColumns"
                    Value="False"/>

            <Setter Property="AutoGenerateColumns"
                    Value="False"/>

            <Setter Property="SelectionMode"
                    Value="Single"/>

            <Setter Property="SelectionUnit"
                    Value="FullRow"/>

            <Setter Property="IsReadOnly"
                    Value="True"/>

            <Setter Property="HorizontalGridLinesBrush"
                    Value="Transparent"/>

            <Setter Property="VerticalGridLinesBrush"
                    Value="Transparent"/>

        </Style>


        <!-- =========================================================
             DATAGRID HEADER
             ========================================================= -->

        <Style TargetType="DataGridColumnHeader">

            <Setter Property="Background"
                    Value="#F8FAFC"/>

            <Setter Property="Foreground"
                    Value="#475569"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Height"
                    Value="48"/>

            <Setter Property="Padding"
                    Value="8,0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>

            <Setter Property="BorderBrush"
                    Value="#E2E8F0"/>

        </Style>


        <!-- =========================================================
             DATAGRID CELL
             ========================================================= -->

        <Style TargetType="DataGridCell">

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="8,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

        </Style>


        <!-- =========================================================
             DATAGRID ROW
             ========================================================= -->

        <Style TargetType="DataGridRow">

            <Setter Property="Background"
                    Value="#FFFFFF"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#F8FAFC"/>

                </Trigger>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="#FFF7F7"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- =========================================================
             TABLE TEXT
             ========================================================= -->

        <Style x:Key="TableTextStyle"
               TargetType="TextBlock">

            <Setter Property="HorizontalAlignment"
                    Value="Center"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="TextAlignment"
                    Value="Center"/>

            <Setter Property="TextWrapping"
                    Value="NoWrap"/>

            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis"/>

        </Style>


        <!-- =========================================================
             NUMBER BADGE
             ========================================================= -->

        <Style x:Key="NumberBadgeStyle"
               TargetType="Border">

            <Setter Property="Width"
                    Value="34"/>

            <Setter Property="Height"
                    Value="30"/>

            <Setter Property="Background"
                    Value="#F1F5F9"/>

            <Setter Property="CornerRadius"
                    Value="8"/>

            <Setter Property="HorizontalAlignment"
                    Value="Center"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

        </Style>


        <!-- =========================================================
             RED ID BADGE
             ========================================================= -->

        <Style x:Key="RedIdBadgeStyle"
               TargetType="Border">

            <Setter Property="MinWidth"
                    Value="58"/>

            <Setter Property="Height"
                    Value="30"/>

            <Setter Property="Background"
                    Value="#FEF2F2"/>

            <Setter Property="BorderBrush"
                    Value="#FECACA"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="8"/>

            <Setter Property="Padding"
                    Value="10,0"/>

            <Setter Property="HorizontalAlignment"
                    Value="Center"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

        </Style>


        <!-- =========================================================
             BLUE ID BADGE
             ========================================================= -->

        <Style x:Key="BlueIdBadgeStyle"
               TargetType="Border">

            <Setter Property="MinWidth"
                    Value="58"/>

            <Setter Property="Height"
                    Value="30"/>

            <Setter Property="Background"
                    Value="#EFF6FF"/>

            <Setter Property="BorderBrush"
                    Value="#BFDBFE"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="8"/>

            <Setter Property="Padding"
                    Value="10,0"/>

            <Setter Property="HorizontalAlignment"
                    Value="Center"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

        </Style>


        <!-- =========================================================
             TOTAL BADGE
             ========================================================= -->

        <Style x:Key="TotalBadgeStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="#FEF2F2"/>

            <Setter Property="BorderBrush"
                    Value="#FECACA"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="9"/>

            <Setter Property="Padding"
                    Value="14,0"/>

            <Setter Property="Height"
                    Value="34"/>

            <Setter Property="HorizontalAlignment"
                    Value="Center"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

        </Style>

    </Window.Resources>


    <!-- =============================================================
         MAIN
         ============================================================= -->

    <Grid Margin="28">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>


        <!-- =========================================================
             HEADER
             ========================================================= -->

        <Grid Grid.Row="0"
              Margin="0,0,0,20">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>


            <!-- TITLE -->

            <StackPanel Grid.Column="0">

                <StackPanel Orientation="Horizontal">

                    <Border Width="52"
                            Height="52"
                            Background="#FEF2F2"
                            BorderBrush="#FECACA"
                            BorderThickness="1"
                            CornerRadius="15"
                            Margin="0,0,14,0">

                        <TextBlock Text="↩"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#DC2626"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>


                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="تفاصيل المسترجع"
                                   FontSize="27"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>

                        <TextBlock Text="عرض تفاصيل عملية الاسترجاع والمنتجات المرتجعة"
                                   FontSize="13"
                                   Foreground="#64748B"
                                   Margin="0,5,0,0"/>

                    </StackPanel>

                </StackPanel>

            </StackPanel>


            <!-- RETURN NUMBER -->

            <Border Grid.Column="1"
                    Background="#FFFFFF"
                    BorderBrush="#FECACA"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20,9"
                    VerticalAlignment="Center"
                    Effect="{StaticResource CardShadow}">

                <StackPanel>

                    <TextBlock Text="رقم المسترجع"
                               FontSize="11"
                               Foreground="#991B1B"
                               HorizontalAlignment="Center"/>

                    <TextBlock x:Name="HeaderReturnIdTextBlock"
                               Text="—"
                               FontSize="21"
                               FontWeight="Bold"
                               Foreground="#DC2626"
                               HorizontalAlignment="Center"
                               Margin="0,2,0,0"/>

                </StackPanel>

            </Border>

        </Grid>


        <!-- =========================================================
             BASIC INFORMATION
             ========================================================= -->

        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}"
                Padding="22"
                Margin="0,0,0,18">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <!-- TITLE -->

                <StackPanel Grid.Row="0"
                            Margin="0,0,0,18">

                    <TextBlock Text="معلومات الاسترجاع"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#0F172A"/>

                    <TextBlock Text="البيانات الأساسية الخاصة بعملية الاسترجاع"
                               FontSize="12"
                               Foreground="#94A3B8"
                               Margin="0,3,0,0"/>

                </StackPanel>


                <!-- INFORMATION -->

                <Grid Grid.Row="1">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <!-- RETURN ID -->

                    <Border Grid.Column="0"
                            Background="#FFF7F7"
                            BorderBrush="#FEE2E2"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14,11"
                            Margin="0,0,12,0">

                        <StackPanel>

                            <TextBlock Text="رقم المسترجع"
                                       Style="{StaticResource InfoLabelStyle}"/>

                            <TextBlock x:Name="ReturnIdTextBlock"
                                       Text="—"
                                       Style="{StaticResource InfoValueStyle}"
                                       Foreground="#DC2626"/>

                        </StackPanel>

                    </Border>


                    <!-- SALE ID -->

                    <Border Grid.Column="1"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14,11"
                            Margin="0,0,12,0">

                        <StackPanel>

                            <TextBlock Text="رقم الفاتورة الأصلية"
                                       Style="{StaticResource InfoLabelStyle}"/>

                            <TextBlock x:Name="SaleIdTextBlock"
                                       Text="—"
                                       Style="{StaticResource InfoValueStyle}"
                                       Foreground="#2563EB"/>

                        </StackPanel>

                    </Border>


                    <!-- RETURN DATE -->

                    <Border Grid.Column="2"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14,11"
                            Margin="0,0,12,0">

                        <StackPanel>

                            <TextBlock Text="تاريخ الاسترجاع"
                                       Style="{StaticResource InfoLabelStyle}"/>

                            <TextBlock x:Name="ReturnDateTextBlock"
                                       Text="—"
                                       Style="{StaticResource InfoValueStyle}"/>

                        </StackPanel>

                    </Border>


                    <!-- SALE DATE -->

                    <Border Grid.Column="3"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14,11">

                        <StackPanel>

                            <TextBlock Text="تاريخ الفاتورة"
                                       Style="{StaticResource InfoLabelStyle}"/>

                            <TextBlock x:Name="SaleDateTextBlock"
                                       Text="—"
                                       Style="{StaticResource InfoValueStyle}"/>

                        </StackPanel>

                    </Border>

                </Grid>

            </Grid>

        </Border>


        <!-- =========================================================
             CUSTOMER + PRODUCTS
             ========================================================= -->

        <Border Grid.Row="2"
                Style="{StaticResource CardStyle}"
                Padding="22"
                Margin="0,0,0,18">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>


                <!-- SECTION TITLE -->

                <StackPanel Grid.Row="0"
                            Margin="0,0,0,16">

                    <TextBlock Text="بيانات العميل والفاتورة"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#0F172A"/>

                    <TextBlock Text="تفاصيل العميل وقيمة الفاتورة وطريقة الدفع"
                               FontSize="12"
                               Foreground="#94A3B8"
                               Margin="0,3,0,0"/>

                </StackPanel>


                <!-- CUSTOMER INFO -->

                <Grid Grid.Row="1"
                      Margin="0,0,0,20">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="2*"/>

                        <ColumnDefinition Width="2*"/>

                        <ColumnDefinition Width="1.7*"/>

                        <ColumnDefinition Width="2*"/>

                        <ColumnDefinition Width="2*"/>

                    </Grid.ColumnDefinitions>


                    <!-- CUSTOMER -->

                    <Border Grid.Column="0"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14,10"
                            Margin="0,0,10,0">

                        <StackPanel>

                            <TextBlock Text="العميل"
                                       Style="{StaticResource InfoLabelStyle}"/>

                            <TextBlock x:Name="CustomerNameTextBlock"
                                       Text="غير محدد"
                                       Style="{StaticResource InfoValueStyle}"/>

                        </StackPanel>

                    </Border>


                    <!-- PHONE -->

                    <Border Grid.Column="1"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14,10"
                            Margin="0,0,10,0">

                        <StackPanel>

                            <TextBlock Text="رقم الهاتف"
                                       Style="{StaticResource InfoLabelStyle}"/>

                            <TextBlock x:Name="CustomerPhoneTextBlock"
                                       Text="غير محدد"
                                       Style="{StaticResource InfoValueStyle}"/>

                        </StackPanel>

                    </Border>


                    <!-- PAYMENT -->

                    <Border Grid.Column="2"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14,10"
                            Margin="0,0,10,0">

                        <StackPanel>

                            <TextBlock Text="طريقة الدفع"
                                       Style="{StaticResource InfoLabelStyle}"/>

                            <TextBlock x:Name="PaymentMethodTextBlock"
                                       Text="—"
                                       Style="{StaticResource InfoValueStyle}"/>

                        </StackPanel>

                    </Border>


                    <!-- SALE TOTAL -->

                    <Border Grid.Column="3"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14,10"
                            Margin="0,0,10,0">

                        <StackPanel>

                            <TextBlock Text="إجمالي الفاتورة الأصلية"
                                       Style="{StaticResource InfoLabelStyle}"/>

                            <TextBlock x:Name="SaleTotalTextBlock"
                                       Text="0.00 ج"
                                       Style="{StaticResource InfoValueStyle}"
                                       Foreground="#0F172A"/>

                        </StackPanel>

                    </Border>


                    <!-- RETURN TOTAL -->

                    <Border Grid.Column="4"
                            Background="#FFF7F7"
                            BorderBrush="#FECACA"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14,8">

                        <StackPanel>

                            <TextBlock Text="إجمالي الاسترجاع"
                                       Style="{StaticResource InfoLabelStyle}"
                                       Foreground="#991B1B"/>

                            <TextBlock x:Name="ReturnTotalTextBlock"
                                       Text="0.00 ج"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#DC2626"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Border>

                </Grid>


                <!-- =================================================
                     PRODUCTS
                     ================================================= -->

                <Grid Grid.Row="2">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>


                    <!-- PRODUCTS TITLE -->

                    <Grid Grid.Row="0"
                          Margin="0,0,0,10">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>


                        <StackPanel Grid.Column="0">

                            <TextBlock Text="المنتجات المرتجعة"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"/>

                            <TextBlock Text="المنتجات والكميات والقيم المرتجعة"
                                       FontSize="11.5"
                                       Foreground="#94A3B8"
                                       Margin="0,3,0,0"/>

                        </StackPanel>


                        <Border Grid.Column="1"
                                Background="#FEF2F2"
                                BorderBrush="#FECACA"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,5"
                                VerticalAlignment="Center">

                            <TextBlock Text="استرجاع"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#DC2626"/>

                        </Border>

                    </Grid>


                    <!-- TABLE -->

                    <Border Grid.Row="1"
                            Background="#FFFFFF"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="12"
                            ClipToBounds="True">

                        <DataGrid x:Name="ReturnItemsDataGrid"
                                  Style="{StaticResource ModernDataGridStyle}">

                            <DataGrid.Columns>


                                <!-- NUMBER -->

                                <DataGridTemplateColumn Header="#"
                                                        Width="70">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <Border Style="{StaticResource NumberBadgeStyle}">

                                                <TextBlock Text="{Binding DisplayNumber}"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="#64748B"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           TextAlignment="Center"/>

                                            </Border>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>


                                <!-- PRODUCT -->

                                <DataGridTemplateColumn Header="المنتج"
                                                        Width="*">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <TextBlock Text="{Binding ProductName}"
                                                       FontSize="13.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="#0F172A"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>


                                <!-- QUANTITY -->

                                <DataGridTemplateColumn Header="الكمية"
                                                        Width="140">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <Border Background="#F1F5F9"
                                                    CornerRadius="8"
                                                    Padding="14,0"
                                                    Height="32"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">

                                                <TextBlock Text="{Binding Quantity}"
                                                           FontWeight="SemiBold"
                                                           Foreground="#475569"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           TextAlignment="Center"/>

                                            </Border>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>


                                <!-- UNIT PRICE -->

                                <DataGridTemplateColumn Header="سعر الوحدة"
                                                        Width="180">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <TextBlock Text="{Binding UnitPrice, StringFormat={}{0:N2} ج}"
                                                       FontWeight="SemiBold"
                                                       Foreground="#475569"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Center"/>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>


                                <!-- TOTAL -->

                                <DataGridTemplateColumn Header="الإجمالي"
                                                        Width="200">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <Border Style="{StaticResource TotalBadgeStyle}">

                                                <TextBlock Text="{Binding Total, StringFormat={}{0:N2} ج}"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           Foreground="#DC2626"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           TextAlignment="Center"/>

                                            </Border>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>


                            </DataGrid.Columns>

                        </DataGrid>

                    </Border>

                </Grid>

            </Grid>

        </Border>


        <!-- =========================================================
             FOOTER
             ========================================================= -->

        <Grid Grid.Row="3">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>


            <!-- NOTES -->

            <Border Grid.Column="0"
                    Background="#FFFFFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16"
                    Margin="0,0,14,0">

                <StackPanel>

                    <StackPanel Orientation="Horizontal">

                        <Border Width="28"
                                Height="28"
                                Background="#F1F5F9"
                                CornerRadius="7"
                                Margin="0,0,8,0">

                            <TextBlock Text="i"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#64748B"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                        <TextBlock Text="الملاحظات"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#64748B"
                                   VerticalAlignment="Center"/>

                    </StackPanel>


                    <TextBlock x:Name="NotesTextBlock"
                               Text="لا توجد ملاحظات"
                               FontSize="13.5"
                               Foreground="#334155"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"/>

                </StackPanel>

            </Border>


            <!-- TOTAL + CLOSE -->

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">


                <!-- TOTAL -->

                <Border Background="#FFFFFF"
                        BorderBrush="#FECACA"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20,8"
                        Margin="0,0,12,0"
                        Effect="{StaticResource CardShadow}">

                    <StackPanel>

                        <TextBlock Text="إجمالي المسترجع"
                                   FontSize="11"
                                   Foreground="#991B1B"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="FooterTotalTextBlock"
                                   Text="0.00 ج"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="#DC2626"
                                   HorizontalAlignment="Center"
                                   Margin="0,1,0,0"/>

                    </StackPanel>

                </Border>


                <!-- CLOSE -->

                <Button Content="إغلاق"
                        Style="{StaticResource CloseButtonStyle}"
                        Click="CloseButton_Click"/>

            </StackPanel>

        </Grid>

    </Grid>

</Window>