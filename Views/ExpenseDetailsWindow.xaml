<Window x:Class="WpfApp1.Views.ExpenseDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تفاصيل المصروف"
        Height="700"
        Width="760"
        MinHeight="650"
        MinWidth="700"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="#F8FAFC"
        ResizeMode="NoResize">

    <Window.Resources>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="20"
                          ShadowDepth="4"
                          Opacity="0.10"
                          Direction="270"/>

        <Style x:Key="ActionButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="48"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Padding"
                    Value="20,0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <Grid Margin="34">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- HEADER -->

        <Grid Grid.Row="0"
              Margin="0,0,0,28">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <StackPanel Grid.Column="0">

                <TextBlock Text="تفاصيل المصروف"
                           FontSize="29"
                           FontWeight="Bold"
                           Foreground="#0F172A"/>

                <TextBlock x:Name="ExpenseNumberText"
                           Text="EXP-000000"
                           FontSize="14"
                           Foreground="#64748B"
                           Margin="0,7,0,0"/>

            </StackPanel>


            <Border Grid.Column="1"
                    Background="#ECFDF5"
                    CornerRadius="10"
                    Padding="14,8"
                    VerticalAlignment="Center">

                <StackPanel Orientation="Horizontal">

                    <Ellipse Width="8"
                             Height="8"
                             Fill="#16A34A"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center"/>

                    <TextBlock Text="مصروف مسجل"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#15803D"
                               VerticalAlignment="Center"/>

                </StackPanel>

            </Border>

        </Grid>


        <!-- DETAILS CARD -->

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="18"
                Padding="30"
                Effect="{StaticResource CardShadow}">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>


                <!-- CARD HEADER -->

                <Grid Grid.Row="0"
                      Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock Text="بيانات المصروف"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="#1E293B"/>

                        <TextBlock Text="معلومات وتفاصيل العملية المالية"
                                   FontSize="12"
                                   Foreground="#94A3B8"
                                   Margin="0,5,0,0"/>

                    </StackPanel>

                </Grid>


                <!-- DIVIDER -->

                <Border Grid.Row="1"
                        Height="1"
                        Background="#E2E8F0"
                        Margin="0,0,0,22"/>


                <!-- CATEGORY -->

                <Grid Grid.Row="2"
                      Margin="0,0,0,20">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <TextBlock Grid.Column="0"
                               Text="نوع المصروف"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#64748B"
                               VerticalAlignment="Center"/>


                    <Border Grid.Column="1"
                            Background="#F8FAFC"
                            CornerRadius="8"
                            Padding="13,9">

                        <TextBlock x:Name="CategoryText"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#1E293B"/>

                    </Border>

                </Grid>


                <!-- DESCRIPTION -->

                <Grid Grid.Row="3"
                      Margin="0,0,0,20">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <TextBlock Grid.Column="0"
                               Text="البيان"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#64748B"
                               VerticalAlignment="Top"/>


                    <Border Grid.Column="1"
                            Background="#F8FAFC"
                            CornerRadius="8"
                            Padding="13,10">

                        <TextBlock x:Name="DescriptionText"
                                   FontSize="14"
                                   Foreground="#334155"
                                   TextWrapping="Wrap"/>

                    </Border>

                </Grid>


                <!-- AMOUNT -->

                <Grid Grid.Row="4"
                      Margin="0,0,0,20">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <TextBlock Grid.Column="0"
                               Text="المبلغ"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#64748B"
                               VerticalAlignment="Center"/>


                    <Border Grid.Column="1"
                            Background="#F0FDF4"
                            BorderBrush="#DCFCE7"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="15,11">

                        <TextBlock x:Name="AmountText"
                                   FontSize="23"
                                   FontWeight="Bold"
                                   Foreground="#15803D"/>

                    </Border>

                </Grid>


                <!-- DATE -->

                <Grid Grid.Row="5"
                      Margin="0,0,0,20">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <TextBlock Grid.Column="0"
                               Text="التاريخ"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#64748B"
                               VerticalAlignment="Center"/>


                    <TextBlock Grid.Column="1"
                               x:Name="DateText"
                               FontSize="14"
                               Foreground="#1E293B"
                               VerticalAlignment="Center"/>

                </Grid>


                <!-- USER -->

                <Grid Grid.Row="6"
                      Margin="0,0,0,20">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <TextBlock Grid.Column="0"
                               Text="بواسطة"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#64748B"
                               VerticalAlignment="Center"/>


                    <TextBlock Grid.Column="1"
                               x:Name="CreatedByText"
                               FontSize="14"
                               Foreground="#1E293B"
                               VerticalAlignment="Center"/>

                </Grid>


                <!-- NOTES -->

                <Grid Grid.Row="7">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <TextBlock Grid.Column="0"
                               Text="ملاحظات"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#64748B"
                               VerticalAlignment="Top"/>


                    <Border Grid.Column="1"
                            Background="#F8FAFC"
                            CornerRadius="8"
                            Padding="13,10">

                        <TextBlock x:Name="NotesText"
                                   FontSize="14"
                                   Foreground="#475569"
                                   TextWrapping="Wrap"/>

                    </Border>

                </Grid>

            </Grid>

        </Border>


        <!-- BUTTONS -->

        <Grid Grid.Row="2"
              Margin="0,24,0,0">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>


            <!-- EDIT -->

            <Button Grid.Column="0"
                    Content="تعديل"
                    Background="#2563EB"
                    Foreground="White"
                    Style="{StaticResource ActionButton}"
                    Click="EditButton_Click"/>


            <!-- DELETE -->

            <Button Grid.Column="2"
                    Content="حذف"
                    Background="#DC2626"
                    Foreground="White"
                    Style="{StaticResource ActionButton}"
                    Click="DeleteButton_Click"/>


            <!-- CLOSE -->

            <Button Grid.Column="4"
                    Content="إغلاق"
                    Background="#E2E8F0"
                    Foreground="#334155"
                    Style="{StaticResource ActionButton}"
                    Click="CloseButton_Click"/>

        </Grid>

    </Grid>

</Window>