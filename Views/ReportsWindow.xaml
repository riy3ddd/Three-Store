<Window x:Class="WpfApp1.Views.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تقارير وتحليلات المبيعات"
        Width="1250"
        Height="800"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        FontFamily="29 LT BUKRA REGULAR"
        Background="#F5F6FA">

    <Window.Resources>

        <!-- ==============================
             Card Shadow
        =============================== -->
        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="15"
                          ShadowDepth="2"
                          Opacity="0.12"/>

        <!-- ==============================
             Modern Button Style
        =============================== -->
        <Style x:Key="ModernButtonStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#E2E8F0"/>

            <Setter Property="Foreground"
                    Value="#334155"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="15,9"/>

            <Setter Property="Margin"
                    Value="4,0"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <!-- =========================================================
         MAIN SCROLL
    ========================================================== -->

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly">

        <Grid Margin="25">

            <Grid.RowDefinitions>

                <!-- Header -->
                <RowDefinition Height="Auto"/>

                <!-- Statistics -->
                <RowDefinition Height="Auto"/>

                <!-- Chart -->
                <RowDefinition Height="520"/>

                <!-- Top Products -->
                <RowDefinition Height="Auto"/>

                <!-- Top Categories -->
                <RowDefinition Height="Auto"/>

                <!-- Best Hours -->
                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <!-- =====================================================
                 HEADER
            ====================================================== -->

            <Grid Grid.Row="0"
                  Margin="0,0,0,20">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <!-- Title -->

                <StackPanel Grid.Column="0">

                    <TextBlock Text="تقارير وتحليلات المبيعات"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#0F172A"/>

                    <TextBlock x:Name="CurrentPeriodText"
                               Text="الفترة الحالية"
                               Margin="0,7,0,0"
                               FontSize="14"
                               Foreground="#64748B"/>

                </StackPanel>


                <!-- Period -->

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBlock Text="الفترة:"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               Foreground="#475569"
                               FontSize="14"/>

                    <ComboBox x:Name="PeriodComboBox"
                              Width="170"
                              Height="30"
                              FontSize="13"
                              SelectionChanged="PeriodComboBox_SelectionChanged">

                        <ComboBoxItem Content="اليوم"/>

                        <ComboBoxItem Content="آخر 7 أيام"/>

                        <ComboBoxItem Content="آخر 30 يوم"/>

                        <ComboBoxItem Content="آخر شهرين"/>

                        <ComboBoxItem Content="آخر 3 أشهر"/>

                        <ComboBoxItem Content="آخر 6 أشهر"/>

                        <ComboBoxItem Content="آخر سنة"/>

                        <ComboBoxItem Content="آخر سنتين"/>

                    </ComboBox>

                </StackPanel>

            </Grid>


            <!-- =====================================================
                 STATISTICS
            ====================================================== -->

            <Grid Grid.Row="1"
                  Margin="0,0,0,20">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>


                <!-- Total Sales -->

                <Border Grid.Column="0"
                        Margin="5"
                        Background="White"
                        CornerRadius="12"
                        Padding="18"
                        Effect="{StaticResource CardShadow}">

                    <StackPanel>

                        <TextBlock Text="إجمالي المبيعات"
                                   FontSize="13"
                                   Foreground="#64748B"/>

                        <TextBlock x:Name="TotalSalesText"
                                   Text="0 جنيه"
                                   Margin="0,8,0,0"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>

                    </StackPanel>

                </Border>


                <!-- Invoices -->

                <Border Grid.Column="1"
                        Margin="5"
                        Background="White"
                        CornerRadius="12"
                        Padding="18"
                        Effect="{StaticResource CardShadow}">

                    <StackPanel>

                        <TextBlock Text="عدد الفواتير"
                                   FontSize="13"
                                   Foreground="#64748B"/>

                        <TextBlock x:Name="InvoicesCountText"
                                   Text="0"
                                   Margin="0,8,0,0"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>

                    </StackPanel>

                </Border>


                <!-- Products Sold -->

                <Border Grid.Column="2"
                        Margin="5"
                        Background="White"
                        CornerRadius="12"
                        Padding="18"
                        Effect="{StaticResource CardShadow}">

                    <StackPanel>

                        <TextBlock Text="الوحدات المباعة"
                                   FontSize="13"
                                   Foreground="#64748B"/>

                        <TextBlock x:Name="ProductsSoldText"
                                   Text="0"
                                   Margin="0,8,0,0"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>

                    </StackPanel>

                </Border>


                <!-- Average Invoice -->

                <Border Grid.Column="3"
                        Margin="5"
                        Background="White"
                        CornerRadius="12"
                        Padding="18"
                        Effect="{StaticResource CardShadow}">

                    <StackPanel>

                        <TextBlock Text="متوسط الفاتورة"
                                   FontSize="13"
                                   Foreground="#64748B"/>

                        <TextBlock x:Name="AverageInvoiceText"
                                   Text="0 جنيه"
                                   Margin="0,8,0,0"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>

                    </StackPanel>

                </Border>


                <!-- Trend -->

                <Border Grid.Column="4"
                        Margin="5"
                        Background="White"
                        CornerRadius="12"
                        Padding="18"
                        Effect="{StaticResource CardShadow}">

                    <StackPanel>

                        <TextBlock Text="اتجاه المبيعات"
                                   FontSize="13"
                                   Foreground="#64748B"/>

                        <TextBlock x:Name="TrendText"
                                   Text="مستقر"
                                   Margin="0,8,0,0"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>

                    </StackPanel>

                </Border>


                <!-- Trend Percentage -->

                <Border Grid.Column="5"
                        Margin="5"
                        Background="White"
                        CornerRadius="12"
                        Padding="18"
                        Effect="{StaticResource CardShadow}">

                    <StackPanel>

                        <TextBlock Text="نسبة التغير"
                                   FontSize="13"
                                   Foreground="#64748B"/>

                        <TextBlock x:Name="TrendPercentageText"
                                   Text="0%"
                                   Margin="0,8,0,0"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>

                    </StackPanel>

                </Border>

            </Grid>


            <!-- =====================================================
                 CHART
            ====================================================== -->

            <Border Grid.Row="2"
                    Background="White"
                    CornerRadius="15"
                    Padding="20"
                    Margin="0,0,0,20"
                    Effect="{StaticResource CardShadow}">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>


                    <!-- Chart Header -->

                    <Grid Grid.Row="0"
                          Margin="0,0,0,15">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>


                        <StackPanel Grid.Column="0">

                            <TextBlock Text="الرسم البياني للمبيعات"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"/>

                            <TextBlock x:Name="ChartTotalText"
                                       Text="إجمالي المبيعات: 0 جنيه"
                                       Margin="0,5,0,0"
                                       FontSize="13"
                                       Foreground="#64748B"/>

                        </StackPanel>


                        <!-- Chart Buttons -->

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <Button x:Name="BarChartButton"
                                    Content="📊 أعمدة"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Click="BarChartButton_Click"/>

                            <Button x:Name="SimpleLineButton"
                                    Content="📈 خطي"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Click="SimpleLineButton_Click"/>

                            <Button x:Name="DetailedLineButton"
                                    Content="📉 خطي مفصل"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Click="DetailedLineButton_Click"/>

                            <!-- NEW -->

                            <Button x:Name="ChartAnalysisButton"
                                    Content="📋 تحليل الرسم البياني"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Click="ChartAnalysisButton_Click"/>

                        </StackPanel>

                    </Grid>


                    <!-- Chart Area -->

                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">

                        <Canvas x:Name="SalesChartCanvas"
                                Height="400"
                                Width="1100"
                                Background="Transparent"
                                SizeChanged="SalesChartCanvas_SizeChanged"/>

                    </ScrollViewer>

                </Grid>

            </Border>


            <!-- =====================================================
                 TOP PRODUCTS
            ====================================================== -->

            <Border Grid.Row="3"
                    Background="White"
                    CornerRadius="15"
                    Padding="20"
                    Margin="0,0,0,20"
                    Effect="{StaticResource CardShadow}">

                <StackPanel>

                    <TextBlock Text="🏆 أكثر المنتجات مبيعًا"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               Margin="0,0,0,15"/>

                    <ItemsControl x:Name="TopProductsItemsControl">

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <Border Background="#F8FAFC"
                                        CornerRadius="10"
                                        Padding="15"
                                        Margin="0,4">

                                    <Grid>

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="60"/>

                                            <ColumnDefinition Width="*"/>

                                            <ColumnDefinition Width="150"/>

                                            <ColumnDefinition Width="150"/>

                                        </Grid.ColumnDefinitions>


                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Rank}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="#475569"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ProductName}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#0F172A"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding TotalQuantity, StringFormat=الكمية: {0}}"
                                                   FontSize="13"
                                                   Foreground="#64748B"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding TotalSales, StringFormat=المبيعات: {0:N2} جنيه}"
                                                   FontSize="13"
                                                   Foreground="#64748B"
                                                   VerticalAlignment="Center"/>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </StackPanel>

            </Border>


            <!-- =====================================================
                 TOP CATEGORIES
            ====================================================== -->

            <Border Grid.Row="4"
                    Background="White"
                    CornerRadius="15"
                    Padding="20"
                    Margin="0,0,0,20"
                    Effect="{StaticResource CardShadow}">

                <StackPanel>

                    <TextBlock Text="📦 أكثر التصنيفات مبيعًا"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               Margin="0,0,0,15"/>

                    <ItemsControl x:Name="TopCategoriesItemsControl">

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <Border Background="#F8FAFC"
                                        CornerRadius="10"
                                        Padding="15"
                                        Margin="0,4">

                                    <Grid>

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="60"/>

                                            <ColumnDefinition Width="*"/>

                                            <ColumnDefinition Width="150"/>

                                            <ColumnDefinition Width="150"/>

                                        </Grid.ColumnDefinitions>


                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Rank}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="#475569"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding CategoryName}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#0F172A"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding TotalQuantity, StringFormat=الكمية: {0}}"
                                                   FontSize="13"
                                                   Foreground="#64748B"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding TotalSales, StringFormat=المبيعات: {0:N2} جنيه}"
                                                   FontSize="13"
                                                   Foreground="#64748B"
                                                   VerticalAlignment="Center"/>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </StackPanel>

            </Border>


            <!-- =====================================================
                 BEST SELLING HOURS
            ====================================================== -->

            <Border Grid.Row="5"
                    Background="White"
                    CornerRadius="15"
                    Padding="20"
                    Margin="0,0,0,20"
                    Effect="{StaticResource CardShadow}">

                <StackPanel>

                    <TextBlock Text="⏰ أفضل أوقات البيع"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               Margin="0,0,0,15"/>

                    <ItemsControl x:Name="BestHoursItemsControl">

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <Border Background="#F8FAFC"
                                        CornerRadius="10"
                                        Padding="15"
                                        Margin="0,4">

                                    <Grid>

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="60"/>

                                            <ColumnDefinition Width="*"/>

                                            <ColumnDefinition Width="180"/>

                                            <ColumnDefinition Width="180"/>

                                        </Grid.ColumnDefinitions>


                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Rank}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="#475569"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding HourLabel}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#0F172A"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding InvoiceCount, StringFormat=الفواتير: {0}}"
                                                   FontSize="13"
                                                   Foreground="#64748B"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding TotalSales, StringFormat=المبيعات: {0:N2} جنيه}"
                                                   FontSize="13"
                                                   Foreground="#64748B"
                                                   VerticalAlignment="Center"/>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </StackPanel>

            </Border>

        </Grid>

    </ScrollViewer>

</Window>