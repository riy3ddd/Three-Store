<Window x:Class="WpfApp1.Views.CreditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="الآجل"
        Height="780"
        Width="1250"
        MinHeight="680"
        MinWidth="1050"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="#F5F7FB"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- =========================================================
             SEARCH
        ========================================================== -->

        <Style x:Key="SearchTextBoxStyle"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="46"/>

            <Setter Property="Padding"
                    Value="15,0"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Foreground"
                    Value="#1E293B"/>

            <Setter Property="Background"
                    Value="#F8FAFC"/>

            <Setter Property="BorderBrush"
                    Value="#E2E8F0"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>


        <!-- =========================================================
             EDIT BUTTON
        ========================================================== -->

        <Style x:Key="EditIconButtonStyle"
               TargetType="Button">

            <Setter Property="Width"
                    Value="40"/>

            <Setter Property="Height"
                    Value="40"/>

            <Setter Property="Background"
                    Value="#F8FAFC"/>

            <Setter Property="Foreground"
                    Value="#475569"/>

            <Setter Property="BorderBrush"
                    Value="#E2E8F0"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="18"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="ToolTip"
                    Value="تعديل بيانات العميل"/>

        </Style>


        <!-- =========================================================
             PAYMENT BUTTON
        ========================================================== -->

        <Style x:Key="PaymentIconButtonStyle"
               TargetType="Button">

            <Setter Property="Width"
                    Value="40"/>

            <Setter Property="Height"
                    Value="40"/>

            <Setter Property="Background"
                    Value="#ECFDF5"/>

            <Setter Property="Foreground"
                    Value="#15803D"/>

            <Setter Property="BorderBrush"
                    Value="#BBF7D0"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="18"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="ToolTip"
                    Value="تسديد الآجل"/>

        </Style>


        <!-- =========================================================
             DATA GRID HEADER
        ========================================================== -->

        <Style TargetType="DataGridColumnHeader">

            <Setter Property="Background"
                    Value="#F8FAFC"/>

            <Setter Property="Foreground"
                    Value="#475569"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="Height"
                    Value="54"/>

            <Setter Property="Padding"
                    Value="0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="HorizontalAlignment"
                    Value="Stretch"/>

            <Setter Property="BorderBrush"
                    Value="#E2E8F0"/>

            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>

        </Style>


        <!-- =========================================================
             DATA GRID ROW
        ========================================================== -->

        <Style TargetType="DataGridRow">

            <Setter Property="Height"
                    Value="60"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Foreground"
                    Value="#334155"/>

            <Setter Property="BorderBrush"
                    Value="#F1F5F9"/>

            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>

            <Setter Property="SnapsToDevicePixels"
                    Value="True"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#F8FBFF"/>

                </Trigger>


                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="#F5F8FF"/>

                    <Setter Property="Foreground"
                            Value="#334155"/>

                </Trigger>


                <MultiTrigger>

                    <MultiTrigger.Conditions>

                        <Condition Property="IsSelected"
                                   Value="True"/>

                        <Condition Property="IsMouseOver"
                                   Value="True"/>

                    </MultiTrigger.Conditions>

                    <Setter Property="Background"
                            Value="#F1F6FF"/>

                </MultiTrigger>

            </Style.Triggers>

        </Style>


        <!-- =========================================================
             DATA GRID CELL
        ========================================================== -->

        <Style TargetType="DataGridCell">

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Foreground"
                    Value="#334155"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="0"/>

            <Style.Triggers>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="Transparent"/>

                    <Setter Property="Foreground"
                            Value="#334155"/>

                </Trigger>

            </Style.Triggers>

        </Style>

    </Window.Resources>


    <!-- =============================================================
         MAIN GRID
    ============================================================== -->

    <Grid Margin="26">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- =========================================================
             HEADER
        ========================================================== -->

        <Grid Grid.Row="0"
              Margin="0,0,0,22">

            <StackPanel Orientation="Horizontal">

                <Border Width="50"
                        Height="50"
                        Background="#EEF4FF"
                        CornerRadius="15">

                    <TextBlock Text="💳"
                               FontSize="25"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Border>


                <StackPanel Margin="14,0,0,0"
                            VerticalAlignment="Center">

                    <TextBlock Text="إدارة الآجل"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#172033"/>

                    <TextBlock Text="متابعة أرصدة العملاء والتسديدات المستحقة"
                               FontSize="14"
                               Foreground="#64748B"
                               Margin="0,4,0,0"/>

                </StackPanel>

            </StackPanel>

        </Grid>


        <!-- =========================================================
             SUMMARY
        ========================================================== -->

        <Grid Grid.Row="1"
              Margin="0,0,0,20">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="18"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>


            <!-- TOTAL CREDIT -->

            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="16"
                    Padding="22">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <Border Width="52"
                            Height="52"
                            Background="#FEF2F2"
                            CornerRadius="14">

                        <TextBlock Text="💰"
                                   FontSize="24"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>


                    <StackPanel Grid.Column="1"
                                Margin="15,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="إجمالي الآجل المستحق"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#64748B"/>

                        <TextBlock x:Name="TotalCreditTextBlock"
                                   Text="0.00 ج.م"
                                   FontSize="27"
                                   FontWeight="Bold"
                                   Foreground="#DC2626"
                                   Margin="0,4,0,0"/>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- TOTAL PAYMENTS -->

            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="16"
                    Padding="22">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <Border Width="52"
                            Height="52"
                            Background="#ECFDF5"
                            CornerRadius="14">

                        <TextBlock Text="✓"
                                   FontSize="27"
                                   FontWeight="Bold"
                                   Foreground="#16A34A"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>


                    <StackPanel Grid.Column="1"
                                Margin="15,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="إجمالي التحصيلات"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#64748B"/>

                        <TextBlock x:Name="TotalPaymentsTextBlock"
                                   Text="0.00 ج.م"
                                   FontSize="27"
                                   FontWeight="Bold"
                                   Foreground="#16A34A"
                                   Margin="0,4,0,0"/>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>


        <!-- =========================================================
             SEARCH
        ========================================================== -->

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="14"
                Padding="14"
                Margin="0,0,0,20">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>


                <Border Width="46"
                        Height="46"
                        Background="#EEF4FF"
                        CornerRadius="12">

                    <TextBlock Text="🔍"
                               FontSize="20"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Border>


                <TextBox x:Name="SearchTextBox"
                         Grid.Column="1"
                         Margin="12,0,0,0"
                         Style="{StaticResource SearchTextBoxStyle}"
                         ToolTip="ابحث باسم العميل أو رقم الهاتف"
                         TextChanged="SearchTextBox_TextChanged"/>

            </Grid>

        </Border>


        <!-- =========================================================
             TABLE
        ========================================================== -->

        <Border Grid.Row="3"
                Background="White"
                CornerRadius="16"
                Padding="12">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>


                <!-- TABLE TITLE -->

                <StackPanel Grid.Row="0"
                            Margin="10,5,10,14">

                    <TextBlock Text="العملاء المدينون"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="#172033"/>

                    <TextBlock Text="العملاء الذين لديهم أرصدة آجلة مستحقة"
                               FontSize="13"
                               Foreground="#94A3B8"
                               Margin="0,3,0,0"/>

                </StackPanel>


                <!-- DATA GRID -->

                <DataGrid x:Name="CreditDataGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          Background="Transparent"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          RowHeaderWidth="0"
                          ColumnHeaderHeight="54"
                          HorizontalGridLinesBrush="#F1F5F9"
                          VerticalGridLinesBrush="Transparent"
                          MouseDoubleClick="CreditDataGrid_MouseDoubleClick">

                    <DataGrid.Columns>


                        <!-- CUSTOMER -->

                        <DataGridTemplateColumn Header="اسم العميل"
                                                Width="200">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <TextBlock Text="{Binding CustomerName}"
                                               FontSize="14"
                                               Foreground="#334155"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"/>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>


                        <!-- PHONE -->

                        <DataGridTemplateColumn Header="رقم الهاتف"
                                                Width="145">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <TextBlock Text="{Binding CustomerPhone}"
                                               FontSize="14"
                                               Foreground="#334155"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"/>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>


                        <!-- CREDIT -->

                        <DataGridTemplateColumn Header="إجمالي الآجل"
                                                Width="145">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <TextBlock Text="{Binding TotalCredit, StringFormat={}{0:N2} ج.م}"
                                               FontSize="14"
                                               Foreground="#334155"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"/>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>


                        <!-- PAID -->

                        <DataGridTemplateColumn Header="المدفوع"
                                                Width="135">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <TextBlock Text="{Binding TotalPaid, StringFormat={}{0:N2} ج.م}"
                                               FontSize="14"
                                               Foreground="#334155"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"/>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>


                        <!-- REMAINING -->

                        <DataGridTemplateColumn Header="المتبقي"
                                                Width="135">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <TextBlock Text="{Binding Remaining, StringFormat={}{0:N2} ج.م}"
                                               FontSize="14"
                                               Foreground="#DC2626"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"/>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>


                        <!-- LAST TRANSACTION -->

                        <DataGridTemplateColumn Header="آخر حركة"
                                                Width="165">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <TextBlock Text="{Binding LastTransactionDate, StringFormat=dd/MM/yyyy HH:mm}"
                                               FontSize="14"
                                               Foreground="#334155"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"/>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>


                        <!-- ACTIONS -->

                        <DataGridTemplateColumn Header="الإجراءات"
                                                Width="150">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">

                                        <Button Content="✎"
                                                Width="40"
                                                Height="40"
                                                Margin="3"
                                                Style="{StaticResource EditIconButtonStyle}"
                                                Click="EditCustomerButton_Click"/>

                                        <Button Content="✓"
                                                Width="40"
                                                Height="40"
                                                Margin="3"
                                                Style="{StaticResource PaymentIconButtonStyle}"
                                                Click="PayCreditButton_Click"/>

                                    </StackPanel>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

        </Border>

    </Grid>

</Window>