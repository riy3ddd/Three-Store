<Window x:Class="WpfApp1.Views.EditCreditAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تعديل بيانات العميل"
        Height="450"
        Width="500"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="#F5F7FA"
        FontFamily="Segoe UI"
        ResizeMode="NoResize">

    <Border Margin="25"
            Background="White"
            CornerRadius="18"
            Padding="25">

        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="20"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="15"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="30"/>

                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <StackPanel Grid.Row="0">

                <TextBlock Text="تعديل بيانات العميل"
                           FontSize="25"
                           FontWeight="Bold"
                           Foreground="#1F2937"/>

                <TextBlock Text="تعديل الاسم أو رقم الهاتف فقط"
                           FontSize="13"
                           Foreground="#64748B"
                           Margin="0,5,0,0"/>

            </StackPanel>


            <StackPanel Grid.Row="2">

                <TextBlock Text="اسم العميل"
                           FontWeight="SemiBold"
                           Foreground="#475569"
                           Margin="0,0,0,6"/>

                <TextBox x:Name="CustomerNameTextBox"
                         Height="40"
                         Padding="10"/>

            </StackPanel>


            <StackPanel Grid.Row="4">

                <TextBlock Text="رقم الهاتف"
                           FontWeight="SemiBold"
                           Foreground="#475569"
                           Margin="0,0,0,6"/>

                <TextBox x:Name="CustomerPhoneTextBox"
                         Height="40"
                         Padding="10"/>

            </StackPanel>


            <StackPanel Grid.Row="6"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <Button Content="إلغاء"
                        Width="100"
                        Height="42"
                        Margin="5"
                        Click="CancelButton_Click"/>

                <Button Content="حفظ التعديل"
                        Width="130"
                        Height="42"
                        Margin="5"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Click="SaveButton_Click"/>

            </StackPanel>

        </Grid>

    </Border>

</Window>