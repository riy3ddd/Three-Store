<Window x:Class="WpfApp1.Views.DevicesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إدارة الأجهزة"
        Height="800"
        Width="1250"
        MinHeight="650"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="#F5F7FA">

    <Window.Resources>

        <!-- ================= BUTTON BASE ================= -->
        <Style x:Key="BaseButtonStyle"
               TargetType="Button">
            <Setter Property="Height"
                    Value="34"/>
            <Setter Property="Padding"
                    Value="10,0"/>
            <Setter Property="Margin"
                    Value="2"/>
            <Setter Property="FontSize"
                    Value="12"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                        </Border>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- تعديل -->
        <Style x:Key="EditButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource BaseButtonStyle}">

            <Setter Property="Width"
                    Value="58"/>

            <Setter Property="Background"
                    Value="#EFF6FF"/>

            <Setter Property="Foreground"
                    Value="#2563EB"/>
        </Style>

        <!-- حجز -->
        <Style x:Key="ReserveButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource BaseButtonStyle}">

            <Setter Property="Width"
                    Value="58"/>

            <Setter Property="Background"
                    Value="#FFF7ED"/>

            <Setter Property="Foreground"
                    Value="#EA580C"/>
        </Style>

        <!-- بيع -->
        <Style x:Key="SellButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource BaseButtonStyle}">

            <Setter Property="Width"
                    Value="55"/>

            <Setter Property="Background"
                    Value="#ECFDF5"/>

            <Setter Property="Foreground"
                    Value="#16A34A"/>
        </Style>

        <!-- ================= FILTER CONTROLS ================= -->

        <Style TargetType="TextBox">
            <Setter Property="Background"
                    Value="#F9FAFB"/>
            <Setter Property="BorderBrush"
                    Value="#E5E7EB"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Foreground"
                    Value="#1F2937"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background"
                    Value="#F9FAFB"/>
            <Setter Property="BorderBrush"
                    Value="#E5E7EB"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Foreground"
                    Value="#1F2937"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        </Style>

        <!-- ================= DATAGRID ================= -->

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"
                    Value="#F8FAFC"/>
            <Setter Property="Foreground"
                    Value="#374151"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="FontSize"
                    Value="13"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="Height"
                    Value="42"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Padding"
                    Value="5,0"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background"
                    Value="White"/>
            <Setter Property="Foreground"
                    Value="#374151"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="#F8FAFC"/>
                </Trigger>

                <Trigger Property="IsSelected"
                         Value="True">
                    <Setter Property="Background"
                            Value="#F8FAFC"/>
                    <Setter Property="Foreground"
                            Value="#374151"/>
                </Trigger>

            </Style.Triggers>
        </Style>

    </Window.Resources>


    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <Grid Grid.Row="0"
              Margin="0,0,0,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <!-- العنوان -->

            <StackPanel Grid.Column="0"
                        VerticalAlignment="Center">

                <TextBlock Text="إدارة الأجهزة"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#1F2937"/>

                <TextBlock Text="إدارة ومتابعة الأجهزة الموجودة بالمخزون وعمليات البيع"
                           FontSize="14"
                           Foreground="#6B7280"
                           Margin="0,6,0,0"/>

            </StackPanel>


            <!-- الإيرادات + إضافة -->

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">


                <Border Background="White"
                        CornerRadius="10"
                        Padding="18,8"
                        Margin="0,0,12,0">

                    <StackPanel>

                        <TextBlock Text="إجمالي إيرادات الأجهزة"
                                   FontSize="12"
                                   Foreground="#6B7280"
                                   HorizontalAlignment="Right"/>

                        <TextBlock x:Name="TotalDeviceRevenueText"
                                   Text="0.00"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#16A34A"
                                   HorizontalAlignment="Right"/>

                    </StackPanel>

                </Border>


                <Button Content="+ إضافة جهاز"
                        Width="150"
                        Height="46"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="AddDeviceButton_Click">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="9">

                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                            </Border>

                        </ControlTemplate>

                    </Button.Template>

                </Button>

            </StackPanel>

        </Grid>


        <!-- ================================================= -->
        <!-- FILTERS -->
        <!-- ================================================= -->

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="18"
                Margin="0,0,0,18">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>


                <!-- البحث -->

                <StackPanel Grid.Column="0"
                            Margin="0,0,12,0">

                    <TextBlock Text="بحث"
                               FontWeight="SemiBold"
                               Foreground="#374151"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="SearchTextBox"
                             Height="38"
                             Padding="10"
                             FontSize="14"
                             TextChanged="SearchTextBox_TextChanged"/>

                </StackPanel>


                <!-- النوع -->

                <StackPanel Grid.Column="1"
                            Margin="0,0,12,0">

                    <TextBlock Text="نوع الجهاز"
                               FontWeight="SemiBold"
                               Foreground="#374151"
                               Margin="0,0,0,6"/>

                    <ComboBox x:Name="DeviceTypeComboBox"
                              Height="38"
                              FontSize="14"
                              SelectionChanged="Filter_SelectionChanged">

                        <ComboBoxItem Content="الكل"
                                      IsSelected="True"/>

                        <ComboBoxItem Content="جديد"/>

                        <ComboBoxItem Content="مستعمل"/>

                    </ComboBox>

                </StackPanel>


                <!-- الحالة -->

                <StackPanel Grid.Column="2"
                            Margin="0,0,12,0">

                    <TextBlock Text="الحالة"
                               FontWeight="SemiBold"
                               Foreground="#374151"
                               Margin="0,0,0,6"/>

                    <ComboBox x:Name="DeviceStatusComboBox"
                              Height="38"
                              FontSize="14"
                              SelectionChanged="Filter_SelectionChanged">

                        <ComboBoxItem Content="الكل"
                                      IsSelected="True"/>

                        <ComboBoxItem Content="متاح"/>

                        <ComboBoxItem Content="مباع"/>

                    </ComboBox>

                </StackPanel>


                <!-- التاريخ -->

                <StackPanel Grid.Column="3">

                    <TextBlock Text="التاريخ"
                               FontWeight="SemiBold"
                               Foreground="#374151"
                               Margin="0,0,0,6"/>

                    <ComboBox x:Name="DateFilterComboBox"
                              Height="38"
                              FontSize="14"
                              SelectionChanged="Filter_SelectionChanged">

                        <ComboBoxItem Content="الكل"
                                      IsSelected="True"/>

                        <ComboBoxItem Content="اليوم"/>

                        <ComboBoxItem Content="آخر 7 أيام"/>

                        <ComboBoxItem Content="آخر 30 يوم"/>

                        <ComboBoxItem Content="آخر 3 شهور"/>

                        <ComboBoxItem Content="آخر 6 شهور"/>

                        <ComboBoxItem Content="آخر سنة"/>

                    </ComboBox>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ================================================= -->
        <!-- DEVICES TABLE -->
        <!-- ================================================= -->

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="12"
                Padding="10">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <TextBlock Grid.Row="0"
                           Text="سجل الأجهزة"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#1F2937"
                           Margin="10,5,10,12"/>


                <DataGrid x:Name="DevicesDataGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F1F5F9"
                          RowHeight="55"
                          MouseDoubleClick="DevicesDataGrid_MouseDoubleClick">


                    <DataGrid.Columns>


                        <!-- الجهاز -->

                        <DataGridTextColumn Header="الجهاز"
                                            Binding="{Binding DeviceName}"
                                            Width="2*">

                            <DataGridTextColumn.ElementStyle>

                                <Style TargetType="TextBlock">

                                    <Setter Property="HorizontalAlignment"
                                            Value="Center"/>

                                    <Setter Property="VerticalAlignment"
                                            Value="Center"/>

                                    <Setter Property="TextAlignment"
                                            Value="Center"/>

                                </Style>

                            </DataGridTextColumn.ElementStyle>

                        </DataGridTextColumn>


                        <!-- Storage -->

                        <DataGridTextColumn Header="Storage"
                                            Binding="{Binding Storage}"
                                            Width="1.2*">

                            <DataGridTextColumn.ElementStyle>

                                <Style TargetType="TextBlock">

                                    <Setter Property="HorizontalAlignment"
                                            Value="Center"/>

                                    <Setter Property="VerticalAlignment"
                                            Value="Center"/>

                                    <Setter Property="TextAlignment"
                                            Value="Center"/>

                                </Style>

                            </DataGridTextColumn.ElementStyle>

                        </DataGridTextColumn>


                        <!-- RAM -->

                        <DataGridTextColumn Header="RAM"
                                            Binding="{Binding RAM}"
                                            Width="1.2*">

                            <DataGridTextColumn.ElementStyle>

                                <Style TargetType="TextBlock">

                                    <Setter Property="HorizontalAlignment"
                                            Value="Center"/>

                                    <Setter Property="VerticalAlignment"
                                            Value="Center"/>

                                    <Setter Property="TextAlignment"
                                            Value="Center"/>

                                </Style>

                            </DataGridTextColumn.ElementStyle>

                        </DataGridTextColumn>


                        <!-- النوع -->

                        <DataGridTextColumn Header="النوع"
                                            Binding="{Binding DeviceType}"
                                            Width="1*">

                            <DataGridTextColumn.ElementStyle>

                                <Style TargetType="TextBlock">

                                    <Setter Property="HorizontalAlignment"
                                            Value="Center"/>

                                    <Setter Property="VerticalAlignment"
                                            Value="Center"/>

                                    <Setter Property="TextAlignment"
                                            Value="Center"/>

                                </Style>

                            </DataGridTextColumn.ElementStyle>

                        </DataGridTextColumn>


                        <!-- ================================================= -->
                        <!-- الحالة -->
                        <!-- ================================================= -->

                        <DataGridTemplateColumn Header="الحالة"
                                                Width="1.1*">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <Border CornerRadius="6"
                                            Padding="5,2"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">

                                        <Border.Style>

                                            <Style TargetType="Border">

                                                <Setter Property="Background"
                                                        Value="#ECFDF5"/>

                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding DeviceStatus}"
                                                                 Value="مباع">

                                                        <Setter Property="Background"
                                                                Value="#FEF2F2"/>

                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>

                                        </Border.Style>


                                        <TextBlock Text="{Binding DeviceStatus}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center">

                                            <TextBlock.Style>

                                                <Style TargetType="TextBlock">

                                                    <Setter Property="Foreground"
                                                            Value="#16A34A"/>

                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding DeviceStatus}"
                                                                     Value="مباع">

                                                            <Setter Property="Foreground"
                                                                    Value="#DC2626"/>

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </TextBlock.Style>

                                        </TextBlock>

                                    </Border>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>


                        <!-- تاريخ الإضافة -->

                        <DataGridTextColumn Header="تاريخ الإضافة"
                                            Binding="{Binding AddedDate, StringFormat=dd/MM/yyyy}"
                                            Width="1.2*">

                            <DataGridTextColumn.ElementStyle>

                                <Style TargetType="TextBlock">

                                    <Setter Property="HorizontalAlignment"
                                            Value="Center"/>

                                    <Setter Property="VerticalAlignment"
                                            Value="Center"/>

                                    <Setter Property="TextAlignment"
                                            Value="Center"/>

                                </Style>

                            </DataGridTextColumn.ElementStyle>

                        </DataGridTextColumn>


                        <!-- ================================================= -->
                        <!-- الإجراءات -->
                        <!-- ================================================= -->
                        <DataGridTemplateColumn Header="الإجراءات"
                        Width="230">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                                        <!-- تعديل -->
                                        <Button Content="تعديل"
                        Width="58"
                        Height="34"
                        Margin="2"
                        Background="#EFF6FF"
                        Foreground="#2563EB"
                        BorderThickness="0"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="EditDeviceButton_Click">

                                            <Button.Style>

                                                <Style TargetType="Button">

                                                    <Setter Property="Visibility"
                                    Value="Collapsed"/>

                                                    <Setter Property="Template">

                                                        <Setter.Value>

                                                            <ControlTemplate TargetType="Button">

                                                                <Border Background="{TemplateBinding Background}"
                                                CornerRadius="7">

                                                                    <ContentPresenter
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>

                                                                </Border>

                                                            </ControlTemplate>

                                                        </Setter.Value>

                                                    </Setter>

                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding DeviceStatus}"
                                             Value="متاح">

                                                            <Setter Property="Visibility"
                                            Value="Visible"/>

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </Button.Style>

                                        </Button>


                                        <!-- حجز -->
                                        <Button Content="حذف"
                        Width="58"
                        Height="34"
                        Margin="2"
                        Background="#FFF7ED"
                        Foreground="#EA580C"
                        BorderThickness="0"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Cursor="Hand">

                                            <Button.Template>

                                                <ControlTemplate TargetType="Button">

                                                    <Border Background="{TemplateBinding Background}"
                                    CornerRadius="7">

                                                        <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                                                    </Border>

                                                </ControlTemplate>

                                            </Button.Template>

                                        </Button>


                                        <!-- بيع -->
                                        <Button Content="بيع"
                        Width="55"
                        Height="34"
                        Margin="2"
                        Background="#ECFDF5"
                        Foreground="#16A34A"
                        BorderThickness="0"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="SellDeviceButton_Click">

                                            <Button.Style>

                                                <Style TargetType="Button">

                                                    <Setter Property="Visibility"
                                    Value="Collapsed"/>

                                                    <Setter Property="Template">

                                                        <Setter.Value>

                                                            <ControlTemplate TargetType="Button">

                                                                <Border Background="{TemplateBinding Background}"
                                                CornerRadius="7">

                                                                    <ContentPresenter
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>

                                                                </Border>

                                                            </ControlTemplate>

                                                        </Setter.Value>

                                                    </Setter>

                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding DeviceStatus}"
                                             Value="متاح">

                                                            <Setter Property="Visibility"
                                            Value="Visible"/>

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </Button.Style>

                                        </Button>

                                    </StackPanel>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>


                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

        </Border>

    </Grid>

</Window>