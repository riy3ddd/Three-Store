<Window x:Class="WpfApp1.Views.InvoiceHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="سجل الفواتير - لوحة التحكم"
        Width="1300"
        Height="820"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="#0F172A"
        FontFamily="29 LT BUKRA REGULAR">

    <Window.Resources>

        <SolidColorBrush x:Key="PrimaryColor" Color="#4F46E5"/>
        <SolidColorBrush x:Key="SecondaryColor" Color="#818CF8"/>
        <SolidColorBrush x:Key="BgColor" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor" Color="#1E293B"/>
        <SolidColorBrush x:Key="SubTextColor" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E2E8F0"/>

        <Style x:Key="ModernCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        Color="#0F172A"
                        Direction="270"
                        ShadowDepth="4"
                        BlurRadius="16"
                        Opacity="0.04"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="42,0,16,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="10">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4338CA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGrid">

            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="RowHeight" Value="56"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="FlowDirection" Value="RightToLeft"/>

        </Style>

        <Style TargetType="DataGridColumnHeader">

            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>

        </Style>

        <Style TargetType="DataGridRow">

            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>

                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EEF2FF"/>
                    <Setter Property="Foreground" Value="#312E81"/>
                </Trigger>

            </Style.Triggers>

        </Style>

        <Style TargetType="DataGridCell">

            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

        </Style>

        <Style x:Key="RightAlignedCellStyle"
               TargetType="TextBlock">

            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>

        </Style>

        <Style x:Key="TableActionButton"
               TargetType="Button">

            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="#EEF2FF"/>
            <Setter Property="Foreground" Value="#4F46E5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="10">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">

                    <Setter Property="Background" Value="#4F46E5"/>
                    <Setter Property="Foreground" Value="White"/>

                </Trigger>

            </Style.Triggers>

        </Style>

    </Window.Resources>


    <Border Background="{StaticResource BgColor}"
            CornerRadius="20"
            Margin="12">

        <Grid Margin="24">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <!-- HEADER -->

            <Grid Grid.Row="0"
                  Margin="0,0,0,20">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <StackPanel Grid.Column="0">

                    <TextBlock
                        Text="سجل الفواتير والمبيعات"
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextColor}"/>

                    <TextBlock
                        Text="لوحة متكاملة لمتابعة حركة البيع وتفاصيل الفواتير"
                        FontSize="13"
                        Foreground="{StaticResource SubTextColor}"
                        Margin="0,4,0,0"/>

                </StackPanel>


                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                    <Border
                        Background="White"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,8"
                        Margin="0,0,12,0">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock
                                Text="📅 اليوم:"
                                FontSize="12"
                                Foreground="{StaticResource SubTextColor}"
                                VerticalAlignment="Center"/>

                            <TextBlock
                                x:Name="TodayDateText"
                                Text="اليوم"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextColor}"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"/>

                        </StackPanel>

                    </Border>


                    <Button
                        Style="{StaticResource PrimaryButton}"
                        Width="125"
                        Content="+ فاتورة جديدة"
                        Click="NewInvoiceButton_Click"/>

                </StackPanel>

            </Grid>


            <!-- METRICS -->

            <Grid Grid.Row="1"
                  Margin="0,0,0,20">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>


                <Border Grid.Column="0"
                        Style="{StaticResource MetricCard}">

                    <StackPanel>

                        <TextBlock
                            Text="إجمالي المبيعات"
                            FontSize="12"
                            Foreground="{StaticResource SubTextColor}"/>

                        <TextBlock
                            x:Name="TodaySalesText"
                            Text="0.00 ج.م"
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="{StaticResource TextColor}"
                            Margin="0,6,0,0"/>

                    </StackPanel>

                </Border>


                <Border Grid.Column="2"
                        Style="{StaticResource MetricCard}">

                    <StackPanel>

                        <TextBlock
                            Text="عدد الفواتير المصدرة"
                            FontSize="12"
                            Foreground="{StaticResource SubTextColor}"/>

                        <TextBlock
                            x:Name="TodayInvoicesText"
                            Text="0 فاتورة"
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="{StaticResource TextColor}"
                            Margin="0,6,0,0"/>

                    </StackPanel>

                </Border>

            </Grid>


            <!-- FILTERS -->

            <Border Grid.Row="2"
                    Style="{StaticResource ModernCard}"
                    Padding="16"
                    Margin="0,0,0,16">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="110"/>

                    </Grid.ColumnDefinitions>


                    <!-- SEARCH -->

                    <Grid Grid.Column="0"
                          Margin="0,0,12,0">

                        <TextBox
                            x:Name="SearchBox"
                            Style="{StaticResource ModernTextBox}"
                            TextChanged="SearchBox_TextChanged"/>

                        <TextBlock
                            Text="🔍"
                            FontSize="14"
                            Foreground="#94A3B8"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            Margin="16,0,0,0"
                            IsHitTestVisible="False"/>

                    </Grid>


                    <!-- PAYMENT FILTER -->

                    <ComboBox
                        x:Name="PaymentFilterComboBox"
                        Grid.Column="1"
                        Style="{StaticResource ModernComboBox}"
                        SelectedIndex="0"
                        SelectionChanged="PaymentFilterComboBox_SelectionChanged"
                        Margin="0,0,12,0">

                        <ComboBoxItem Content="طريقة الدفع: الكل"/>
                        <ComboBoxItem Content="نقدي (Cash)"/>
                        <ComboBoxItem Content="فودافون كاش"/>

                    </ComboBox>


                    <!-- PERIOD FILTER -->

                    <ComboBox
                        x:Name="PeriodFilterComboBox"
                        Grid.Column="2"
                        Style="{StaticResource ModernComboBox}"
                        SelectedIndex="0"
                        SelectionChanged="PeriodFilterComboBox_SelectionChanged"
                        Margin="0,0,12,0">

                        <ComboBoxItem Content="الفترة: اليوم"/>
                        <ComboBoxItem Content="آخر 7 أيام"/>
                        <ComboBoxItem Content="هذا الشهر"/>
                        <ComboBoxItem Content="كل الفواتير"/>

                    </ComboBox>


                    <Button
                        Grid.Column="3"
                        Style="{StaticResource PrimaryButton}"
                        Content="بحث وتصفية"
                        Click="FilterButton_Click"/>

                </Grid>

            </Border>


            <!-- TABLE -->

            <Border Grid.Row="3"
                    Style="{StaticResource ModernCard}"
                    ClipToBounds="True">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="*"/>
                        <RowDefinition Height="50"/>

                    </Grid.RowDefinitions>


                    <DataGrid
                        x:Name="InvoicesGrid"
                        Grid.Row="0"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserAddRows="False"
                        HeadersVisibility="Column"
                        MouseDoubleClick="InvoicesGrid_MouseDoubleClick">

                        <DataGrid.Columns>

                            <DataGridTextColumn
                                Header="رقم الفاتورة"
                                Binding="{Binding InvoiceNumber}"
                                Width="1.2*"
                                ElementStyle="{StaticResource RightAlignedCellStyle}"/>

                            <DataGridTextColumn
                                Header="التاريخ والوقت"
                                Binding="{Binding SaleDate}"
                                Width="1.8*"
                                ElementStyle="{StaticResource RightAlignedCellStyle}"/>

                            <DataGridTextColumn
                                Header="الإجمالي"
                                Binding="{Binding Total, StringFormat={}{0:N2} ج.م}"
                                Width="1*"
                                ElementStyle="{StaticResource RightAlignedCellStyle}"/>

                            <DataGridTextColumn
                                Header="المدفوع"
                                Binding="{Binding Paid, StringFormat={}{0:N2} ج.م}"
                                Width="1*"
                                ElementStyle="{StaticResource RightAlignedCellStyle}"/>

                            <DataGridTextColumn
                                Header="الباقي"
                                Binding="{Binding Change, StringFormat={}{0:N2} ج.م}"
                                Width="1*"
                                ElementStyle="{StaticResource RightAlignedCellStyle}"/>

                            <DataGridTextColumn
                                Header="طريقة الدفع"
                                Binding="{Binding PaymentMethod}"
                                Width="1.3*"
                                ElementStyle="{StaticResource RightAlignedCellStyle}"/>

                            <DataGridTemplateColumn
                                Header="التفاصيل"
                                Width="80">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <Button
                                            Style="{StaticResource TableActionButton}"
                                            ToolTip="عرض تفاصيل الفاتورة"
                                            Content="➔"/>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                        </DataGrid.Columns>

                    </DataGrid>


                    <!-- FOOTER -->

                    <Border
                        Grid.Row="1"
                        Background="#F8FAFC"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="0,1,0,0"
                        Padding="20,0">

                        <Grid>

                            <TextBlock
                                Text="💡 انقر نقراً مزدوجاً فوق أي فاتورة لعرض تفاصيلها."
                                FontSize="12"
                                Foreground="{StaticResource SubTextColor}"
                                VerticalAlignment="Center"/>

                            <StackPanel
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right">

                                <TextBlock
                                    Text="إجمالي عدد الفواتير المعروضة:"
                                    FontSize="12"
                                    Foreground="{StaticResource SubTextColor}"/>

                                <TextBlock
                                    x:Name="InvoiceCountText"
                                    Text="0 فاتورة"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource TextColor}"
                                    Margin="6,0,0,0"/>

                            </StackPanel>

                        </Grid>

                    </Border>

                </Grid>

            </Border>


            <!-- FOOTER -->

            <TextBlock
                Grid.Row="4"
                Text="Three Store Management System • جميع الحقوق محفوظة"
                FontSize="11"
                Foreground="#64748B"
                HorizontalAlignment="Center"
                Margin="0,16,0,0"/>

        </Grid>

    </Border>

</Window>