<Window x:Class="WpfApp1.Views.SaleDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="بيانات الفاتورة والدفع"
        Width="560"
        Height="820"
        MinWidth="520"
        MinHeight="650"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="#F5F7FB"
        FontFamily="Segoe UI"
        ResizeMode="NoResize">

    <Window.Resources>

        <!-- =========================
             TEXTBOX
        ========================== -->

        <Style x:Key="InputStyle"
               TargetType="TextBox">

            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

        </Style>


        <!-- =========================
             CANCEL BUTTON
        ========================== -->

        <Style x:Key="CancelButtonStyle"
               TargetType="Button">

            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>

        </Style>


        <!-- =========================
             CONFIRM BUTTON
        ========================== -->

        <Style x:Key="ConfirmButtonStyle"
               TargetType="Button">

            <Setter Property="Width" Value="145"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>

        </Style>

    </Window.Resources>


    <!-- =====================================================
         MAIN SCROLL
    ====================================================== -->

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0">

        <Grid Margin="24">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="22"/>
                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <!-- =================================================
                 HEADER
            ================================================== -->

            <StackPanel Grid.Row="0">

                <TextBlock Text="بيانات الفاتورة والدفع"
                           FontSize="25"
                           FontWeight="Bold"
                           Foreground="#172033"/>

                <TextBlock Text="حدد بيانات العميل وطريقة السداد"
                           FontSize="13"
                           Foreground="#64748B"
                           Margin="0,4,0,0"/>

            </StackPanel>


            <!-- =================================================
                 TOTAL
            ================================================== -->

            <Border Grid.Row="2"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18">

                <StackPanel>

                    <TextBlock Text="إجمالي الفاتورة"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#64748B"
                               HorizontalAlignment="Center"/>

                    <TextBlock x:Name="InvoiceTotalTextBlock"
                               Text="0.00 ج.م"
                               FontSize="27"
                               FontWeight="Bold"
                               Foreground="#2563EB"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,0"/>

                </StackPanel>

            </Border>


            <!-- =================================================
                 CUSTOMER
            ================================================== -->

            <Border Grid.Row="4"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18">

                <StackPanel>

                    <TextBlock Text="بيانات العميل"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#1E293B"
                               Margin="0,0,0,15"/>


                    <!-- CUSTOMER NAME -->

                    <TextBlock Text="اسم العميل"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#475569"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="CustomerNameTextBox"
                             Style="{StaticResource InputStyle}"/>

                    <TextBlock x:Name="CustomerNameRequiredText"
                               Text="اسم العميل مطلوب عند اختيار الآجل"
                               FontSize="11"
                               Foreground="#DC2626"
                               Margin="0,5,0,0"
                               Visibility="Collapsed"/>


                    <!-- PHONE -->

                    <TextBlock Text="رقم الهاتف"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#475569"
                               Margin="0,15,0,6"/>

                    <TextBox x:Name="CustomerPhoneTextBox"
                             Style="{StaticResource InputStyle}"/>

                </StackPanel>

            </Border>


            <!-- =================================================
                 PAYMENT METHOD
            ================================================== -->

            <Border Grid.Row="6"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18">

                <StackPanel>

                    <TextBlock Text="طريقة الدفع"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#1E293B"
                               Margin="0,0,0,12"/>


                    <ComboBox x:Name="PaymentMethodComboBox"
                              Height="44"
                              FontSize="14"
                              SelectedIndex="0"
                              SelectionChanged="PaymentMethodComboBox_SelectionChanged">

                        <ComboBoxItem Content="نقدي"/>

                        <ComboBoxItem Content="فودافون كاش"/>

                    </ComboBox>


                    <!-- VODAFONE NUMBER -->

                    <TextBox x:Name="VodafoneCashNumberTextBox"
                             Height="44"
                             Padding="12,0"
                             FontSize="14"
                             Margin="0,10,0,0"
                             VerticalContentAlignment="Center"
                             Visibility="Collapsed"/>

                </StackPanel>

            </Border>


            <!-- =================================================
                 PAYMENT TYPE
            ================================================== -->

            <Border Grid.Row="8"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18">

                <StackPanel>

                    <TextBlock Text="نوع السداد"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#1E293B"
                               Margin="0,0,0,14"/>


                    <StackPanel Orientation="Horizontal">

                        <RadioButton x:Name="FullPaymentRadioButton"
                                     Content="دفع كامل"
                                     IsChecked="True"
                                     FontSize="14"
                                     Foreground="#334155"
                                     Margin="0,0,35,0"
                                     Checked="PaymentType_Checked"/>


                        <RadioButton x:Name="CreditPaymentRadioButton"
                                     Content="آجل"
                                     FontSize="14"
                                     Foreground="#334155"
                                     Checked="PaymentType_Checked"/>

                    </StackPanel>

                </StackPanel>

            </Border>


            <!-- =================================================
                 CREDIT PANEL
            ================================================== -->

            <Border x:Name="CreditPanel"
                    Grid.Row="10"
                    Background="#FFFBEB"
                    BorderBrush="#FDE68A"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18"
                    Visibility="Collapsed">

                <StackPanel>

                    <TextBlock Text="المبلغ المدفوع الآن"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#92400E"
                               Margin="0,0,0,7"/>


                    <TextBox x:Name="PaidAmountTextBox"
                             Height="44"
                             Padding="12,0"
                             FontSize="15"
                             TextAlignment="Center"
                             VerticalContentAlignment="Center"
                             TextChanged="PaidAmountTextBox_TextChanged"/>


                    <TextBlock x:Name="CreditRemainingTextBlock"
                               Text="الآجل: 0.00 ج.م"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="#B45309"
                               Margin="0,10,0,0"/>

                </StackPanel>

            </Border>


            <!-- =================================================
                 INFO
            ================================================== -->

            <Border Grid.Row="11"
                    Background="#F8FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12">

                <TextBlock Text="في حالة الآجل، يجب إدخال اسم العميل. ويمكن دفع جزء من الفاتورة وتسجيل الباقي كآجل."
                           FontSize="12"
                           Foreground="#64748B"
                           TextWrapping="Wrap"/>

            </Border>


            <!-- =================================================
                 BUTTONS
            ================================================== -->

            <StackPanel Grid.Row="12"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <Button Content="إلغاء"
                        Style="{StaticResource CancelButtonStyle}"
                        Margin="5"
                        Click="CancelButton_Click"/>


                <Button Content="✓  تأكيد الدفع"
                        Style="{StaticResource ConfirmButtonStyle}"
                        Margin="5"
                        Click="ConfirmButton_Click"/>

            </StackPanel>

        </Grid>

    </ScrollViewer>

</Window>