<Window x:Class="WpfApp1.Views.LowStockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="المخزون المنخفض"
        Height="700"
        Width="1100"
        MinHeight="600"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="#F4F7FB"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- COLORS -->

        <SolidColorBrush x:Key="PrimaryBrush"
                         Color="#2563EB"/>

        <SolidColorBrush x:Key="PrimaryDarkBrush"
                         Color="#1D4ED8"/>

        <SolidColorBrush x:Key="TextPrimaryBrush"
                         Color="#0F172A"/>

        <SolidColorBrush x:Key="TextSecondaryBrush"
                         Color="#64748B"/>

        <SolidColorBrush x:Key="TextMutedBrush"
                         Color="#94A3B8"/>

        <SolidColorBrush x:Key="BorderBrush"
                         Color="#E2E8F0"/>

        <!-- CARD SHADOW -->

        <DropShadowEffect x:Key="CardShadow"
                          Color="#CBD5E1"
                          BlurRadius="18"
                          ShadowDepth="3"
                          Direction="270"
                          Opacity="0.35"/>

        <!-- REFRESH BUTTON -->

        <Style x:Key="RefreshButtonStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#2563EB"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="18,10"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1D4ED8"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1E40AF"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <!-- MAIN -->

    <Grid Margin="30,24,30,24">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- HEADER -->

        <Grid Grid.Row="0"
              Margin="0,0,0,20">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>


            <StackPanel Grid.Column="0">

                <TextBlock Text="المخزون المنخفض"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <TextBlock Text="المنتجات التي وصلت إلى حد المخزون المنخفض"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,5,0,0"/>

            </StackPanel>


            <!-- REFRESH -->

            <Button Grid.Column="1"
                    Style="{StaticResource RefreshButtonStyle}"
                    Click="RefreshButton_Click">

                <StackPanel Orientation="Horizontal">

                    <TextBlock Text="↻"
                               FontSize="19"
                               Margin="0,0,7,0"/>

                    <TextBlock Text="تحديث المخزون"
                               VerticalAlignment="Center"/>

                </StackPanel>

            </Button>

        </Grid>


        <!-- SUMMARY -->

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="18"
                Padding="18"
                Margin="0,0,0,18"
                Effect="{StaticResource CardShadow}">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <!-- ICON -->

                <Border Width="52"
                        Height="52"
                        CornerRadius="15"
                        Background="#FFF7ED">

                    <TextBlock Text="⚠"
                               FontSize="24"
                               Foreground="#EA580C"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Border>


                <!-- TEXT -->

                <StackPanel Grid.Column="1"
                            Margin="14,0,0,0"
                            VerticalAlignment="Center">

                    <TextBlock Text="عدد المنتجات منخفضة المخزون"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"/>

                    <TextBlock x:Name="LowStockCountTextBlock"
                               Text="0"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#EA580C"
                               Margin="0,3,0,0"/>

                </StackPanel>


                <!-- RULE -->

                <Border Grid.Column="2"
                        Background="#F8FAFC"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,8">

                    <TextBlock x:Name="RuleTextBlock"
                               Text="الحد: أقل من 5"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>

                </Border>

            </Grid>

        </Border>


        <!-- DATA -->

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="18"
                Padding="15"
                Effect="{StaticResource CardShadow}">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>


                <!-- TABLE HEADER -->

                <Grid Grid.Row="0"
                      Margin="5,3,5,12">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="80"/>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="230"/>

                        <ColumnDefinition Width="150"/>

                        <ColumnDefinition Width="160"/>

                    </Grid.ColumnDefinitions>


                    <TextBlock Grid.Column="0"
                               Text="م"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               Text="اسم المنتج"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>

                    <TextBlock Grid.Column="2"
                               Text="التصنيف"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>

                    <TextBlock Grid.Column="3"
                               Text="الكمية الحالية"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>

                    <TextBlock Grid.Column="4"
                               Text="الحالة"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>

                </Grid>


                <!-- DATA GRID -->

                <DataGrid Grid.Row="1"
                          x:Name="LowStockDataGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="None"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E2E8F0"
                          BorderThickness="0"
                          Background="White"
                          RowBackground="White"
                          AlternatingRowBackground="#F8FAFC"
                          FontSize="13"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                    <!--
                        مهم:
                        مفيش Items أو Rows هنا.
                        الـ ItemsSource بيتحدد من LowStockWindow.xaml.cs
                    -->

                    <DataGrid.Resources>

                        <Style TargetType="DataGridRow">

                            <Setter Property="Height"
                                    Value="52"/>

                            <Setter Property="BorderThickness"
                                    Value="0"/>

                        </Style>

                        <Style TargetType="DataGridCell">

                            <Setter Property="BorderThickness"
                                    Value="0"/>

                            <Setter Property="Padding"
                                    Value="8"/>

                            <Setter Property="VerticalContentAlignment"
                                    Value="Center"/>

                        </Style>

                    </DataGrid.Resources>


                    <!-- NUMBER -->

                    <DataGridTextColumn Header="م"
                                        Binding="{Binding Number}"
                                        Width="80">

                        <DataGridTextColumn.ElementStyle>

                            <Style TargetType="TextBlock">

                                <Setter Property="HorizontalAlignment"
                                        Value="Center"/>

                                <Setter Property="VerticalAlignment"
                                        Value="Center"/>

                                <Setter Property="FontWeight"
                                        Value="SemiBold"/>

                                <Setter Property="Foreground"
                                        Value="#64748B"/>

                            </Style>

                        </DataGridTextColumn.ElementStyle>

                    </DataGridTextColumn>


                    <!-- PRODUCT -->

                    <DataGridTextColumn Header="اسم المنتج"
                                        Binding="{Binding ProductName}"
                                        Width="*">

                        <DataGridTextColumn.ElementStyle>

                            <Style TargetType="TextBlock">

                                <Setter Property="VerticalAlignment"
                                        Value="Center"/>

                                <Setter Property="FontWeight"
                                        Value="SemiBold"/>

                                <Setter Property="Foreground"
                                        Value="#0F172A"/>

                            </Style>

                        </DataGridTextColumn.ElementStyle>

                    </DataGridTextColumn>


                    <!-- CATEGORY -->

                    <DataGridTextColumn Header="التصنيف"
                                        Binding="{Binding CategoryName}"
                                        Width="230">

                        <DataGridTextColumn.ElementStyle>

                            <Style TargetType="TextBlock">

                                <Setter Property="VerticalAlignment"
                                        Value="Center"/>

                                <Setter Property="Foreground"
                                        Value="#64748B"/>

                            </Style>

                        </DataGridTextColumn.ElementStyle>

                    </DataGridTextColumn>


                    <!-- QUANTITY -->

                    <DataGridTextColumn Header="الكمية"
                                        Binding="{Binding Quantity}"
                                        Width="150">

                        <DataGridTextColumn.ElementStyle>

                            <Style TargetType="TextBlock">

                                <Setter Property="HorizontalAlignment"
                                        Value="Center"/>

                                <Setter Property="VerticalAlignment"
                                        Value="Center"/>

                                <Setter Property="FontWeight"
                                        Value="Bold"/>

                                <Setter Property="Foreground"
                                        Value="#EA580C"/>

                            </Style>

                        </DataGridTextColumn.ElementStyle>

                    </DataGridTextColumn>


                    <!-- STATUS -->

                    <DataGridTemplateColumn Header="الحالة"
                                            Width="160">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <Border Background="#FFF7ED"
                                        CornerRadius="9"
                                        Padding="12,6"
                                        HorizontalAlignment="Center">

                                    <TextBlock Text="⚠ مخزون منخفض"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#C2410C"/>

                                </Border>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid>

            </Grid>

        </Border>

    </Grid>

</Window>