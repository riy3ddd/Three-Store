<Window x:Class="WpfApp1.Views.EditOfferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تعديل العرض"
        Height="560"
        Width="650"
        MinHeight="500"
        MinWidth="580"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="#F5F7FB"
        FontFamily="Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>

        <!-- =========================================================
             COLORS
        ========================================================== -->

        <SolidColorBrush x:Key="PrimaryBrush"
                         Color="#2563EB"/>

        <SolidColorBrush x:Key="PrimaryHoverBrush"
                         Color="#1D4ED8"/>

        <SolidColorBrush x:Key="TextDarkBrush"
                         Color="#172033"/>

        <SolidColorBrush x:Key="TextBrush"
                         Color="#334155"/>

        <SolidColorBrush x:Key="TextSecondaryBrush"
                         Color="#64748B"/>

        <SolidColorBrush x:Key="BorderBrushLight"
                         Color="#E2E8F0"/>

        <!-- =========================================================
             SHADOW
        ========================================================== -->

        <DropShadowEffect x:Key="CardShadow"
                          Color="#64748B"
                          Opacity="0.10"
                          BlurRadius="22"
                          ShadowDepth="3"/>


        <!-- =========================================================
             PRIMARY BUTTON
        ========================================================== -->

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="44"/>

            <Setter Property="Padding"
                    Value="20,0"/>

            <Setter Property="Background"
                    Value="{StaticResource PrimaryBrush}"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource PrimaryHoverBrush}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.88"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.45"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- =========================================================
             SECONDARY BUTTON
        ========================================================== -->

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="44"/>

            <Setter Property="Width"
                    Value="100"/>

            <Setter Property="Background"
                    Value="#F8FAFC"/>

            <Setter Property="Foreground"
                    Value="#475569"/>

            <Setter Property="BorderBrush"
                    Value="#E2E8F0"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#F1F5F9"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#CBD5E1"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.85"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- =========================================================
             READ ONLY TEXTBOX
        ========================================================== -->

        <Style x:Key="ReadOnlyTextBoxStyle"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="45"/>

            <Setter Property="Background"
                    Value="#F8FAFC"/>

            <Setter Property="BorderBrush"
                    Value="#E2E8F0"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Foreground"
                    Value="#64748B"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Padding"
                    Value="12,0"/>

            <Setter Property="IsReadOnly"
                    Value="True"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>


        <!-- =========================================================
             INPUT TEXTBOX
        ========================================================== -->

        <Style x:Key="InputTextBoxStyle"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="45"/>

            <Setter Property="Background"
                    Value="#FFFFFF"/>

            <Setter Property="BorderBrush"
                    Value="#CBD5E1"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Foreground"
                    Value="#172033"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Padding"
                    Value="12,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>

    </Window.Resources>


    <!-- =============================================================
         MAIN CARD
    ============================================================= -->

    <Border Margin="28"
            Background="White"
            CornerRadius="20"
            Padding="25"
            Effect="{StaticResource CardShadow}">

        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="18"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="15"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="15"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <!-- =====================================================
                 HEADER
            ====================================================== -->

            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>


                <!-- ICON -->

                <Border Grid.Column="0"
                        Width="48"
                        Height="48"
                        CornerRadius="13"
                        Background="#EFF6FF"
                        VerticalAlignment="Center">

                    <TextBlock Text="✏"
                               FontSize="21"
                               Foreground="#2563EB"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Border>


                <!-- TITLE -->

                <StackPanel Grid.Column="1"
                            Margin="14,0,0,0"
                            VerticalAlignment="Center">

                    <TextBlock Text="تعديل العرض"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#172033"/>

                    <TextBlock Text="تعديل سعر العرض والخصم الخاص بالمنتج"
                               FontSize="12"
                               Foreground="#64748B"
                               Margin="0,4,0,0"/>

                </StackPanel>

            </Grid>


            <!-- =====================================================
                 PRODUCT
            ====================================================== -->

            <StackPanel Grid.Row="2">

                <TextBlock Text="المنتج"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#475569"
                           Margin="0,0,0,7"/>

                <Border Height="45"
                        Background="#F8FAFC"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="10">

                    <TextBox x:Name="ProductNameTextBox"
                             Style="{StaticResource ReadOnlyTextBoxStyle}"
                             Background="Transparent"
                             BorderThickness="0"/>

                </Border>

            </StackPanel>


            <!-- =====================================================
                 ORIGINAL PRICE
            ====================================================== -->

            <StackPanel Grid.Row="4">

                <TextBlock Text="السعر الأصلي"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#475569"
                           Margin="0,0,0,7"/>

                <Border Height="45"
                        Background="#F8FAFC"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="10">

                    <TextBox x:Name="OriginalPriceTextBox"
                             Style="{StaticResource ReadOnlyTextBoxStyle}"
                             Background="Transparent"
                             BorderThickness="0"/>

                </Border>

            </StackPanel>


            <!-- =====================================================
                 OFFER PRICE
            ====================================================== -->

            <StackPanel Grid.Row="6">

                <Grid Margin="0,0,0,7">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>


                    <TextBlock Grid.Column="0"
                               Text="سعر العرض الجديد"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#475569"/>


                    <Border Grid.Column="1"
                            Background="#ECFDF5"
                            BorderBrush="#BBF7D0"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="9,4">

                        <TextBlock x:Name="DiscountPreviewTextBlock"
                                   Text="الخصم: 0%"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#15803D"/>

                    </Border>

                </Grid>


                <Border Height="45"
                        Background="White"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        CornerRadius="10">

                    <TextBox x:Name="OfferPriceTextBox"
                             Style="{StaticResource InputTextBoxStyle}"
                             Background="Transparent"
                             BorderThickness="0"
                             TextChanged="OfferPriceTextBox_TextChanged"/>

                </Border>

            </StackPanel>


            <!-- =====================================================
                 BUTTONS
            ====================================================== -->

            <StackPanel Grid.Row="8"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,22,0,0">

                <!-- CANCEL -->

                <Button Content="إلغاء"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,10,0"
                        Click="CancelButton_Click"/>


                <!-- SAVE -->

                <Button Content="حفظ التعديل"
                        Width="135"
                        Height="44"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="SaveButton_Click"/>

            </StackPanel>

        </Grid>

    </Border>

</Window>