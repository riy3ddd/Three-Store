<Window x:Class="WpfApp1.Views.ExpensesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="المصروفات"
        Height="850"
        Width="1450"
        MinHeight="720"
        MinWidth="1150"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="#F6F8FB">

    <Window.Resources>

        <!-- ========================================================= -->
        <!-- SHADOW -->
        <!-- ========================================================= -->

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="18"
                          ShadowDepth="3"
                          Opacity="0.08"
                          Direction="270"/>


        <!-- ========================================================= -->
        <!-- CARD -->
        <!-- ========================================================= -->

        <Style x:Key="CardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="CornerRadius"
                    Value="16"/>

            <Setter Property="Padding"
                    Value="20"/>

            <Setter Property="Margin"
                    Value="6"/>

            <Setter Property="Effect"
                    Value="{StaticResource CardShadow}"/>

        </Style>


        <!-- ========================================================= -->
        <!-- KPI VALUE -->
        <!-- ========================================================= -->

        <Style x:Key="KpiValueStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="25"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="Foreground"
                    Value="#0F172A"/>

            <Setter Property="HorizontalAlignment"
                    Value="Right"/>

        </Style>


        <!-- ========================================================= -->
        <!-- KPI TITLE -->
        <!-- ========================================================= -->

        <Style x:Key="KpiTitleStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#64748B"/>

        </Style>


        <!-- ========================================================= -->
        <!-- DATA GRID -->
        <!-- ========================================================= -->

        <Style TargetType="DataGrid">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="RowHeight"
                    Value="54"/>

            <Setter Property="FontSize"
                    Value="13.5"/>

            <Setter Property="GridLinesVisibility"
                    Value="None"/>

            <Setter Property="HeadersVisibility"
                    Value="Column"/>

            <Setter Property="AutoGenerateColumns"
                    Value="False"/>

            <Setter Property="SelectionMode"
                    Value="Single"/>

            <Setter Property="SelectionUnit"
                    Value="FullRow"/>

            <Setter Property="CanUserResizeColumns"
                    Value="False"/>

            <Setter Property="CanUserReorderColumns"
                    Value="False"/>

            <Setter Property="HorizontalGridLinesBrush"
                    Value="Transparent"/>

            <Setter Property="VerticalGridLinesBrush"
                    Value="Transparent"/>

            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility"
                    Value="Disabled"/>

        </Style>


        <!-- ========================================================= -->
        <!-- DATA GRID HEADER -->
        <!-- ========================================================= -->

        <Style TargetType="DataGridColumnHeader">

            <Setter Property="Background"
                    Value="#F8FAFC"/>

            <Setter Property="Foreground"
                    Value="#475569"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Height"
                    Value="48"/>

            <Setter Property="Padding"
                    Value="5,0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

        </Style>


        <!-- ========================================================= -->
        <!-- DATA GRID ROW -->
        <!-- ========================================================= -->

        <Style TargetType="DataGridRow">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Foreground"
                    Value="#1E293B"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Margin"
                    Value="0,1"/>

            <Setter Property="Padding"
                    Value="0"/>

            <Style.Triggers>

                <!-- Hover -->

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#FAFCFB"/>

                </Trigger>


                <!-- Selected -->

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="#F3FAF5"/>

                    <Setter Property="Foreground"
                            Value="#1E293B"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ========================================================= -->
        <!-- DATA GRID CELL -->
        <!-- ========================================================= -->

        <Style TargetType="DataGridCell">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="#1E293B"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="5,0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Style.Triggers>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="Transparent"/>

                    <Setter Property="Foreground"
                            Value="#1E293B"/>

                </Trigger>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="Transparent"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ========================================================= -->
        <!-- ACTION BUTTON -->
        <!-- ========================================================= -->

        <Style x:Key="PrimaryButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="46"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="#16A34A"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Padding"
                    Value="22,0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="11">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ========================================================= -->
        <!-- INPUT -->
        <!-- ========================================================= -->

        <Style x:Key="ModernInput"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="40"/>

            <Setter Property="FontSize"
                    Value="13.5"/>

            <Setter Property="Padding"
                    Value="12,5"/>

            <Setter Property="Background"
                    Value="#F8FAFC"/>

            <Setter Property="BorderBrush"
                    Value="#E2E8F0"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

        </Style>


        <!-- ========================================================= -->
        <!-- COMBO -->
        <!-- ========================================================= -->

        <Style x:Key="ModernCombo"
               TargetType="ComboBox">

            <Setter Property="Height"
                    Value="40"/>

            <Setter Property="FontSize"
                    Value="13.5"/>

            <Setter Property="Padding"
                    Value="10,5"/>

            <Setter Property="Background"
                    Value="#F8FAFC"/>

            <Setter Property="BorderBrush"
                    Value="#E2E8F0"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

        </Style>

    </Window.Resources>


    <!-- ============================================================= -->
    <!-- MAIN -->
    <!-- ============================================================= -->

    <Grid Margin="28">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- ========================================================= -->
        <!-- HEADER -->
        <!-- ========================================================= -->

        <Grid Grid.Row="0"
              Margin="0,0,0,22">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>


            <StackPanel Grid.Column="0">

                <StackPanel Orientation="Horizontal">

                    <Border Width="5"
                            Height="34"
                            Background="#16A34A"
                            CornerRadius="3"
                            Margin="0,0,12,0"/>

                    <TextBlock Text="المصروفات"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               VerticalAlignment="Center"/>

                </StackPanel>


                <TextBlock Text="إدارة ومتابعة العمليات والمصروفات المالية للمحل"
                           FontSize="13.5"
                           Foreground="#64748B"
                           Margin="17,7,0,0"/>

            </StackPanel>


            <Button Grid.Column="1"
                    Content="+  إضافة مصروف"
                    Width="170"
                    Style="{StaticResource PrimaryButton}"
                    Click="AddExpenseButton_Click"/>

        </Grid>


        <!-- ========================================================= -->
        <!-- KPI CARDS -->
        <!-- ========================================================= -->

        <Grid Grid.Row="1"
              Margin="0,0,0,18">

            <Grid.ColumnDefinitions>

                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>

            </Grid.ColumnDefinitions>


            <!-- TODAY -->

            <Border Grid.Column="0"
                    Style="{StaticResource CardStyle}">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="52"/>

                    </Grid.ColumnDefinitions>


                    <StackPanel Grid.Column="0">

                        <TextBlock Text="مصروفات اليوم"
                                   Style="{StaticResource KpiTitleStyle}"/>

                        <TextBlock x:Name="TodayExpensesText"
                                   Text="0.00 ج.م"
                                   Style="{StaticResource KpiValueStyle}"
                                   Margin="0,8,0,0" Width="132"/>

                    </StackPanel>


                    <Border Grid.Column="1"
                            Width="44"
                            Height="44"
                            Background="#ECFDF5"
                            CornerRadius="12"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">

                        <TextBlock Text="ج"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#16A34A"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>

                </Grid>

            </Border>


            <!-- 7 DAYS -->

            <Border Grid.Column="1"
                    Style="{StaticResource CardStyle}">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="52"/>

                    </Grid.ColumnDefinitions>


                    <StackPanel Grid.Column="0">

                        <TextBlock Text="آخر 7 أيام"
                                   Style="{StaticResource KpiTitleStyle}"/>

                        <TextBlock x:Name="Last7DaysExpensesText"
                                   Text="0.00 ج.م"
                                   Style="{StaticResource KpiValueStyle}"
                                   Margin="0,8,0,0" Width="160"/>

                    </StackPanel>


                    <Border Grid.Column="1"
                            Width="44"
                            Height="44"
                            Background="#EFF6FF"
                            CornerRadius="12"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">

                        <TextBlock Text="7"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#2563EB"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>

                </Grid>

            </Border>


            <!-- MONTH -->

            <Border Grid.Column="2"
                    Style="{StaticResource CardStyle}">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="52"/>

                    </Grid.ColumnDefinitions>


                    <StackPanel Grid.Column="0">

                        <TextBlock Text="هذا الشهر"
                                   Style="{StaticResource KpiTitleStyle}"/>

                        <TextBlock x:Name="ThisMonthExpensesText"
                                   Text="0.00 ج.م"
                                   Style="{StaticResource KpiValueStyle}"
                                   Margin="0,8,0,0" Width="166"/>

                    </StackPanel>


                    <Border Grid.Column="1"
                            Width="44"
                            Height="44"
                            Background="#FFF7ED"
                            CornerRadius="12"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">

                        <TextBlock Text="M"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="#EA580C"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>

                </Grid>

            </Border>


            <!-- COUNT -->

            <Border Grid.Column="3"
                    Style="{StaticResource CardStyle}">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="52"/>

                    </Grid.ColumnDefinitions>


                    <StackPanel Grid.Column="0">

                        <TextBlock Text="عدد عمليات الصرف"
                                   Style="{StaticResource KpiTitleStyle}"/>

                        <TextBlock x:Name="ExpensesCountText"
                                   Text="0"
                                   Style="{StaticResource KpiValueStyle}"
                                   Margin="0,8,0,0" Width="92"/>

                    </StackPanel>


                    <Border Grid.Column="1"
                            Width="44"
                            Height="44"
                            Background="#F5F3FF"
                            CornerRadius="12"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">

                        <TextBlock Text="#"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#7C3AED"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>

                </Grid>

            </Border>

        </Grid>


        <!-- ========================================================= -->
        <!-- FILTER BAR -->
        <!-- ========================================================= -->

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="16"
                Padding="20"
                Margin="6,0,6,18"
                Effect="{StaticResource CardShadow}">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>


                <StackPanel Grid.Column="0"
                            Margin="0,0,20,0">

                    <TextBlock Text="الفترة"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#64748B"
                               Margin="0,0,0,6"/>

                    <ComboBox x:Name="PeriodComboBox"
                              Style="{StaticResource ModernCombo}"
                              SelectedIndex="2"
                              SelectionChanged="PeriodComboBox_SelectionChanged">

                        <ComboBoxItem Content="اليوم"/>
                        <ComboBoxItem Content="آخر 7 أيام"/>
                        <ComboBoxItem Content="آخر 30 يوم"/>
                        <ComboBoxItem Content="آخر شهرين"/>
                        <ComboBoxItem Content="آخر 3 شهور"/>
                        <ComboBoxItem Content="آخر 6 شهور"/>
                        <ComboBoxItem Content="آخر 12 شهر"/>
                        <ComboBoxItem Content="آخر 24 شهر"/>

                    </ComboBox>

                </StackPanel>


                <StackPanel Grid.Column="1">

                    <TextBlock Text="البحث في المصروفات"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#64748B"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="SearchTextBox"
                             Style="{StaticResource ModernInput}"
                             TextChanged="SearchTextBox_TextChanged"
                             ToolTip="ابحث برقم العملية أو البيان"/>

                </StackPanel>


                <Border Grid.Column="2"
                        HorizontalAlignment="Left"
                        Background="#F0FDF4"
                        BorderBrush="#DCFCE7"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18,10"
                        Margin="30,0,0,0">

                    <StackPanel>

                        <TextBlock Text="إجمالي الفترة المحددة"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="#64748B"/>

                        <TextBlock x:Name="SelectedPeriodTotalText"
                                   Text="0.00 ج.م"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="#15803D"
                                   Margin="0,3,0,0"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>


        <!-- ========================================================= -->
        <!-- EXPENSES TABLE -->
        <!-- ========================================================= -->

        <Border Grid.Row="3"
                Background="White"
                CornerRadius="16"
                Padding="12"
                Margin="6,0,6,6"
                Effect="{StaticResource CardShadow}">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>


                <!-- TABLE TITLE -->

                <Grid Grid.Row="0"
                      Margin="8,5,8,12">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>


                    <StackPanel Grid.Column="0">

                        <TextBlock Text="سجل المصروفات"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="#1E293B"/>

                        <TextBlock Text="يمكنك الضغط مرتين على أي عملية لعرض تفاصيلها"
                                   FontSize="11.5"
                                   Foreground="#94A3B8"
                                   Margin="0,4,0,0"/>

                    </StackPanel>


                    <Border Grid.Column="1"
                            Background="#F8FAFC"
                            CornerRadius="8"
                            Padding="12,7"
                            VerticalAlignment="Center">

                        <TextBlock Text="سجل العمليات"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="#64748B"/>

                    </Border>

                </Grid>


                <!-- ================================================= -->
                <!-- EXPENSES DATAGRID -->
                <!-- ================================================= -->
                <DataGrid Grid.Row="1"
          x:Name="ExpensesDataGrid"
          SelectionMode="Single"
          SelectionUnit="FullRow"
          IsReadOnly="True"
          MouseDoubleClick="ExpensesDataGrid_MouseDoubleClick">

                    <DataGrid.Columns>

                        <!-- ===================================================== -->
                        <!-- # -->
                        <!-- ===================================================== -->

                        <DataGridTextColumn Header="#"
                            Width="65"
                            Binding="{Binding RowNumber}">

                            <DataGridTextColumn.ElementStyle>

                                <Style TargetType="TextBlock">

                                    <Setter Property="HorizontalAlignment"
                            Value="Center"/>

                                    <Setter Property="VerticalAlignment"
                            Value="Center"/>

                                    <Setter Property="TextAlignment"
                            Value="Center"/>

                                </Style>

                            </DataGridTextColumn.ElementStyle>

                        </DataGridTextColumn>


                        <!-- ===================================================== -->
                        <!-- رقم العملية -->
                        <!-- ===================================================== -->

                        <DataGridTextColumn Header="رقم العملية"
                            Width="170"
                            Binding="{Binding ExpenseNumber}">

                            <DataGridTextColumn.ElementStyle>

                                <Style TargetType="TextBlock">

                                    <Setter Property="HorizontalAlignment"
                            Value="Center"/>

                                    <Setter Property="VerticalAlignment"
                            Value="Center"/>

                                    <Setter Property="TextAlignment"
                            Value="Center"/>

                                </Style>

                            </DataGridTextColumn.ElementStyle>

                        </DataGridTextColumn>


                        <!-- ===================================================== -->
                        <!-- نوع المصروف -->
                        <!-- ===================================================== -->

                        <DataGridTextColumn Header="نوع المصروف"
                            Width="190"
                            Binding="{Binding CategoryName}">

                            <DataGridTextColumn.ElementStyle>

                                <Style TargetType="TextBlock">

                                    <Setter Property="HorizontalAlignment"
                            Value="Center"/>

                                    <Setter Property="VerticalAlignment"
                            Value="Center"/>

                                    <Setter Property="TextAlignment"
                            Value="Center"/>

                                </Style>

                            </DataGridTextColumn.ElementStyle>

                        </DataGridTextColumn>


                        <!-- ===================================================== -->
                        <!-- البيان -->
                        <!-- ===================================================== -->

                        <DataGridTextColumn Header="البيان"
                            Width="*"
                            Binding="{Binding Description}">

                            <DataGridTextColumn.ElementStyle>

                                <Style TargetType="TextBlock">

                                    <Setter Property="HorizontalAlignment"
                            Value="Center"/>

                                    <Setter Property="VerticalAlignment"
                            Value="Center"/>

                                    <Setter Property="TextAlignment"
                            Value="Center"/>

                                    <Setter Property="TextWrapping"
                            Value="NoWrap"/>

                                </Style>

                            </DataGridTextColumn.ElementStyle>

                        </DataGridTextColumn>


                        <!-- ===================================================== -->
                        <!-- المبلغ -->
                        <!-- ===================================================== -->

                        <DataGridTextColumn Header="المبلغ"
                            Width="170"
                            Binding="{Binding Amount, StringFormat={}{0:N2} ج.م}">

                            <DataGridTextColumn.ElementStyle>

                                <Style TargetType="TextBlock">

                                    <Setter Property="HorizontalAlignment"
                            Value="Center"/>

                                    <Setter Property="VerticalAlignment"
                            Value="Center"/>

                                    <Setter Property="TextAlignment"
                            Value="Center"/>

                                </Style>

                            </DataGridTextColumn.ElementStyle>

                        </DataGridTextColumn>


                        <!-- ===================================================== -->
                        <!-- التاريخ -->
                        <!-- ===================================================== -->

                        <DataGridTextColumn Header="التاريخ"
                            Width="200"
                            Binding="{Binding ExpenseDate, StringFormat=dd/MM/yyyy HH:mm}">

                            <DataGridTextColumn.ElementStyle>

                                <Style TargetType="TextBlock">

                                    <Setter Property="HorizontalAlignment"
                            Value="Center"/>

                                    <Setter Property="VerticalAlignment"
                            Value="Center"/>

                                    <Setter Property="TextAlignment"
                            Value="Center"/>

                                </Style>

                            </DataGridTextColumn.ElementStyle>

                        </DataGridTextColumn>


                        <!-- ===================================================== -->
                        <!-- المستخدم -->
                        <!-- ===================================================== -->

                        <DataGridTextColumn Header="المستخدم"
                            Width="150"
                            Binding="{Binding Username}">

                            <DataGridTextColumn.ElementStyle>

                                <Style TargetType="TextBlock">

                                    <Setter Property="HorizontalAlignment"
                            Value="Center"/>

                                    <Setter Property="VerticalAlignment"
                            Value="Center"/>

                                    <Setter Property="TextAlignment"
                            Value="Center"/>

                                </Style>

                            </DataGridTextColumn.ElementStyle>

                        </DataGridTextColumn>

                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

        </Border>

    </Grid>

</Window>