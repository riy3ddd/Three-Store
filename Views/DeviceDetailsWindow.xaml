<Window x:Class="WpfApp1.Views.DeviceDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تفاصيل الجهاز"
        Width="760"
        Height="720"
        MinWidth="700"
        MinHeight="650"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="#F5F7FA"
        FontFamily="Segoe UI"
        ResizeMode="NoResize">

    <Window.Resources>

        <!-- ========================= -->
        <!-- Button Style -->
        <!-- ========================= -->

        <Style x:Key="CloseButtonStyle"
               TargetType="Button">

            <Setter Property="Width"
                    Value="125"/>

            <Setter Property="Height"
                    Value="44"/>

            <Setter Property="Background"
                    Value="#2563EB"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ========================= -->
        <!-- Label Style -->
        <!-- ========================= -->

        <Style x:Key="DetailsLabelStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#64748B"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

        </Style>


        <!-- ========================= -->
        <!-- Value Style -->
        <!-- ========================= -->

        <Style x:Key="DetailsValueStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#0F172A"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

        </Style>

    </Window.Resources>


    <!-- ========================= -->
    <!-- MAIN CARD -->
    <!-- ========================= -->

    <Border Margin="20"
            Padding="28"
            Background="White"
            CornerRadius="16">

        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="20"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="20"/>

                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <!-- ========================= -->
            <!-- HEADER -->
            <!-- ========================= -->

            <StackPanel Grid.Row="0">

                <TextBlock Text="تفاصيل الجهاز"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#0F172A"/>

                <TextBlock Text="عرض جميع بيانات الجهاز ومعلومات البيع"
                           FontSize="14"
                           Foreground="#64748B"
                           Margin="0,6,0,0"/>

            </StackPanel>


            <!-- ========================= -->
            <!-- DETAILS -->
            <!-- ========================= -->

            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <Grid Margin="0,5,0,5">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="180"/>

                        <ColumnDefinition Width="20"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <Grid.RowDefinitions>

                        <RowDefinition Height="52"/>

                        <RowDefinition Height="52"/>

                        <RowDefinition Height="52"/>

                        <RowDefinition Height="52"/>

                        <RowDefinition Height="52"/>

                        <RowDefinition Height="52"/>

                        <RowDefinition Height="52"/>

                        <RowDefinition Height="52"/>

                        <RowDefinition Height="52"/>

                        <RowDefinition Height="52"/>

                        <RowDefinition Height="52"/>

                        <RowDefinition Height="52"/>

                        <RowDefinition Height="52"/>

                        <RowDefinition Height="95"/>

                    </Grid.RowDefinitions>


                    <!-- ========================= -->
                    <!-- اسم الجهاز -->
                    <!-- ========================= -->

                    <Border Grid.Row="0"
                            Grid.Column="0"
                            Background="#F8FAFC"
                            CornerRadius="7"
                            Padding="10">

                        <TextBlock Text="اسم الجهاز"
                                   Style="{StaticResource DetailsLabelStyle}"/>

                    </Border>

                    <TextBlock x:Name="DeviceNameText"
                               Grid.Row="0"
                               Grid.Column="2"
                               Style="{StaticResource DetailsValueStyle}"/>


                    <!-- ========================= -->
                    <!-- الرقم التسلسلي -->
                    <!-- ========================= -->

                    <Border Grid.Row="1"
                            Grid.Column="0"
                            Background="#F8FAFC"
                            CornerRadius="7"
                            Padding="10">

                        <TextBlock Text="الرقم التسلسلي"
                                   Style="{StaticResource DetailsLabelStyle}"/>

                    </Border>

                    <TextBlock x:Name="SerialNumberText"
                               Grid.Row="1"
                               Grid.Column="2"
                               Style="{StaticResource DetailsValueStyle}"/>


                    <!-- ========================= -->
                    <!-- نوع الجهاز -->
                    <!-- ========================= -->

                    <Border Grid.Row="2"
                            Grid.Column="0"
                            Background="#F8FAFC"
                            CornerRadius="7"
                            Padding="10">

                        <TextBlock Text="نوع الجهاز"
                                   Style="{StaticResource DetailsLabelStyle}"/>

                    </Border>

                    <TextBlock x:Name="DeviceTypeText"
                               Grid.Row="2"
                               Grid.Column="2"
                               Style="{StaticResource DetailsValueStyle}"/>


                    <!-- ========================= -->
                    <!-- الحالة -->
                    <!-- ========================= -->

                    <Border Grid.Row="3"
                            Grid.Column="0"
                            Background="#F8FAFC"
                            CornerRadius="7"
                            Padding="10">

                        <TextBlock Text="الحالة"
                                   Style="{StaticResource DetailsLabelStyle}"/>

                    </Border>


                    <Border Grid.Row="3"
                            Grid.Column="2"
                            Background="#ECFDF5"
                            CornerRadius="7"
                            Padding="8,4"
                            HorizontalAlignment="Left">

                        <TextBlock x:Name="DeviceStatusText"
                                   Foreground="#16A34A"
                                   FontSize="13"
                                   FontWeight="SemiBold"/>

                    </Border>


                    <!-- ========================= -->
                    <!-- RAM -->
                    <!-- ========================= -->

                    <Border Grid.Row="4"
                            Grid.Column="0"
                            Background="#F8FAFC"
                            CornerRadius="7"
                            Padding="10">

                        <TextBlock Text="RAM"
                                   Style="{StaticResource DetailsLabelStyle}"/>

                    </Border>

                    <TextBlock x:Name="RAMText"
                               Grid.Row="4"
                               Grid.Column="2"
                               Style="{StaticResource DetailsValueStyle}"/>


                    <!-- ========================= -->
                    <!-- Storage -->
                    <!-- ========================= -->

                    <Border Grid.Row="5"
                            Grid.Column="0"
                            Background="#F8FAFC"
                            CornerRadius="7"
                            Padding="10">

                        <TextBlock Text="Storage"
                                   Style="{StaticResource DetailsLabelStyle}"/>

                    </Border>

                    <TextBlock x:Name="StorageText"
                               Grid.Row="5"
                               Grid.Column="2"
                               Style="{StaticResource DetailsValueStyle}"/>


                    <!-- ========================= -->
                    <!-- الإكسسوارات -->
                    <!-- ========================= -->

                    <Border Grid.Row="6"
                            Grid.Column="0"
                            Background="#F8FAFC"
                            CornerRadius="7"
                            Padding="10">

                        <TextBlock Text="الإكسسوارات"
                                   Style="{StaticResource DetailsLabelStyle}"/>

                    </Border>

                    <TextBlock x:Name="AccessoriesText"
                               Grid.Row="6"
                               Grid.Column="2"
                               Style="{StaticResource DetailsValueStyle}"
                               TextWrapping="Wrap"/>


                    <!-- ========================= -->
                    <!-- اسم العميل -->
                    <!-- ========================= -->

                    <Border Grid.Row="7"
                            Grid.Column="0"
                            Background="#F8FAFC"
                            CornerRadius="7"
                            Padding="10">

                        <TextBlock Text="اسم العميل"
                                   Style="{StaticResource DetailsLabelStyle}"/>

                    </Border>

                    <TextBlock x:Name="CustomerNameText"
                               Grid.Row="7"
                               Grid.Column="2"
                               Style="{StaticResource DetailsValueStyle}"/>


                    <!-- ========================= -->
                    <!-- رقم الهاتف -->
                    <!-- ========================= -->

                    <Border Grid.Row="8"
                            Grid.Column="0"
                            Background="#F8FAFC"
                            CornerRadius="7"
                            Padding="10">

                        <TextBlock Text="رقم الهاتف"
                                   Style="{StaticResource DetailsLabelStyle}"/>

                    </Border>

                    <TextBlock x:Name="CustomerPhoneText"
                               Grid.Row="8"
                               Grid.Column="2"
                               Style="{StaticResource DetailsValueStyle}"/>


                    <!-- ========================= -->
                    <!-- سعر الشراء -->
                    <!-- ========================= -->

                    <Border Grid.Row="9"
                            Grid.Column="0"
                            Background="#F8FAFC"
                            CornerRadius="7"
                            Padding="10">

                        <TextBlock Text="سعر الشراء"
                                   Style="{StaticResource DetailsLabelStyle}"/>

                    </Border>

                    <TextBlock x:Name="PurchasePriceText"
                               Grid.Row="9"
                               Grid.Column="2"
                               Style="{StaticResource DetailsValueStyle}"/>


                    <!-- ========================= -->
                    <!-- سعر البيع -->
                    <!-- ========================= -->

                    <Border Grid.Row="10"
                            Grid.Column="0"
                            Background="#F8FAFC"
                            CornerRadius="7"
                            Padding="10">

                        <TextBlock Text="سعر البيع"
                                   Style="{StaticResource DetailsLabelStyle}"/>

                    </Border>

                    <TextBlock x:Name="SellingPriceText"
                               Grid.Row="10"
                               Grid.Column="2"
                               Style="{StaticResource DetailsValueStyle}"/>


                    <!-- ========================= -->
                    <!-- تاريخ الإضافة -->
                    <!-- ========================= -->

                    <Border Grid.Row="11"
                            Grid.Column="0"
                            Background="#F8FAFC"
                            CornerRadius="7"
                            Padding="10">

                        <TextBlock Text="تاريخ الإضافة"
                                   Style="{StaticResource DetailsLabelStyle}"/>

                    </Border>

                    <TextBlock x:Name="AddedDateText"
                               Grid.Row="11"
                               Grid.Column="2"
                               Style="{StaticResource DetailsValueStyle}"/>


                    <!-- ========================= -->
                    <!-- تاريخ البيع -->
                    <!-- ========================= -->

                    <Border Grid.Row="12"
                            Grid.Column="0"
                            Background="#F8FAFC"
                            CornerRadius="7"
                            Padding="10">

                        <TextBlock Text="تاريخ البيع"
                                   Style="{StaticResource DetailsLabelStyle}"/>

                    </Border>

                    <TextBlock x:Name="SoldDateText"
                               Grid.Row="12"
                               Grid.Column="2"
                               Style="{StaticResource DetailsValueStyle}"/>


                    <!-- ========================= -->
                    <!-- ملاحظات -->
                    <!-- ========================= -->

                    <Border Grid.Row="13"
                            Grid.Column="0"
                            Background="#F8FAFC"
                            CornerRadius="7"
                            Padding="10"
                            VerticalAlignment="Stretch">

                        <TextBlock Text="ملاحظات"
                                   Style="{StaticResource DetailsLabelStyle}"
                                   VerticalAlignment="Top"/>

                    </Border>

                    <TextBlock x:Name="NotesText"
                               Grid.Row="13"
                               Grid.Column="2"
                               Style="{StaticResource DetailsValueStyle}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Top"
                               Margin="0,8,0,0"/>

                </Grid>

            </ScrollViewer>


            <!-- ========================= -->
            <!-- CLOSE BUTTON -->
            <!-- ========================= -->

            <Button Grid.Row="4"
                    Content="إغلاق"
                    Style="{StaticResource CloseButtonStyle}"
                    HorizontalAlignment="Center"
                    Click="CloseButton_Click"/>

        </Grid>

    </Border>

</Window>