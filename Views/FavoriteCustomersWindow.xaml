<Window x:Class="WpfApp1.Views.FavoriteCustomersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="العملاء المفضلين"
        Height="820"
        Width="1400"
        MinHeight="720"
        MinWidth="1150"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- =====================================================
             COLORS
             ===================================================== -->

        <SolidColorBrush x:Key="PrimaryBrush"
                         Color="#0F172A"/>

        <SolidColorBrush x:Key="AccentBrush"
                         Color="#16A34A"/>

        <SolidColorBrush x:Key="BlueBrush"
                         Color="#2563EB"/>

        <SolidColorBrush x:Key="LightBlueBrush"
                         Color="#EFF6FF"/>

        <SolidColorBrush x:Key="LightGreenBrush"
                         Color="#ECFDF5"/>

        <SolidColorBrush x:Key="LightYellowBrush"
                         Color="#FEFCE8"/>

        <SolidColorBrush x:Key="TextBrush"
                         Color="#0F172A"/>

        <SolidColorBrush x:Key="SecondaryTextBrush"
                         Color="#64748B"/>

        <SolidColorBrush x:Key="MutedTextBrush"
                         Color="#94A3B8"/>

        <SolidColorBrush x:Key="BorderBrush"
                         Color="#E2E8F0"/>


        <!-- =====================================================
             SHADOW
             ===================================================== -->

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="18"
                          ShadowDepth="2"
                          Direction="270"
                          Opacity="0.08"/>


        <!-- =====================================================
             CARD
             ===================================================== -->

        <Style x:Key="CardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="CornerRadius"
                    Value="16"/>

            <Setter Property="BorderBrush"
                    Value="#E2E8F0"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="20"/>

            <Setter Property="Effect"
                    Value="{StaticResource CardShadow}"/>

        </Style>


        <!-- =====================================================
             COMBOBOX
             ===================================================== -->

        <Style x:Key="ModernComboBoxStyle"
               TargetType="ComboBox">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="MinWidth"
                    Value="145"/>

            <Setter Property="Padding"
                    Value="12,0"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Foreground"
                    Value="#0F172A"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#CBD5E1"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

        </Style>


        <!-- =====================================================
             SEARCH
             ===================================================== -->

        <Style x:Key="SearchTextBoxStyle"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Padding"
                    Value="42,0,14,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="Foreground"
                    Value="#0F172A"/>

            <Setter Property="Background"
                    Value="#F8FAFC"/>

            <Setter Property="BorderBrush"
                    Value="#CBD5E1"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

        </Style>


        <!-- =====================================================
             REFRESH BUTTON
             ===================================================== -->

        <Style x:Key="RefreshButtonStyle"
               TargetType="Button">

            <Setter Property="Width"
                    Value="112"/>

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="Background"
                    Value="#0F172A"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10">

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#1E293B"/>

                </Trigger>

                <Trigger Property="IsPressed"
                         Value="True">

                    <Setter Property="Background"
                            Value="#020617"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- =====================================================
             DATAGRID
             ===================================================== -->

        <Style x:Key="ModernDataGridStyle"
               TargetType="DataGrid">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Foreground"
                    Value="#0F172A"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="RowHeight"
                    Value="58"/>

            <Setter Property="FontSize"
                    Value="13.5"/>

            <Setter Property="GridLinesVisibility"
                    Value="None"/>

            <Setter Property="HeadersVisibility"
                    Value="Column"/>

            <Setter Property="CanUserAddRows"
                    Value="False"/>

            <Setter Property="CanUserDeleteRows"
                    Value="False"/>

            <Setter Property="CanUserResizeRows"
                    Value="False"/>

            <Setter Property="AutoGenerateColumns"
                    Value="False"/>

            <Setter Property="SelectionMode"
                    Value="Single"/>

            <Setter Property="SelectionUnit"
                    Value="FullRow"/>

            <Setter Property="IsReadOnly"
                    Value="True"/>

            <Setter Property="HorizontalGridLinesBrush"
                    Value="#F1F5F9"/>

            <Setter Property="VerticalGridLinesBrush"
                    Value="Transparent"/>

        </Style>


        <!-- =====================================================
             DATAGRID HEADER
             ===================================================== -->

        <Style TargetType="DataGridColumnHeader">

            <Setter Property="Background"
                    Value="#F8FAFC"/>

            <Setter Property="Foreground"
                    Value="#475569"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Height"
                    Value="50"/>

            <Setter Property="Padding"
                    Value="10,0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="TextElement.FontWeight"
                    Value="SemiBold"/>

            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>

            <Setter Property="BorderBrush"
                    Value="#E2E8F0"/>

        </Style>


        <!-- =====================================================
             DATAGRID ROW
             ===================================================== -->

        <Style TargetType="DataGridRow">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#F8FAFC"/>

                </Trigger>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="#EFF6FF"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- =====================================================
             DATAGRID CELL
             ===================================================== -->

        <Style TargetType="DataGridCell">

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="10,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

        </Style>


        <!-- =====================================================
             TABLE TEXT
             ===================================================== -->

        <Style x:Key="TableTextStyle"
               TargetType="TextBlock">

            <Setter Property="HorizontalAlignment"
                    Value="Center"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="TextAlignment"
                    Value="Center"/>

            <Setter Property="TextWrapping"
                    Value="NoWrap"/>

            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis"/>

        </Style>


        <!-- =====================================================
             NUMBER BADGE
             ===================================================== -->

        <Style x:Key="NumberBadgeStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="#F1F5F9"/>

            <Setter Property="CornerRadius"
                    Value="8"/>

            <Setter Property="MinWidth"
                    Value="34"/>

            <Setter Property="Height"
                    Value="30"/>

            <Setter Property="HorizontalAlignment"
                    Value="Center"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

        </Style>


        <!-- =====================================================
             COUNT BADGE
             ===================================================== -->

        <Style x:Key="CountBadgeStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="#EFF6FF"/>

            <Setter Property="CornerRadius"
                    Value="8"/>

            <Setter Property="MinWidth"
                    Value="46"/>

            <Setter Property="Height"
                    Value="30"/>

            <Setter Property="HorizontalAlignment"
                    Value="Center"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

        </Style>

    </Window.Resources>


    <!-- =========================================================
         MAIN
         ========================================================= -->

    <Grid Margin="26">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- =====================================================
             HEADER
             ===================================================== -->

        <Grid Grid.Row="0"
              Margin="4,0,4,22">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>


            <!-- Title -->

            <Grid Grid.Column="0">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>


                <Border Grid.Column="0"
                        Width="54"
                        Height="54"
                        Background="#FFF7ED"
                        CornerRadius="15"
                        Margin="0,0,14,0">

                    <TextBlock Text="⭐"
                               FontSize="25"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Border>


                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">

                    <TextBlock Text="العملاء المفضلين"
                               FontSize="27"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"
                               TextAlignment="Left" Width="1150"/>

                    <TextBlock Text="تابع العملاء الأكثر تكرارًا في فواتير المبيعات والصيانة."
                               FontSize="13"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,5,0,0"
                               TextAlignment="Left"/>

                </StackPanel>

            </Grid>


            <!-- Refresh -->

            <Button Grid.Column="1"
                    Content="⟳  تحديث"
                    Style="{StaticResource RefreshButtonStyle}"
                    Click="RefreshButton_Click"/>

        </Grid>


        <!-- =====================================================
             KPI CARDS
             ===================================================== -->

        <Grid Grid.Row="1"
              Margin="0,0,0,20">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="16"/>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="16"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>


            <!-- Total Customers -->

            <Border Grid.Column="0"
                    Style="{StaticResource CardStyle}">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <Border Width="58"
                            Height="58"
                            CornerRadius="15"
                            Background="#EFF6FF"
                            VerticalAlignment="Center">

                        <TextBlock Text="👥"
                                   FontSize="25"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>


                    <StackPanel Grid.Column="1"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="إجمالي العملاء"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="13"/>

                        <TextBlock x:Name="TotalCustomersTextBlock"
                                   Text="0"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="27"
                                   FontWeight="Bold"
                                   Margin="0,3,0,0"/>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- Total Transactions -->

            <Border Grid.Column="2"
                    Style="{StaticResource CardStyle}">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <Border Width="58"
                            Height="58"
                            CornerRadius="15"
                            Background="#ECFDF5"
                            VerticalAlignment="Center">

                        <TextBlock Text="🧾"
                                   FontSize="25"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>


                    <StackPanel Grid.Column="1"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="إجمالي التعاملات"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="13"/>

                        <TextBlock x:Name="TotalInvoicesTextBlock"
                                   Text="0"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="27"
                                   FontWeight="Bold"
                                   Margin="0,3,0,0"/>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- Top Customer -->

            <Border Grid.Column="4"
                    Style="{StaticResource CardStyle}">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <Border Width="58"
                            Height="58"
                            CornerRadius="15"
                            Background="#FEFCE8"
                            VerticalAlignment="Center">

                        <TextBlock Text="🏆"
                                   FontSize="25"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>


                    <StackPanel Grid.Column="1"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="الأكثر تكرارًا"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="13"/>

                        <TextBlock x:Name="TopCustomerTextBlock"
                                   Text="لا يوجد"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,3,0,0"/>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>


        <!-- =====================================================
             FILTERS
             ===================================================== -->

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="14"
                Padding="14"
                Margin="0,0,0,16"
                Effect="{StaticResource CardShadow}">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="145"/>

                    <ColumnDefinition Width="18"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>


                <!-- Filter label -->

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0">

                    <TextBlock Text="عرض"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#475569"
                               VerticalAlignment="Center"/>

                </StackPanel>


                <!-- Top count -->

                <ComboBox x:Name="TopCountComboBox"
                          Grid.Column="1"
                          Style="{StaticResource ModernComboBoxStyle}"
                          SelectionChanged="TopCountComboBox_SelectionChanged">

                    <ComboBoxItem Content="أعلى 5" Tag="5"/>

                    <ComboBoxItem Content="أعلى 10" Tag="10"/>

                    <ComboBoxItem Content="أعلى 20" Tag="20"/>

                    <ComboBoxItem Content="أعلى 50" Tag="50"/>

                    <ComboBoxItem Content="كل العملاء" Tag="0"/>

                </ComboBox>


                <!-- Search -->

                <Grid Grid.Column="3"
                      Height="42">

                    <TextBox x:Name="SearchTextBox"
                             Style="{StaticResource SearchTextBoxStyle}"
                             TextChanged="SearchTextBox_TextChanged"
                             ToolTip="ابحث باسم العميل أو رقم الهاتف" Margin="0,0,640,0"/>


                    <TextBlock Text="🔍"
                               FontSize="15"
                               Foreground="#64748B"
                               IsHitTestVisible="False"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0"/>

                </Grid>

            </Grid>

        </Border>


        <!-- =====================================================
             TABLE
             ===================================================== -->

        <Border Grid.Row="3"
                Background="White"
                CornerRadius="16"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                Padding="8"
                ClipToBounds="True"
                Effect="{StaticResource CardShadow}">

            <DataGrid x:Name="CustomersDataGrid"
                      Style="{StaticResource ModernDataGridStyle}"
                      Margin="0">

                <DataGrid.Columns>


                    <!-- ===============================
                         Rank
                         =============================== -->

                    <DataGridTemplateColumn Header="#"
                                            Width="65">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <Border Style="{StaticResource NumberBadgeStyle}">

                                    <TextBlock Text="{Binding Rank}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="#475569"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"/>

                                </Border>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>


                    <!-- ===============================
                         Customer Name
                         =============================== -->

                    <DataGridTemplateColumn Header="اسم العميل"
                                            Width="2.2*">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <TextBlock Text="{Binding CustomerName}"
                                           Style="{StaticResource TableTextStyle}"
                                           FontWeight="SemiBold"
                                           Foreground="#0F172A"
                                           HorizontalAlignment="Center"
                                           MaxWidth="240"/>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>


                    <!-- ===============================
                         Phone
                         =============================== -->

                    <DataGridTemplateColumn Header="رقم الهاتف"
                                            Width="1.4*">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <TextBlock Text="{Binding CustomerPhone}"
                                           Style="{StaticResource TableTextStyle}"
                                           Foreground="#475569"/>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>


                    <!-- ===============================
                         Total Transactions
                         =============================== -->

                    <DataGridTemplateColumn Header="إجمالي التعاملات"
                                            Width="1.35*">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <Border Style="{StaticResource CountBadgeStyle}">

                                    <TextBlock Text="{Binding InvoiceCount}"
                                               FontWeight="Bold"
                                               Foreground="#2563EB"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"/>

                                </Border>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>


                    <!-- ===============================
                         Sales
                         =============================== -->

                    <DataGridTemplateColumn Header="مبيعات"
                                            Width="1*">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <Border Background="#ECFDF5"
                                        CornerRadius="8"
                                        MinWidth="42"
                                        Height="30"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                    <TextBlock Text="{Binding SalesInvoiceCount}"
                                               FontWeight="SemiBold"
                                               Foreground="#16A34A"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"/>

                                </Border>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>


                    <!-- ===============================
                         Maintenance
                         =============================== -->

                    <DataGridTemplateColumn Header="صيانة"
                                            Width="1*">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <Border Background="#FFF7ED"
                                        CornerRadius="8"
                                        MinWidth="42"
                                        Height="30"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                    <TextBlock Text="{Binding MaintenanceInvoiceCount}"
                                               FontWeight="SemiBold"
                                               Foreground="#EA580C"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"/>

                                </Border>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>


                    <!-- ===============================
                         Last Transaction
                         =============================== -->

                    <DataGridTemplateColumn Header="آخر تعامل"
                                            Width="1.6*">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <TextBlock Text="{Binding LastInvoiceDate, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                           Style="{StaticResource TableTextStyle}"
                                           Foreground="#475569"/>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>


                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</Window>