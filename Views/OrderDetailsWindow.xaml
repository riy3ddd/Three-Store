<Window x:Class="WpfApp1.Views.OrderDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تفاصيل الطلبية"
        Width="600"
        Height="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Background="#F5F7FB"
        FontFamily="Segoe UI">

    <Window.Resources>

        <Style x:Key="InfoLabel"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#64748B"/>

            <Setter Property="Margin"
                    Value="0,0,0,5"/>

        </Style>


        <Style x:Key="InfoValue"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#0F172A"/>

        </Style>

    </Window.Resources>


    <Grid Margin="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- Header -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,25">

            <TextBlock Text="تفاصيل الطلبية"
                       FontSize="25"
                       FontWeight="Bold"
                       Foreground="#0F172A"/>

            <TextBlock x:Name="OrderNumberText"
                       FontSize="13"
                       Foreground="#64748B"
                       Margin="0,6,0,0"/>

        </StackPanel>


        <!-- Details -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel>

                <!-- Customer -->
                <Border Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18"
                        Margin="0,0,0,12">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Margin="0,0,10,0">

                            <TextBlock Text="اسم العميل"
                                       Style="{StaticResource InfoLabel}"/>

                            <TextBlock x:Name="CustomerNameText"
                                       Style="{StaticResource InfoValue}"/>

                        </StackPanel>


                        <StackPanel Grid.Column="1"
                                    Margin="10,0,0,0">

                            <TextBlock Text="رقم الهاتف"
                                       Style="{StaticResource InfoLabel}"/>

                            <TextBlock x:Name="CustomerPhoneText"
                                       Style="{StaticResource InfoValue}"/>

                        </StackPanel>

                    </Grid>

                </Border>


                <!-- Product -->
                <Border Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18"
                        Margin="0,0,0,12">

                    <StackPanel>

                        <TextBlock Text="المنتج"
                                   Style="{StaticResource InfoLabel}"/>

                        <TextBlock x:Name="ProductNameText"
                                   Style="{StaticResource InfoValue}"/>

                        <TextBlock x:Name="ManualProductText"
                                   Text="منتج غير موجود بالمخزون"
                                   FontSize="11"
                                   Foreground="#F59E0B"
                                   Margin="0,5,0,0"
                                   Visibility="Collapsed"/>

                    </StackPanel>

                </Border>


                <!-- Quantity + Date -->
                <Border Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18"
                        Margin="0,0,0,12">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>


                        <StackPanel Grid.Column="0"
                                    Margin="0,0,10,0">

                            <TextBlock Text="الكمية"
                                       Style="{StaticResource InfoLabel}"/>

                            <TextBlock x:Name="QuantityText"
                                       Style="{StaticResource InfoValue}"/>

                        </StackPanel>


                        <StackPanel Grid.Column="1"
                                    Margin="10,0,0,0">

                            <TextBlock Text="تاريخ الطلب"
                                       Style="{StaticResource InfoLabel}"/>

                            <TextBlock x:Name="OrderDateText"
                                       Style="{StaticResource InfoValue}"/>

                        </StackPanel>

                    </Grid>

                </Border>


                <!-- Note -->
                <Border Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18"
                        Margin="0,0,0,12">

                    <StackPanel>

                        <TextBlock Text="الملاحظات"
                                   Style="{StaticResource InfoLabel}"/>

                        <TextBlock x:Name="NoteText"
                                   Style="{StaticResource InfoValue}"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>


                <!-- Status -->
                <Border Background="#EFF6FF"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18">

                    <StackPanel>

                        <TextBlock Text="الحالة الحالية"
                                   Style="{StaticResource InfoLabel}"/>

                        <TextBlock x:Name="StatusText"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="#2563EB"/>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>


        <!-- Close -->
        <Button Grid.Row="2"
                Content="إغلاق"
                Height="44"
                Margin="0,18,0,0"
                Background="#E2E8F0"
                Foreground="#334155"
                BorderThickness="0"
                FontSize="14"
                FontWeight="SemiBold"
                Cursor="Hand"
                Click="CloseButton_Click"/>

    </Grid>

</Window>