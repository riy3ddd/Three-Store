<Window x:Class="WpfApp1.Views.CategoriesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إدارة التصنيفات"
        Height="720"
        Width="1250"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        FontFamily="29 LT BUKRA REGULAR"
        Background="#F4F6F9">

    <Window.Resources>

        <!-- ===================================================== -->
        <!-- ستايل عصري للأزرار -->
        <!-- ===================================================== -->

        <Style TargetType="Button"
               x:Key="ModernButtonStyle">

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ===================================================== -->
        <!-- ستايل مخصص للـ TextBox -->
        <!-- ===================================================== -->

        <Style TargetType="TextBox">

            <Setter Property="BorderBrush"
                    Value="#CBD5E1"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">

                            <ScrollViewer x:Name="PART_ContentHost"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ===================================================== -->
        <!-- ستايل قيم أعمدة التصنيفات -->
        <!-- ===================================================== -->

        <Style x:Key="CategoryCellTextStyle"
               TargetType="TextBlock">

            <Setter Property="HorizontalAlignment"
                    Value="Center"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="TextAlignment"
                    Value="Center"/>

            <Setter Property="TextWrapping"
                    Value="NoWrap"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="Foreground"
                    Value="#1E293B"/>

        </Style>


        <!-- ===================================================== -->
        <!-- ستايل عناوين الأعمدة -->
        <!-- ===================================================== -->

        <Style TargetType="DataGridColumnHeader">

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="Foreground"
                    Value="#334155"/>

            <Setter Property="Background"
                    Value="#F8FAFC"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="5,0"/>

        </Style>


        <!-- ===================================================== -->
        <!-- ستايل خلايا الجدول -->
        <!-- ===================================================== -->

        <Style TargetType="DataGridCell">

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="5,0"/>

        </Style>

    </Window.Resources>


    <Grid Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- 1. عنوان الصفحة -->
        <!-- ===================================================== -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,15">

            <TextBlock Text="🏷️ إدارة التصنيفات"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#1E293B"/>

            <TextBlock Text="أدر تصنيفات منتجات المتجر واعرض عدد المنتجات بكل تصنيف"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#64748B"
                       Margin="0,4,0,0"/>

        </StackPanel>


        <!-- ===================================================== -->
        <!-- 2. البحث + الإضافة -->
        <!-- ===================================================== -->

        <Grid Grid.Row="1"
              Margin="0,0,0,15">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>


            <!-- ================================================= -->
            <!-- صندوق البحث -->
            <!-- ================================================= -->

            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="12"
                    Padding="4"
                    Margin="0,0,16,0">

                <Border.Effect>

                    <DropShadowEffect Color="#CBD5E1"
                                      BlurRadius="10"
                                      ShadowDepth="2"
                                      Direction="270"/>

                </Border.Effect>


                <TextBox x:Name="SearchTextBox"
                         Height="42"
                         FontSize="18"
                         Padding="2"
                         FontWeight="Bold"
                         VerticalContentAlignment="Center"
                         Text="🔍 ابحث عن تصنيف..."
                         Foreground="#DC2626"
                         BorderThickness="0"
                         Background="Transparent"
                         TextChanged="SearchTextBox_TextChanged"
                         GotFocus="SearchTextBox_GotFocus"
                         LostFocus="SearchTextBox_LostFocus"/>

            </Border>


            <!-- ================================================= -->
            <!-- زر الإضافة -->
            <!-- ================================================= -->

            <Button Grid.Column="1"
                    Content="+ إضافة تصنيف جديد"
                    Width="170"
                    Height="50"
                    FontWeight="Bold"
                    Background="#2563EB"
                    Foreground="White"
                    Style="{StaticResource ModernButtonStyle}"
                    Click="AddCategoryButton_Click">

                <Button.Effect>

                    <DropShadowEffect Color="#CBD5E1"
                                      BlurRadius="8"
                                      ShadowDepth="2"
                                      Direction="270"/>

                </Button.Effect>

            </Button>

        </Grid>


        <!-- ===================================================== -->
        <!-- 3. جدول التصنيفات -->
        <!-- ===================================================== -->

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="12"
                Padding="15">

            <Border.Effect>

                <DropShadowEffect Color="#CBD5E1"
                                  BlurRadius="10"
                                  ShadowDepth="2"
                                  Direction="270"/>

            </Border.Effect>


            <DataGrid x:Name="CategoriesDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      Background="Transparent"
                      BorderBrush="#F1F5F9"
                      RowHeight="50"
                      FontSize="15"
                      FontWeight="Bold"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      CanUserReorderColumns="False">


                <DataGrid.Columns>


                    <!-- ================================================= -->
                    <!-- الرقم -->
                    <!-- ================================================= -->

                    <DataGridTemplateColumn Header="الرقم"
                                            Width="80">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <TextBlock Text="{Binding DisplayNumber}"
                                           Style="{StaticResource CategoryCellTextStyle}"
                                           Foreground="#475569"/>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>


                    <!-- ================================================= -->
                    <!-- اسم التصنيف -->
                    <!-- ================================================= -->

                    <DataGridTextColumn Header="اسم التصنيف"
                                        Binding="{Binding CategoryName}"
                                        Width="*">

                        <DataGridTextColumn.ElementStyle>

                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource CategoryCellTextStyle}"/>

                        </DataGridTextColumn.ElementStyle>

                    </DataGridTextColumn>


                    <!-- ================================================= -->
                    <!-- عدد المنتجات -->
                    <!-- ================================================= -->

                    <DataGridTemplateColumn Header="عدد المنتجات"
                                            Width="160">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <Border Background="#F1F5F9"
                                        CornerRadius="6"
                                        Padding="10,4"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                    <TextBlock Text="{Binding ProductCount}"
                                               Style="{StaticResource CategoryCellTextStyle}"
                                               Foreground="#334155"/>

                                </Border>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>


                    <!-- ================================================= -->
                    <!-- الإجراءات -->
                    <!-- ================================================= -->

                    <DataGridTemplateColumn Header="الإجراءات"
                                            Width="180">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">


                                    <!-- تعديل -->

                                    <Button Content="تعديل"
                                            Width="65"
                                            Height="32"
                                            Background="#FEF3C7"
                                            Foreground="#D97706"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            BorderThickness="0"
                                            Margin="0,0,8,0"
                                            Style="{StaticResource ModernButtonStyle}"
                                            Click="EditCategoryButton_Click"/>


                                    <!-- حذف -->

                                    <Button Content="حذف"
                                            Width="65"
                                            Height="32"
                                            Background="#FEE2E2"
                                            Foreground="#DC2626"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            BorderThickness="0"
                                            Style="{StaticResource ModernButtonStyle}"
                                            Click="DeleteCategoryButton_Click"/>

                                </StackPanel>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>


                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</Window>