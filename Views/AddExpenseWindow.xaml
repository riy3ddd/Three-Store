<Window x:Class="WpfApp1.Views.AddExpenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إضافة مصروف"
        Height="720"
        Width="720"
        MinHeight="650"
        MinWidth="650"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="#F8FAFC"
        ResizeMode="NoResize">

    <Window.Resources>

        <!-- ================= SHADOW ================= -->

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="22"
                          ShadowDepth="4"
                          Opacity="0.10"
                          Direction="270"/>


        <!-- ================= LABEL STYLE ================= -->

        <Style x:Key="LabelStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#475569"/>

            <Setter Property="Margin"
                    Value="0,0,0,7"/>

        </Style>


        <!-- ================= INPUT STYLE ================= -->

        <Style x:Key="InputStyle"
               TargetType="Control">

            <Setter Property="Height"
                    Value="44"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Padding"
                    Value="12"/>

            <Setter Property="Margin"
                    Value="0,0,0,18"/>

        </Style>


        <!-- ================= BUTTON STYLE ================= -->

        <Style x:Key="ActionButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="48"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Padding"
                    Value="20,0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <Grid Margin="32">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>


        <!-- ================= HEADER ================= -->

        <Grid Grid.Row="0"
              Margin="0,0,0,25">

            <StackPanel>

                <TextBlock Text="إضافة مصروف جديد"
                           FontSize="29"
                           FontWeight="Bold"
                           Foreground="#0F172A"/>

                <TextBlock Text="تسجيل عملية صرف جديدة للمحل"
                           FontSize="14"
                           Foreground="#64748B"
                           Margin="0,7,0,0"/>

            </StackPanel>

        </Grid>


        <!-- ================= FORM CARD ================= -->

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="18"
                Padding="28"
                Effect="{StaticResource CardShadow}">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel>


                    <!-- CARD TITLE -->

                    <StackPanel Margin="0,0,0,22">

                        <TextBlock Text="بيانات المصروف"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="#1E293B"/>

                        <TextBlock Text="أدخل بيانات المصروف بشكل صحيح قبل الحفظ"
                                   FontSize="12"
                                   Foreground="#94A3B8"
                                   Margin="0,5,0,0"/>

                    </StackPanel>


                    <!-- DIVIDER -->

                    <Border Height="1"
                            Background="#E2E8F0"
                            Margin="0,0,0,22"/>


                    <!-- ================= CATEGORY ================= -->

                    <TextBlock Text="نوع المصروف"
                               Style="{StaticResource LabelStyle}"/>

                    <Border Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="9"
                            Margin="0,0,0,18">

                        <ComboBox x:Name="CategoryComboBox"
                                  Height="44"
                                  FontSize="14"
                                  Padding="10"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  DisplayMemberPath="CategoryName"
                                  SelectedValuePath="ExpenseCategoryID"/>

                    </Border>


                    <!-- ================= DESCRIPTION ================= -->

                    <TextBlock Text="البيان"
                               Style="{StaticResource LabelStyle}"/>

                    <Border Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="9"
                            Margin="0,0,0,18">

                        <TextBox x:Name="DescriptionTextBox"
                                 Height="44"
                                 FontSize="14"
                                 Padding="12"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ToolTip="مثال: فاتورة كهرباء المحل"/>

                    </Border>


                    <!-- ================= AMOUNT ================= -->

                    <TextBlock Text="المبلغ"
                               Style="{StaticResource LabelStyle}"/>

                    <Border Background="#F0FDF4"
                            BorderBrush="#BBF7D0"
                            BorderThickness="1"
                            CornerRadius="9"
                            Margin="0,0,0,18">

                        <TextBox x:Name="AmountTextBox"
                                 Height="48"
                                 FontSize="18"
                                 FontWeight="SemiBold"
                                 Padding="12"
                                 Foreground="#15803D"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ToolTip="أدخل قيمة المصروف"/>

                    </Border>


                    <!-- ================= DATE ================= -->

                    <TextBlock Text="تاريخ المصروف"
                               Style="{StaticResource LabelStyle}"/>

                    <Border Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="9"
                            Margin="0,0,0,18">

                        <DatePicker x:Name="ExpenseDatePicker"
                                    Height="44"
                                    FontSize="14"
                                    Padding="8"
                                    BorderThickness="0"
                                    Background="Transparent"/>

                    </Border>


                    <!-- ================= NOTES ================= -->

                    <TextBlock Text="ملاحظات"
                               Style="{StaticResource LabelStyle}"/>

                    <Border Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="9">

                        <TextBox x:Name="NotesTextBox"
                                 Height="90"
                                 FontSize="14"
                                 Padding="12"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"/>

                    </Border>

                </StackPanel>

            </ScrollViewer>

        </Border>


        <!-- ================= BUTTONS ================= -->

        <Grid Grid.Row="2"
              Margin="0,22,0,0">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="14"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>


            <!-- SAVE -->

            <Button Grid.Column="0"
                    Content="حفظ المصروف"
                    Background="#16A34A"
                    Foreground="White"
                    Style="{StaticResource ActionButton}"
                    Click="SaveButton_Click"/>


            <!-- CANCEL -->

            <Button Grid.Column="2"
                    Content="إلغاء"
                    Background="#E2E8F0"
                    Foreground="#334155"
                    Style="{StaticResource ActionButton}"
                    Click="CancelButton_Click"/>

        </Grid>

    </Grid>

</Window>