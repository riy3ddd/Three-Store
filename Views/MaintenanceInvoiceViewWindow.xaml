<Window x:Class="WpfApp1.MaintenanceInvoiceViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="فاتورة الصيانة"
        Width="800"
        Height="850"
        MinWidth="700"
        MinHeight="750"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="#F4F7FB">

    <Window.Resources>

        <!-- Label -->
        <Style x:Key="FieldLabelStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Value -->
        <Style x:Key="FieldValueStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#172033"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Information Box -->
        <Style x:Key="InfoBoxStyle"
               TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Section Header -->
        <Style x:Key="SectionHeaderStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Buttons -->
        <Style x:Key="ActionButtonStyle"
               TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Window.Resources>


    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- ================= HEADER ================= -->

        <Border Grid.Row="0"
                Background="#0F172A"
                CornerRadius="12"
                Padding="20"
                Margin="0,0,0,12">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <!-- Store Information -->

                <StackPanel Grid.Column="0">

                    <TextBlock Text="THREE STORE"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="Bold"/>

                    <TextBlock Text="فاتورة صيانة"
                               Foreground="#CBD5E1"
                               FontSize="13"
                               Margin="0,3,0,0"/>

                    <TextBlock Text="خدمة وصيانة الأجهزة"
                               Foreground="#94A3B8"
                               FontSize="11"
                               Margin="0,2,0,0"/>

                </StackPanel>


                <!-- Invoice Information -->

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">

                    <TextBlock Text="رقم الفاتورة"
                               Foreground="#94A3B8"
                               FontSize="11"
                               HorizontalAlignment="Left"/>

                    <TextBlock x:Name="InvoiceNumberText"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,3,0,0"
                               HorizontalAlignment="Left"/>

                    <TextBlock Text="الموظف"
                               Foreground="#94A3B8"
                               FontSize="11"
                               Margin="0,7,0,0"
                               HorizontalAlignment="Left"/>

                    <TextBlock x:Name="UsernameText"
                               Foreground="White"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="0,2,0,0"
                               HorizontalAlignment="Left"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ================= INVOICE CONTENT ================= -->

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel>


                <!-- ================= CUSTOMER ================= -->

                <Border Style="{StaticResource InfoBoxStyle}">

                    <StackPanel>

                        <TextBlock Text="بيانات العميل"
                                   Style="{StaticResource SectionHeaderStyle}"/>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="25"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>


                            <!-- Customer Name -->

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="اسم العميل"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBlock x:Name="CustomerNameText"
                                           Style="{StaticResource FieldValueStyle}"/>

                            </StackPanel>


                            <!-- Customer Phone -->

                            <StackPanel Grid.Column="2">

                                <TextBlock Text="رقم التليفون"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBlock x:Name="CustomerPhoneText"
                                           Style="{StaticResource FieldValueStyle}"/>

                            </StackPanel>

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- ================= DEVICE ================= -->

                <Border Style="{StaticResource InfoBoxStyle}">

                    <StackPanel>

                        <TextBlock Text="بيانات الجهاز"
                                   Style="{StaticResource SectionHeaderStyle}"/>

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="25"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>


                            <!-- Device Name -->

                            <StackPanel Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0,0,0,12">

                                <TextBlock Text="اسم الجهاز"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBlock x:Name="DeviceNameText"
                                           Style="{StaticResource FieldValueStyle}"/>

                            </StackPanel>


                            <!-- Serial Number -->

                            <StackPanel Grid.Row="0"
                                        Grid.Column="2"
                                        Margin="0,0,0,12">

                                <TextBlock Text="الرقم التسلسلي"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBlock x:Name="SerialNumberText"
                                           Style="{StaticResource FieldValueStyle}"/>

                            </StackPanel>


                            <!-- Device Condition -->

                            <StackPanel Grid.Row="1"
                                        Grid.Column="0">

                                <TextBlock Text="حالة الجهاز عند الاستلام"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBlock x:Name="DeviceConditionText"
                                           Style="{StaticResource FieldValueStyle}"/>

                            </StackPanel>


                            <!-- Hidden Color Field -->
                            <!-- موجود فقط للحفاظ على توافق الـ Code-Behind -->

                            <TextBlock x:Name="DeviceColorText"
                                       Visibility="Collapsed"/>

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- ================= MAINTENANCE DETAILS ================= -->

                <Border Style="{StaticResource InfoBoxStyle}">

                    <StackPanel>

                        <TextBlock Text="تفاصيل الصيانة"
                                   Style="{StaticResource SectionHeaderStyle}"/>


                        <!-- Type + Status -->

                        <Grid Margin="0,0,0,12">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="25"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>


                            <!-- Maintenance Type -->

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="نوع الصيانة"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBlock x:Name="MaintenanceTypeText"
                                           Style="{StaticResource FieldValueStyle}"/>

                            </StackPanel>


                            <!-- Status -->

                            <StackPanel Grid.Column="2">

                                <TextBlock Text="حالة الصيانة"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <Border Background="#E0F2FE"
                                        CornerRadius="6"
                                        Padding="10,5"
                                        HorizontalAlignment="Right">

                                    <TextBlock x:Name="StatusText"
                                               Foreground="#0369A1"
                                               FontSize="13"
                                               FontWeight="Bold"/>

                                </Border>

                            </StackPanel>

                        </Grid>


                        <!-- Problem -->

                        <StackPanel Margin="0,0,0,12">

                            <TextBlock Text="الأعطال / المشكلة"
                                       Style="{StaticResource FieldLabelStyle}"/>

                            <TextBlock x:Name="ProblemText"
                                       Style="{StaticResource FieldValueStyle}"
                                       TextWrapping="Wrap"/>

                        </StackPanel>


                        <!-- Accessories -->

                        <StackPanel Margin="0,0,0,12">

                            <TextBlock Text="ملحقات الجهاز"
                                       Style="{StaticResource FieldLabelStyle}"/>

                            <TextBlock x:Name="AccessoriesText"
                                       Style="{StaticResource FieldValueStyle}"
                                       TextWrapping="Wrap"/>

                        </StackPanel>


                        <!-- Notes -->

                        <StackPanel Margin="0,0,0,12">

                            <TextBlock Text="الملاحظات"
                                       Style="{StaticResource FieldLabelStyle}"/>

                            <TextBlock x:Name="NotesText"
                                       Style="{StaticResource FieldValueStyle}"
                                       TextWrapping="Wrap"/>

                        </StackPanel>


                        <!-- ================= SPARE PARTS DETAILS ================= -->

                        <StackPanel>
                            <StackPanel Margin="0,10,0,0">

                                <TextBlock Text="تفاصيل قطع الغيار"
               Style="{StaticResource FieldLabelStyle}"/>

                                <Border
        Background="#F8FAFC"
        BorderBrush="#E2E8F0"
        BorderThickness="1"
        CornerRadius="10"
        Padding="12"
        Margin="0,6,0,0">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">

                                            <TextBlock
                    Text="قطعة الغيار"
                    Style="{StaticResource FieldLabelStyle}"/>

                                            <TextBlock
                    x:Name="SparePartsNameText"
                    Text="-"
                    Style="{StaticResource FieldValueStyle}"
                    Margin="0,3,0,0"/>

                                        </StackPanel>

                                        <StackPanel Grid.Column="2">

                                            <TextBlock
                    Text="سعر قطعة الغيار"
                    Style="{StaticResource FieldLabelStyle}"/>

                                            <TextBlock
                    x:Name="SparePartsCostText"
                    Text="0.00 ج.م"
                    Style="{StaticResource FieldValueStyle}"
                    Margin="0,3,0,0"/>

                                        </StackPanel>

                                    </Grid>

                                </Border>

                            </StackPanel>
                        </StackPanel>

                    </StackPanel>

                </Border>


                <!-- ================= SUMMARY ================= -->

                <Border Background="#F8FAFC"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="15"
                        Margin="0,0,0,5">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>


                        <!-- Price -->

                        <StackPanel Grid.Column="0">

                            <TextBlock Text="السعر"
                                       Style="{StaticResource FieldLabelStyle}"/>

                            <TextBlock x:Name="PriceText"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"/>

                        </StackPanel>


                        <!-- Receive Date -->

                        <StackPanel Grid.Column="1">

                            <TextBlock Text="تاريخ الاستلام"
                                       Style="{StaticResource FieldLabelStyle}"/>

                            <TextBlock x:Name="ReceiveDateText"
                                       Style="{StaticResource FieldValueStyle}"/>

                        </StackPanel>


                        <!-- Delivery Date -->

                        <StackPanel Grid.Column="2">

                            <TextBlock Text="موعد التسليم"
                                       Style="{StaticResource FieldLabelStyle}"/>

                            <TextBlock x:Name="DeliveryDateText"
                                       Style="{StaticResource FieldValueStyle}"/>

                        </StackPanel>

                    </Grid>

                </Border>


            </StackPanel>

        </ScrollViewer>


        <!-- ================= FOOTER ================= -->

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    Margin="0,12,0,0">


            <!-- Print -->

            <Button Content="🖨  طباعة"
                    Width="120"
                    Style="{StaticResource ActionButtonStyle}"
                    Background="#0F172A"
                    Foreground="White"
                    Click="PrintButton_Click"/>


            <!-- Close -->

            <Button Content="إغلاق"
                    Width="100"
                    Margin="10,0,0,0"
                    Style="{StaticResource ActionButtonStyle}"
                    Background="#E2E8F0"
                    Foreground="#0F172A"
                    Click="CloseButton_Click"/>

        </StackPanel>

    </Grid>

</Window>