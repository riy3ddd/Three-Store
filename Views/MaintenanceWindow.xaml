<Window x:Class="WpfApp1.MaintenanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="نظام الصيانة الاحترافي"
        Height="800"
        Width="1300"
        MinHeight="720"
        MinWidth="1100"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="#F6F8FB">

    <Window.Resources>

        <!-- ========================================================= -->
        <!-- TEXTBOX -->
        <!-- ========================================================= -->

        <Style x:Key="ExclusiveTextBox"
               TargetType="TextBox">

            <Setter Property="Height" Value="45"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,6,0,14"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#172033"/>

            <Setter Property="BorderBrush" Value="#DCE3EC"/>
            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="CaretBrush" Value="#2563EB"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="0"
                                          VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsFocused"
                                     Value="True">

                                <Setter TargetName="border"
                                        Property="BorderBrush"
                                        Value="#2563EB"/>

                                <Setter TargetName="border"
                                        Property="BorderThickness"
                                        Value="1.5"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ========================================================= -->
        <!-- COMBO BOX -->
        <!-- ========================================================= -->

        <Style x:Key="ExclusiveComboBox"
               TargetType="ComboBox">

            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="0,6,0,14"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>

            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#172033"/>

            <Setter Property="BorderBrush" Value="#DCE3EC"/>
            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="Padding" Value="10,0"/>

        </Style>


        <!-- ========================================================= -->
        <!-- LABEL -->
        <!-- ========================================================= -->

        <Style x:Key="ExclusiveLabel"
               TargetType="TextBlock">

            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>

            <Setter Property="Foreground" Value="#475569"/>

            <Setter Property="Margin" Value="0,0,0,4"/>

        </Style>


        <!-- ========================================================= -->
        <!-- PRIMARY BUTTON -->
        <!-- ========================================================= -->

        <Style x:Key="PrimaryActionBtn"
               TargetType="Button">

            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="28,0"/>

            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>

            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2563EB"/>

            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1D4ED8"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1E40AF"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ========================================================= -->
        <!-- SECONDARY BUTTON -->
        <!-- ========================================================= -->

        <Style x:Key="SecondaryActionBtn"
               TargetType="Button">

            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>

            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Background" Value="#FFFFFF"/>

            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#DCE3EC"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#F8FAFC"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#CBD5E1"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ========================================================= -->
        <!-- CARD STYLE -->
        <!-- ========================================================= -->

        <Style x:Key="ModernCard"
               TargetType="Border">

            <Setter Property="Background"
                    Value="#FFFFFF"/>

            <Setter Property="BorderBrush"
                    Value="#E2E8F0"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="14"/>

        </Style>


        <!-- ========================================================= -->
        <!-- DATAGRID -->
        <!-- ========================================================= -->

        <Style x:Key="ModernDataGrid"
               TargetType="DataGrid">

            <Setter Property="Background"
                    Value="#FFFFFF"/>

            <Setter Property="Foreground"
                    Value="#172033"/>

            <Setter Property="BorderBrush"
                    Value="#E2E8F0"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="GridLinesVisibility"
                    Value="Horizontal"/>

            <Setter Property="HorizontalGridLinesBrush"
                    Value="#E8EDF3"/>

            <Setter Property="VerticalGridLinesBrush"
                    Value="#F1F5F9"/>

            <Setter Property="RowHeight"
                    Value="48"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontFamily"
                    Value="Segoe UI"/>

            <Setter Property="HeadersVisibility"
                    Value="Column"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>


        <!-- ========================================================= -->
        <!-- DATAGRID HEADER -->
        <!-- ========================================================= -->

        <Style x:Key="CenteredDataGridHeader"
               TargetType="DataGridColumnHeader">

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Foreground"
                    Value="#334155"/>

            <Setter Property="Background"
                    Value="#F8FAFC"/>

            <Setter Property="BorderBrush"
                    Value="#E2E8F0"/>

            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>

            <Setter Property="Padding"
                    Value="8,0"/>

            <Setter Property="Height"
                    Value="48"/>

        </Style>


        <!-- ========================================================= -->
        <!-- DATAGRID CELL -->
        <!-- ========================================================= -->

        <Style x:Key="CenteredDataGridCell"
               TargetType="DataGridCell">

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Foreground"
                    Value="#172033"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Padding"
                    Value="8,0"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#F8FAFC"/>

                    <Setter Property="Foreground"
                            Value="#172033"/>

                </Trigger>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="#E8F1FF"/>

                    <Setter Property="Foreground"
                            Value="#172033"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ========================================================= -->
        <!-- TEXT STYLE -->
        <!-- ========================================================= -->

        <Style x:Key="CenteredTextStyle"
               TargetType="TextBlock">

            <Setter Property="HorizontalAlignment"
                    Value="Center"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="TextAlignment"
                    Value="Center"/>

            <Setter Property="TextWrapping"
                    Value="NoWrap"/>

            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis"/>

        </Style>


        <!-- ========================================================= -->
        <!-- DATAGRID ROW -->
        <!-- ========================================================= -->

        <Style x:Key="ModernDataGridRow"
               TargetType="DataGridRow">

            <Setter Property="Background"
                    Value="#FFFFFF"/>

            <Setter Property="Foreground"
                    Value="#172033"/>

            <Setter Property="BorderBrush"
                    Value="#F1F5F9"/>

            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#F8FAFC"/>

                    <Setter Property="Foreground"
                            Value="#172033"/>

                </Trigger>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="#E8F1FF"/>

                    <Setter Property="Foreground"
                            Value="#172033"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ========================================================= -->
        <!-- SMALL TABLE ACTION BUTTON -->
        <!-- ========================================================= -->

        <Style x:Key="TableActionButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="32"/>

            <Setter Property="MinWidth"
                    Value="34"/>

            <Setter Property="Padding"
                    Value="8,0"/>

            <Setter Property="Margin"
                    Value="3,0"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>


        <!-- ========================================================= -->
        <!-- TAB CONTROL -->
        <!-- ========================================================= -->

        <Style TargetType="TabControl">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TabControl">

                        <Grid KeyboardNavigation.TabNavigation="Local">

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>

                            </Grid.RowDefinitions>

                            <TabPanel x:Name="HeaderPanel"
                                      Grid.Row="0"
                                      IsItemsHost="True"
                                      Margin="0,0,0,12"
                                      Panel.ZIndex="1"/>

                            <Border x:Name="ContentPanel"
                                    Grid.Row="1"
                                    Background="Transparent"
                                    BorderThickness="0">

                                <ContentPresenter
                                    x:Name="PART_SelectedContentHost"
                                    ContentSource="SelectedContent"/>

                            </Border>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ========================================================= -->
        <!-- TAB ITEM -->
        <!-- ========================================================= -->

        <Style TargetType="TabItem">

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="FontFamily"
                    Value="Segoe UI"/>

            <Setter Property="Foreground"
                    Value="#64748B"/>

            <Setter Property="Background"
                    Value="#EEF2F7"/>

            <Setter Property="Padding"
                    Value="24,13"/>

            <Setter Property="Margin"
                    Value="0,0,8,0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TabItem">

                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                x:Name="ContentSite"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                ContentSource="Header"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsSelected"
                                     Value="True">

                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#FFFFFF"/>

                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="#BFDBFE"/>

                                <Setter Property="Foreground"
                                        Value="#2563EB"/>

                                <Setter Property="FontWeight"
                                        Value="Bold"/>

                            </Trigger>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#FFFFFF"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <!-- ============================================================= -->
    <!-- MAIN WINDOW -->
    <!-- ============================================================= -->

    <Grid Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- ========================================================= -->
        <!-- TOP HEADER -->
        <!-- ========================================================= -->

        <Border Grid.Row="0"
                Background="#FFFFFF"
                CornerRadius="16"
                Padding="22"
                Margin="0,0,0,16"
                BorderBrush="#E2E8F0"
                BorderThickness="1">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <StackPanel>

                    <TextBlock Text="⚡ لوحة إدارة الصيانة المركزية"
                               Foreground="#172033"
                               FontSize="22"
                               FontWeight="Bold"
                               FontFamily="Segoe UI"/>

                    <TextBlock Text="تحكم كامل في فواتير الأجهزة وتتبع حالات الصيانة الفورية"
                               Foreground="#64748B"
                               FontSize="12"
                               Margin="0,5,0,0"/>

                </StackPanel>


                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">

                    <!-- MAINTENANCE REVENUE -->

                    <Border Background="#EFF6FF"
                            CornerRadius="10"
                            Padding="18,9"
                            Margin="0,0,10,0"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1">

                        <StackPanel>

                            <TextBlock Text="إجمالي إيرادات الصيانة"
                                       Foreground="#2563EB"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>

                            <TextBlock x:Name="MaintenanceRevenueText"
                                       Text="0.00 جنيه"
                                       Foreground="#172033"
                                       FontWeight="Bold"
                                       FontSize="15"
                                       HorizontalAlignment="Center"
                                       Margin="0,2,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- CURRENT USER -->

                    <Border Background="#F8FAFC"
                            CornerRadius="10"
                            Padding="18,9"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1">

                        <StackPanel>

                            <TextBlock Text="المستخدم النشط"
                                       Foreground="Green"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>

                            <TextBlock x:Name="CurrentUserText"
                                       Text="Admin"
                                       Foreground="#172033"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       Margin="0,2,0,0"/>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ========================================================= -->
        <!-- MAIN TABS -->
        <!-- ========================================================= -->

        <TabControl Grid.Row="1"
                    x:Name="MaintenanceTabs"
                    BorderThickness="0"
                    Background="Transparent">


            <!-- ===================================================== -->
            <!-- TAB 1 : NEW MAINTENANCE INVOICE -->
            <!-- ===================================================== -->

            <TabItem Header="➕ إصدار فاتورة صيانة">

                <Grid Margin="5,10,5,5">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>


                    <ScrollViewer Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <!-- CUSTOMER -->

                            <Border Grid.Column="0"
                                    Style="{StaticResource ModernCard}"
                                    Padding="20">

                                <StackPanel>

                                    <TextBlock Text="بيانات العميل الأساسية"
                                               FontSize="21"
                                               FontWeight="Bold"
                                               Foreground="#172033"
                                               Margin="0,0,0,17"/>

                                    <TextBlock Text="اسم العميل الكامل"
                                               Style="{StaticResource ExclusiveLabel}"/>

                                    <TextBox x:Name="CustomerNameTextBox"
                                             Style="{StaticResource ExclusiveTextBox}"/>


                                    <TextBlock Text="رقم الهاتف الأساسي"
                                               Style="{StaticResource ExclusiveLabel}"/>

                                    <TextBox x:Name="CustomerPhoneTextBox"
                                             Style="{StaticResource ExclusiveTextBox}"/>


                                    <TextBlock Text="ملاحظات العميل"
                                               Style="{StaticResource ExclusiveLabel}"/>

                                    <TextBox x:Name="NotesTextBox"
                                             Style="{StaticResource ExclusiveTextBox}"
                                             Height="90"
                                             TextWrapping="Wrap"
                                             VerticalContentAlignment="Top"
                                             Padding="12,10"/>

                                </StackPanel>

                            </Border>


                            <!-- DEVICE -->

                            <Border Grid.Column="2"
                                    Style="{StaticResource ModernCard}"
                                    Padding="20">

                                <StackPanel>

                                    <TextBlock Text="مواصفات الجهاز"
                                               FontSize="21"
                                               FontWeight="Bold"
                                               Foreground="#172033"
                                               Margin="0,0,0,17"/>


                                    <TextBlock Text="نوع / اسم الجهاز"
                                               Style="{StaticResource ExclusiveLabel}"/>

                                    <TextBox x:Name="DeviceNameTextBox"
                                             Style="{StaticResource ExclusiveTextBox}"/>


                                    <TextBlock Text="الرقم التسلسلي (Serial No)"
                                               Style="{StaticResource ExclusiveLabel}"/>

                                    <TextBox x:Name="SerialNumberTextBox"
                                             Style="{StaticResource ExclusiveTextBox}"/>


                                    <TextBlock Text="لون الجهاز"
                                               Style="{StaticResource ExclusiveLabel}"/>

                                    <TextBox x:Name="DeviceColorTextBox"
                                             Style="{StaticResource ExclusiveTextBox}"/>


                                    <TextBlock Text="ملحقات الجهاز (شاحن، شنطة...)"
                                               Style="{StaticResource ExclusiveLabel}"/>

                                    <TextBox x:Name="AccessoriesTextBox"
                                             Style="{StaticResource ExclusiveTextBox}"
                                             Height="45"
                                             TextWrapping="Wrap"/>

                                </StackPanel>

                            </Border>


                            <!-- MAINTENANCE -->

                            <Border Grid.Column="4"
                                    Style="{StaticResource ModernCard}"
                                    Padding="20">

                                <StackPanel>

                                    <TextBlock Text="حالة الصيانة والتكلفة"
                                               FontSize="21"
                                               FontWeight="Bold"
                                               Foreground="#172033"
                                               Margin="0,0,0,17"/>


                                    <TextBlock Text="نوع الإصلاح"
                                               Style="{StaticResource ExclusiveLabel}"/>

                                    <ComboBox x:Name="MaintenanceTypeComboBox"
                                              Style="{StaticResource ExclusiveComboBox}">

                                        <ComboBoxItem Content="برمجة"/>
                                        <ComboBoxItem Content="هاردوير"/>
                                        <ComboBoxItem Content="شامل"/>

                                    </ComboBox>


                                    <TextBlock Text="العطل / المشكلة الظاهرة"
                                               Style="{StaticResource ExclusiveLabel}"/>

                                    <TextBox x:Name="ProblemDescriptionTextBox"
                                             Style="{StaticResource ExclusiveTextBox}"
                                             Height="45"
                                             TextWrapping="Wrap"/>


                                    <!-- ================================================= -->
                                    <!-- MAINTENANCE COST -->
                                    <!-- ================================================= -->

                                    <TextBlock Text="التكلفة التقديرية"
                                               Style="{StaticResource ExclusiveLabel}"/>

                                    <TextBox x:Name="MaintenanceCostTextBox"
                                             Style="{StaticResource ExclusiveTextBox}"
                                             Text="0"
                                             TextChanged="MaintenanceCostTextBox_TextChanged"/>


                                    <!-- ================================================= -->
                                    <!-- OPTIONAL SPARE PART -->
                                    <!-- ================================================= -->

                                    <Border Background="#F8FAFC"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="12"
                                            Margin="0,0,0,12">

                                        <StackPanel>
                                            <CheckBox x:Name="AddSparePartCheckBox"
          Content="إضافة قطعة غيار (اختياري)"
          IsChecked="False"
          Checked="AddSparePartCheckBox_Checked"
          Unchecked="AddSparePartCheckBox_Unchecked"
          FontSize="14"
          FontWeight="SemiBold"
          Foreground="#172033">

                                                <CheckBox.Template>
                                                    <ControlTemplate TargetType="CheckBox">

                                                        <StackPanel Orientation="Horizontal">

                                                            <!-- الدائرة -->
                                                            <Border Width="18"
                        Height="18"
                        CornerRadius="9"
                        BorderBrush="#64748B"
                        BorderThickness="1.5"
                        Background="White"
                        VerticalAlignment="Center">

                                                                <Ellipse x:Name="CheckDot"
                             Width="8"
                             Height="8"
                             Fill="Black"
                             Visibility="Collapsed"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                                                            </Border>

                                                            <!-- جملة إضافة قطعة غيار -->
                                                            <ContentPresenter
                    Content="{TemplateBinding Content}"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"/>

                                                        </StackPanel>

                                                        <ControlTemplate.Triggers>

                                                            <!-- عند الاختيار تظهر النقطة السوداء -->
                                                            <Trigger Property="IsChecked"
                         Value="True">

                                                                <Setter TargetName="CheckDot"
                            Property="Visibility"
                            Value="Visible"/>

                                                            </Trigger>

                                                        </ControlTemplate.Triggers>

                                                    </ControlTemplate>
                                                </CheckBox.Template>

                                            </CheckBox>

                                            <!-- SPARE PART FIELDS -->

                                            <StackPanel x:Name="SparePartPanel"
                                                        Visibility="Collapsed"
                                                        Margin="0,12,0,0">

                                                <TextBlock Text="اسم قطعة الغيار"
                                                           Style="{StaticResource ExclusiveLabel}"/>

                                                <TextBox x:Name="SparePartsNameTextBox"
                                                         Style="{StaticResource ExclusiveTextBox}"
                                                         TextChanged="SparePartsNameTextBox_TextChanged"/>


                                                <TextBlock Text="سعر قطعة الغيار"
                                                           Style="{StaticResource ExclusiveLabel}"/>

                                                <TextBox x:Name="SparePartsCostTextBox"
                                                         Style="{StaticResource ExclusiveTextBox}"
                                                         Text="0"
                                                         TextChanged="SparePartsCostTextBox_TextChanged"/>

                                            </StackPanel>

                                        </StackPanel>

                                    </Border>


                                    <!-- ================================================= -->
                                    <!-- TOTAL -->
                                    <!-- ================================================= -->

                                    <Border Background="#EFF6FF"
                                            BorderBrush="#BFDBFE"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="14"
                                            Margin="0,0,0,14">

                                        <Grid>

                                            <Grid.RowDefinitions>

                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>

                                            </Grid.RowDefinitions>


                                            <TextBlock Grid.Row="0"
                                                       Text="التكلفة التقديرية"
                                                       Foreground="#64748B"
                                                       FontSize="12"/>

                                            <TextBlock x:Name="MaintenanceCostSummaryText"
                                                       Grid.Row="0"
                                                       Text="0.00 جنيه"
                                                       HorizontalAlignment="Right"
                                                       Foreground="#334155"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"/>


                                            <TextBlock Grid.Row="1"
                                                       Text="سعر قطعة الغيار"
                                                       Foreground="#64748B"
                                                       FontSize="12"
                                                       Margin="0,6,0,0"/>

                                            <TextBlock x:Name="SparePartsCostSummaryText"
                                                       Grid.Row="1"
                                                       Text="0.00 جنيه"
                                                       HorizontalAlignment="Right"
                                                       Foreground="#334155"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       Margin="0,6,0,0"/>


                                            <Border Grid.Row="2"
                                                    Background="#FFFFFF"
                                                    CornerRadius="8"
                                                    Padding="10"
                                                    Margin="0,10,0,0">

                                                <Grid>

                                                    <TextBlock Text="الإجمالي النهائي"
                                                               Foreground="#2563EB"
                                                               FontSize="15"
                                                               FontWeight="Bold"/>

                                                    <TextBlock x:Name="TotalMaintenanceCostText"
                                                               Text="0.00 جنيه"
                                                               HorizontalAlignment="Right"
                                                               Foreground="#172033"
                                                               FontSize="18"
                                                               FontWeight="Bold"/>

                                                </Grid>

                                            </Border>

                                        </Grid>

                                    </Border>


                                    <TextBlock Text="موعد التسليم المتوقع"
                                               Style="{StaticResource ExclusiveLabel}"/>

                                    <DatePicker x:Name="DeliveryDatePicker"
                                                Height="45"
                                                Margin="0,6,0,14"/>

                                </StackPanel>

                            </Border>

                        </Grid>

                    </ScrollViewer>


                    <!-- ACTION BAR -->

                    <Border Grid.Row="1"
                            Background="#FFFFFF"
                            CornerRadius="14"
                            Padding="15"
                            Margin="0,15,0,0"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1">

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Left">

                            <Button Content="💾 حفظ واعتماد الفاتورة"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Style="{StaticResource PrimaryActionBtn}"
                                    Click="SaveMaintenanceButton_Click"
                                    Width="199"/>


                            <Button Content="🧹 مسح"
                                    Style="{StaticResource SecondaryActionBtn}"
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Margin="12,0,0,0"
                                    Click="ClearFormButton_Click"
                                    Width="130"/>

                        </StackPanel>

                    </Border>

                </Grid>

            </TabItem>


            <!-- ===================================================== -->
            <!-- TAB 2 : ACTIVE INVOICES -->
            <!-- ===================================================== -->

            <TabItem Header="📋 فواتير الصيانة الحالية">

                <Grid Margin="8,10,8,5">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>


                    <!-- SEARCH -->

                    <Border Grid.Row="0"
                            Background="#FFFFFF"
                            CornerRadius="14"
                            Padding="15"
                            Margin="0,0,0,12"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>


                            <TextBox x:Name="MaintenanceSearchTextBox"
                                     Grid.Column="0"
                                     Style="{StaticResource ExclusiveTextBox}"
                                     TextChanged="MaintenanceSearchTextBox_TextChanged"
                                     ToolTip="ابحث برقم الفاتورة، اسم العميل، رقم الهاتف، أو اسم الجهاز"
                                     Margin="0,6,15,14"/>


                            <Button Grid.Column="1"
                                    Content="🔄 تحديث الجدول"
                                    Style="{StaticResource SecondaryActionBtn}"
                                    Height="40"
                                    Padding="20,0"
                                    Margin="10,8,0,17"
                                    Click="RefreshMaintenanceButton_Click"/>

                        </Grid>

                    </Border>


                    <!-- ACTIVE TABLE -->

                    <Border Grid.Row="1"
                            Background="#FFFFFF"
                            CornerRadius="14"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            Padding="0">

                        <DataGrid x:Name="MaintenanceInvoicesGrid"
                                  Style="{StaticResource ModernDataGrid}"
                                  RowStyle="{StaticResource ModernDataGridRow}"
                                  CellStyle="{StaticResource CenteredDataGridCell}"
                                  ColumnHeaderStyle="{StaticResource CenteredDataGridHeader}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  RowHeight="50"
                                  HeadersVisibility="Column"
                                  MouseDoubleClick="MaintenanceInvoicesGrid_MouseDoubleClick"
                                  SelectionChanged="MaintenanceInvoicesGrid_SelectionChanged">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="رقم الفاتورة"
                                                    Binding="{Binding InvoiceNumber}"
                                                    Width="120"
                                                    ElementStyle="{StaticResource CenteredTextStyle}"/>

                                <DataGridTextColumn Header="العميل"
                                                    Binding="{Binding CustomerName}"
                                                    Width="*"
                                                    MinWidth="130"
                                                    ElementStyle="{StaticResource CenteredTextStyle}"/>

                                <DataGridTextColumn Header="الهاتف"
                                                    Binding="{Binding CustomerPhone}"
                                                    Width="140"
                                                    ElementStyle="{StaticResource CenteredTextStyle}"/>

                                <DataGridTextColumn Header="الجهاز"
                                                    Binding="{Binding DeviceName}"
                                                    Width="*"
                                                    MinWidth="150"
                                                    ElementStyle="{StaticResource CenteredTextStyle}"/>

                                <DataGridTextColumn Header="نوع الصيانة"
                                                    Binding="{Binding MaintenanceType}"
                                                    Width="140"
                                                    ElementStyle="{StaticResource CenteredTextStyle}"/>

                                <DataGridTextColumn Header="السعر"
                                                    Binding="{Binding Price, StringFormat={}{0:N2}}"
                                                    Width="105"
                                                    ElementStyle="{StaticResource CenteredTextStyle}"/>

                                <DataGridTextColumn Header="التسليم"
                                                    Binding="{Binding DeliveryDate, StringFormat={}{0:dd/MM/yyyy}}"
                                                    Width="130"
                                                    ElementStyle="{StaticResource CenteredTextStyle}"/>


                                <DataGridTemplateColumn Header="التحكم السريع"
                                                        Width="300">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">

                                                <Button Content="✏ تعديل"
                                                        Tag="{Binding MaintenanceID}"
                                                        Click="EditMaintenanceButton_Click"
                                                        Style="{StaticResource TableActionButton}"
                                                        Background="#ECFDF5"
                                                        Foreground="#15803D"
                                                        ToolTip="تعديل الفاتورة"
                                                        MinWidth="65"
                                                        Height="34"/>

                                                <Button Content="✓ تسليم"
                                                        Tag="{Binding MaintenanceID}"
                                                        Click="CompleteMaintenanceButton_Click"
                                                        Style="{StaticResource TableActionButton}"
                                                        Background="#EFF6FF"
                                                        Foreground="#2563EB"
                                                        ToolTip="تسليم الجهاز"
                                                        MinWidth="70"
                                                        Height="34"/>

                                                <Button Content="🗑 حذف"
                                                        Tag="{Binding MaintenanceID}"
                                                        Click="DeleteMaintenanceButton_Click"
                                                        Style="{StaticResource TableActionButton}"
                                                        Background="#FEF2F2"
                                                        Foreground="#DC2626"
                                                        ToolTip="حذف الفاتورة"
                                                        MinWidth="65"
                                                        Height="34"/>

                                            </StackPanel>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Border>

                </Grid>

            </TabItem>


            <!-- ===================================================== -->
            <!-- TAB 3 : ARCHIVE -->
            <!-- ===================================================== -->

            <TabItem Header="📦 الأرشيف وسجل التسليمات">

                <Grid Margin="8,10,8,5">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>


                    <!-- ARCHIVE HEADER -->

                    <Border Grid.Row="0"
                            Background="#FFFFFF"
                            CornerRadius="14"
                            Padding="16"
                            Margin="0,0,0,12"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>


                            <StackPanel>

                                <TextBlock Text="📦 سجل الصيانة المكتمل"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#172033"/>

                                <TextBlock Text="عرض ومراجعة جميع عمليات الصيانة التي تم الانتهاء منها"
                                           FontSize="12"
                                           Foreground="#64748B"
                                           Margin="0,4,0,0"/>

                            </StackPanel>


                            <Border Grid.Column="1"
                                    Background="#F8FAFC"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14,7">

                                <TextBlock Text="السجل المكتمل"
                                           Foreground="#64748B"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>

                            </Border>

                        </Grid>

                    </Border>


                    <!-- COMPLETED TABLE -->

                    <Border Grid.Row="1"
                            Background="#FFFFFF"
                            CornerRadius="14"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1">

                        <DataGrid x:Name="CompletedMaintenanceInvoicesGrid"
                                  Style="{StaticResource ModernDataGrid}"
                                  RowStyle="{StaticResource ModernDataGridRow}"
                                  CellStyle="{StaticResource CenteredDataGridCell}"
                                  ColumnHeaderStyle="{StaticResource CenteredDataGridHeader}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  RowHeight="50"
                                  FontSize="13"
                                  HeadersVisibility="Column"
                                  MouseDoubleClick="CompletedMaintenanceInvoicesGrid_MouseDoubleClick">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="رقم الفاتورة"
                                                    Binding="{Binding InvoiceNumber}"
                                                    Width="130"
                                                    ElementStyle="{StaticResource CenteredTextStyle}"/>

                                <DataGridTextColumn Header="اسم العميل"
                                                    Binding="{Binding CustomerName}"
                                                    Width="*"
                                                    MinWidth="150"
                                                    ElementStyle="{StaticResource CenteredTextStyle}"/>

                                <DataGridTextColumn Header="الهاتف"
                                                    Binding="{Binding CustomerPhone}"
                                                    Width="140"
                                                    ElementStyle="{StaticResource CenteredTextStyle}"/>

                                <DataGridTextColumn Header="الجهاز"
                                                    Binding="{Binding DeviceName}"
                                                    Width="*"
                                                    MinWidth="160"
                                                    ElementStyle="{StaticResource CenteredTextStyle}"/>

                                <DataGridTextColumn Header="التكلفة الإجمالية"
                                                    Binding="{Binding Price, StringFormat={}{0:N2}}"
                                                    Width="150"
                                                    ElementStyle="{StaticResource CenteredTextStyle}"/>

                                <DataGridTextColumn Header="الحالة النهائية"
                                                    Binding="{Binding Status}"
                                                    Width="140"
                                                    ElementStyle="{StaticResource CenteredTextStyle}"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Border>

                </Grid>

            </TabItem>

        </TabControl>

    </Grid>

</Window>