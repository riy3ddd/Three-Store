<Window x:Class="WpfApp1.Views.InventoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="جرد المنتجات"
        Height="800"
        Width="1450"
        FlowDirection="RightToLeft"
        FontFamily="29 LT BUKRA REGULAR"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9">

    <Window.Resources>

        <!-- ===================================================== -->
        <!-- ستايل الأزرار العامة -->
        <!-- ===================================================== -->
        <Style TargetType="Button" x:Key="ModernButtonStyle">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- ===================================================== -->
        <!-- ستايل مربع البحث -->
        <!-- ===================================================== -->
        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Background" Value="White"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">

                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">

                            <ScrollViewer x:Name="PART_ContentHost"/>

                        </Border>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- ===================================================== -->
        <!-- ستايل قيم الـ DataGrid -->
        <!-- ===================================================== -->
        <Style x:Key="InventoryCellTextStyle"
               TargetType="TextBlock">

            <Setter Property="HorizontalAlignment"
                    Value="Center"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="TextAlignment"
                    Value="Center"/>

            <Setter Property="TextWrapping"
                    Value="NoWrap"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="Foreground"
                    Value="#1E293B"/>

        </Style>


        <!-- ===================================================== -->
        <!-- ستايل عناوين الأعمدة -->
        <!-- ===================================================== -->
        <Style TargetType="DataGridColumnHeader">

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="FontSize"
                    Value="16"/>

            <Setter Property="Foreground"
                    Value="#334155"/>

            <Setter Property="Background"
                    Value="#F8FAFC"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="5,0"/>

        </Style>


        <!-- ===================================================== -->
        <!-- ستايل خلايا الجدول -->
        <!-- ===================================================== -->
        <Style TargetType="DataGridCell">

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="5,0"/>

        </Style>

    </Window.Resources>


    <Grid Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- عنوان الصفحة -->
        <!-- ===================================================== -->

        <Grid Grid.Row="0"
              Margin="0,0,0,15">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>


            <StackPanel Grid.Column="0"
                        VerticalAlignment="Center">

                <TextBlock Text="📋 جرد المنتجات"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#1E293B"/>

                <TextBlock Text="عرض كامل للمخزون وقيمة المنتجات الحالية بالمحل"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#64748B"
                           Margin="0,4,0,0"/>

            </StackPanel>


            <!-- ================================================= -->
            <!-- إجمالي الجرد -->
            <!-- ================================================= -->

            <Border Grid.Column="1"
                    Background="#F0FDF4"
                    BorderBrush="#BBF7D0"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18,10"
                    Margin="10,0,0,0">

                <StackPanel>

                    <TextBlock Text="إجمالي قيمة البيع"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#64748B"
                               HorizontalAlignment="Center"/>

                    <TextBlock x:Name="TotalSellingValueTextBlock"
                               Text="0.00 ج.م"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="#16A34A"
                               HorizontalAlignment="Center"
                               Margin="0,3,0,0"/>

                </StackPanel>

            </Border>

        </Grid>


        <!-- ===================================================== -->
        <!-- مربع البحث -->
        <!-- ===================================================== -->

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="12"
                Margin="0,0,0,15">

            <Border.Effect>

                <DropShadowEffect Color="#CBD5E1"
                                  BlurRadius="10"
                                  ShadowDepth="2"
                                  Direction="270"/>

            </Border.Effect>


            <Grid>

                <TextBox x:Name="SearchTextBox"
                         Height="48"
                         FontSize="20"
                         FontWeight="Bold"
                         Padding="1"
                         VerticalContentAlignment="Center"
                         Text="🔍 ابحث عن منتج بالاسم..."
                         Foreground="#94A3B8"
                         TextChanged="SearchTextBox_TextChanged"
                         GotFocus="SearchTextBox_GotFocus"
                         LostFocus="SearchTextBox_LostFocus"/>

            </Grid>

        </Border>


        <!-- ===================================================== -->
        <!-- جدول الجرد -->
        <!-- ===================================================== -->

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="12"
                Padding="15">

            <Border.Effect>

                <DropShadowEffect Color="#CBD5E1"
                                  BlurRadius="10"
                                  ShadowDepth="2"
                                  Direction="270"/>

            </Border.Effect>


            <DataGrid x:Name="InventoryDataGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      Background="Transparent"
                      BorderBrush="#F1F5F9"
                      FontSize="17"
                      FontWeight="Bold"
                      RowHeight="50"
                      LoadingRow="InventoryDataGrid_LoadingRow"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      CanUserReorderColumns="False">


                <DataGrid.Columns>


                    <!-- ================================================= -->
                    <!-- الرقم -->
                    <!-- ================================================= -->

                    <DataGridTemplateColumn Header="الرقم"
                                            Width="70">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Header}"
                                           Style="{StaticResource InventoryCellTextStyle}"/>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>


                    <!-- ================================================= -->
                    <!-- التصنيف -->
                    <!-- ================================================= -->

                    <DataGridTextColumn Header="التصنيف"
                                        Binding="{Binding CategoryName}"
                                        Width="180">

                        <DataGridTextColumn.ElementStyle>

                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource InventoryCellTextStyle}"/>

                        </DataGridTextColumn.ElementStyle>

                    </DataGridTextColumn>


                    <!-- ================================================= -->
                    <!-- اسم المنتج -->
                    <!-- ================================================= -->

                    <DataGridTextColumn Header="اسم المنتج"
                                        Binding="{Binding ProductName}"
                                        Width="*">

                        <DataGridTextColumn.ElementStyle>

                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource InventoryCellTextStyle}">

                                <Setter Property="TextAlignment"
                                        Value="Center"/>

                                <Setter Property="HorizontalAlignment"
                                        Value="Center"/>

                            </Style>

                        </DataGridTextColumn.ElementStyle>

                    </DataGridTextColumn>


                    <!-- ================================================= -->
                    <!-- الكمية -->
                    <!-- ================================================= -->

                    <DataGridTextColumn Header="الكمية"
                                        Binding="{Binding Quantity}"
                                        Width="90">

                        <DataGridTextColumn.ElementStyle>

                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource InventoryCellTextStyle}"/>

                        </DataGridTextColumn.ElementStyle>

                    </DataGridTextColumn>


                    <!-- ================================================= -->
                    <!-- سعر شراء القطعة -->
                    <!-- ================================================= -->

                    <DataGridTextColumn Header="سعر شراء القطعة"
                                        Binding="{Binding PurchasePrice, StringFormat={}{0:N2} ج.م}"
                                        Width="150">

                        <DataGridTextColumn.ElementStyle>

                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource InventoryCellTextStyle}"/>

                        </DataGridTextColumn.ElementStyle>

                    </DataGridTextColumn>


                    <!-- ================================================= -->
                    <!-- سعر بيع القطعة -->
                    <!-- ================================================= -->

                    <DataGridTextColumn Header="سعر بيع القطعة"
                                        Binding="{Binding SellingPrice, StringFormat={}{0:N2} ج.م}"
                                        Width="150">

                        <DataGridTextColumn.ElementStyle>

                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource InventoryCellTextStyle}"/>

                        </DataGridTextColumn.ElementStyle>

                    </DataGridTextColumn>


                    <!-- ================================================= -->
                    <!-- إجمالي الشراء -->
                    <!-- ================================================= -->

                    <DataGridTextColumn Header="إجمالي الشراء"
                                        Binding="{Binding TotalPurchase, StringFormat={}{0:N2} ج.م}"
                                        Width="150">

                        <DataGridTextColumn.ElementStyle>

                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource InventoryCellTextStyle}"/>

                        </DataGridTextColumn.ElementStyle>

                    </DataGridTextColumn>


                    <!-- ================================================= -->
                    <!-- إجمالي البيع -->
                    <!-- ================================================= -->

                    <DataGridTextColumn Header="إجمالي البيع"
                                        Binding="{Binding TotalSelling, StringFormat={}{0:N2} ج.م}"
                                        Width="150">

                        <DataGridTextColumn.ElementStyle>

                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource InventoryCellTextStyle}"/>

                        </DataGridTextColumn.ElementStyle>

                    </DataGridTextColumn>


                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</Window>