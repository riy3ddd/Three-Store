<Window x:Class="WpfApp1.Views.SalesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="نظام المبيعات - واجهة العمليات"
        Width="1250"
        Height="720"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="#F4F6F9">

    <Window.Resources>
        <!-- ستايل عام للأزرار -->
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ستايل عصري للـ ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- العنوان -->
        <TextBlock Grid.Row="0"
                   Text="🛒 شاشة المبيعات الرئيسية"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#2C3E50"
                   Margin="0,0,0,15"/>

        <!-- البحث ورقم الفاتورة -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="15"
                Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect Color="#CBD5E1" BlurRadius="10" ShadowDepth="2" Direction="270"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox"
                         Grid.Column="0"
                         FontSize="20"
                         Padding="12,8"
                         VerticalContentAlignment="Center"
                         Text="ابحث عن منتج بالاسم 🔍..."
                         Foreground="#94A3B8"
                         GotFocus="SearchBox_GotFocus"
                         LostFocus="SearchBox_LostFocus"
                         TextChanged="SearchBox_TextChanged"/>

                <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="8" Padding="15,8" Margin="15,0,0,0">
                    <TextBlock x:Name="InvoiceNumberText"
                               Text="رقم الفاتورة: 1"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#334155"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- المنطقة الرئيسية -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>

            <!-- المنتجات -->
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="12"
                    Margin="0,0,10,0"
                    Padding="15">
                <Border.Effect>
                    <DropShadowEffect Color="#CBD5E1" BlurRadius="10" ShadowDepth="2" Direction="270"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="المنتجات المتاحة"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#1E293B"
                               Margin="0,0,0,12"/>

                    <DataGrid x:Name="ProductsGrid"
                              Grid.Row="1"
                              FontSize="15"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              Background="Transparent"
                              BorderBrush="#F1F5F9"
                              LoadingRow="ProductsGrid_LoadingRow">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="الرقم" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Header}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="المنتج" Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTextColumn Header="المتاح" Binding="{Binding Quantity}" Width="75"/>
                            <DataGridTextColumn Header="السعر" Binding="{Binding SellingPrice}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- سلة المبيعات -->
            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="12"
                    Margin="10,0,0,0"
                    Padding="15">
                <Border.Effect>
                    <DropShadowEffect Color="#CBD5E1" BlurRadius="10" ShadowDepth="2" Direction="270"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="سلة المبيعات الحالية"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#1E293B"
                               Margin="0,0,0,12"/>

                    <DataGrid x:Name="CartGrid"
                              Grid.Row="1"
                              FontSize="15"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              Background="Transparent"
                              BorderBrush="#F1F5F9"
                              IsReadOnly="False"
                              PreviewKeyDown="CartGrid_PreviewKeyDown">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الرقم" Binding="{Binding CartNumber}" Width="55" IsReadOnly="True"/>
                            <DataGridTextColumn Header="المنتج" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="75" IsReadOnly="False"/>
                            <DataGridTextColumn Header="السعر" Binding="{Binding SellingPrice}" Width="85" IsReadOnly="True"/>
                            <DataGridTextColumn Header="الإجمالي" Binding="{Binding Total}" Width="90" IsReadOnly="True"/>

                            <!-- عمود الحذف -->
                            <DataGridTemplateColumn Header="حذف" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕"
                                                Width="28" Height="28"
                                                FontSize="14"
                                                FontWeight="Bold"
                                                Foreground="#EF4444"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="DeleteCartItem_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- أسفل الشاشة (الـ Footer المودرن المتكامل) -->
        <Border Grid.Row="3"
                Background="White"
                CornerRadius="12"
                Padding="20,15"
                Margin="0,15,0,0">
            <Border.Effect>
                <DropShadowEffect Color="#CBD5E1" BlurRadius="10" ShadowDepth="2" Direction="270"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel HorizontalAlignment="Center"
            Margin="0,10,0,0">

                    <!-- الإجمالي قبل الخصم -->

                    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Center">

                        <TextBlock Text="الإجمالي: "
                   FontSize="17"
                   FontWeight="SemiBold"
                   Foreground="#475569"/>

                        <TextBlock x:Name="SubtotalText"
                   Text="0.00 جنيه"
                   FontSize="17"
                   FontWeight="Bold"
                   Foreground="#475569"/>

                    </StackPanel>


                    <!-- الخصم -->

                    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Center"
                Margin="0,8,0,0">

                        <TextBlock Text="الخصم: "
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="#B45309"
                   VerticalAlignment="Center"/>

                        <TextBox x:Name="DiscountTextBox"
                 Width="110"
                 Height="36"
                 Margin="8,0,0,0"
                 Padding="8,0"
                 FontSize="15"
                 Text="0"
                 VerticalContentAlignment="Center"
                 TextAlignment="Center"
                 TextChanged="DiscountTextBox_TextChanged"/>

                        <TextBlock Text="جنيه"
                   FontSize="14"
                   Foreground="#64748B"
                   VerticalAlignment="Center"
                   Margin="6,0,0,0"/>

                    </StackPanel>


                    <!-- الإجمالي النهائي -->

                    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Center"
                Margin="0,8,0,0">

                        <TextBlock Text="الإجمالي بعد الخصم: "
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="#065F46"/>

                        <TextBlock x:Name="GrandTotalText"
                   Text="0.00 جنيه"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="#16A34A"/>

                    </StackPanel>

                </StackPanel>
                <!-- قسم الدفع والأزرار بتصميم احترافي متناسق -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">


                    <!-- زر مسح السلة -->
                    <Button Content="🗑 مسح"
                            Width="95"
                            Height="42"
                            Background="#FEE2E2"
                            Foreground="#DC2626"
                            Margin="0,0,10,0"
                            Click="ClearCartButton_Click"/>

                    <!-- زر إتمام البيع -->
                    <Button Content="✔ إتمام البيع"
                            Width="140"
                            Height="42"
                            Background="#22C55E"
                            Foreground="White"
                            Click="CompleteSaleButton_Click"/>

                </StackPanel>

            </Grid>
        </Border>

    </Grid>
</Window>