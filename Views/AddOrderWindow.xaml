<Window x:Class="WpfApp1.Views.AddOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إضافة طلبية جديدة"
        Width="620"
        Height="780"
        MinWidth="620"
        MinHeight="780"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- ================================
             Shadows
             ================================ -->

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="18"
                          ShadowDepth="2"
                          Direction="270"
                          Opacity="0.10"/>


        <!-- ================================
             Label
             ================================ -->

        <Style x:Key="LabelStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#334155"/>

            <Setter Property="Margin"
                    Value="0,0,0,7"/>

            <Setter Property="HorizontalAlignment"
                    Value="Stretch"/>

            <Setter Property="TextAlignment"
                    Value="Right"/>

        </Style>


        <!-- ================================
             TextBox
             ================================ -->

        <Style x:Key="InputStyle"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="44"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Foreground"
                    Value="#0F172A"/>

            <Setter Property="Background"
                    Value="#FFFFFF"/>

            <Setter Property="BorderBrush"
                    Value="#CBD5E1"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="13,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

        </Style>


        <!-- ================================
             ComboBox
             ================================ -->

        <Style x:Key="ComboStyle"
               TargetType="ComboBox">

            <Setter Property="Height"
                    Value="44"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Foreground"
                    Value="#0F172A"/>

            <Setter Property="Background"
                    Value="#FFFFFF"/>

            <Setter Property="BorderBrush"
                    Value="#CBD5E1"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="12,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

        </Style>


        <!-- ================================
             Primary Button
             ================================ -->

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="46"/>

            <Setter Property="Background"
                    Value="#2563EB"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Padding"
                    Value="22,0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#1D4ED8"/>

                </Trigger>

                <Trigger Property="IsPressed"
                         Value="True">

                    <Setter Property="Background"
                            Value="#1E40AF"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ================================
             Secondary Button
             ================================ -->

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="46"/>

            <Setter Property="Background"
                    Value="#FFFFFF"/>

            <Setter Property="Foreground"
                    Value="#334155"/>

            <Setter Property="BorderBrush"
                    Value="#CBD5E1"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Padding"
                    Value="22,0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#F1F5F9"/>

                    <Setter Property="BorderBrush"
                            Value="#94A3B8"/>

                </Trigger>

                <Trigger Property="IsPressed"
                         Value="True">

                    <Setter Property="Background"
                            Value="#E2E8F0"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ================================
             Section Title
             ================================ -->

        <Style x:Key="SectionTitleStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="Foreground"
                    Value="#0F172A"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

        </Style>


        <!-- ================================
             CheckBox
             ================================ -->

        <Style x:Key="ModernCheckBoxStyle"
               TargetType="CheckBox">

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#334155"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

        </Style>

    </Window.Resources>


    <!-- =========================================
         Main Layout
         ========================================= -->

    <Grid Background="#F8FAFC"
          Margin="24">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>


        <!-- =========================================
             HEADER
             ========================================= -->

        <Grid Grid.Row="0"
              Margin="4,0,4,20">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="Auto"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>


            <!-- Icon -->

            <Border Grid.Column="0"
                    Width="52"
                    Height="52"
                    Background="#EFF6FF"
                    CornerRadius="14"
                    Margin="0,0,14,0">

                <TextBlock Text="🛒"
                           FontSize="24"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"/>

            </Border>


            <!-- Header Text -->

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center">

                <TextBlock Text="إضافة طلبية جديدة"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#0F172A"
                           TextAlignment="Right"/>

                <TextBlock Text="أنشئ طلبية جديدة للعميل وأضف المنتج والكمية المطلوبة."
                           FontSize="13"
                           Foreground="#64748B"
                           Margin="0,5,0,0"
                           TextWrapping="Wrap"
                           TextAlignment="Right"/>

            </StackPanel>

        </Grid>


        <!-- =========================================
             FORM
             ========================================= -->

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel>


                <!-- =================================
                     CUSTOMER CARD
                     ================================= -->

                <Border Background="#FFFFFF"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="20"
                        Margin="0,0,0,14"
                        Effect="{StaticResource CardShadow}">

                    <StackPanel>

                        <!-- Section Header -->

                        <Grid Margin="0,0,0,16">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="Auto"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <Border Grid.Column="0"
                                    Width="34"
                                    Height="34"
                                    Background="#F1F5F9"
                                    CornerRadius="9"
                                    Margin="0,0,10,0">

                                <TextBlock Text="👤"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>


                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">

                                <TextBlock Text="بيانات العميل"
                                           Style="{StaticResource SectionTitleStyle}"/>

                                <TextBlock Text="بيانات الشخص صاحب الطلبية"
                                           FontSize="11"
                                           Foreground="#94A3B8"
                                           Margin="0,2,0,0"/>

                            </StackPanel>

                        </Grid>


                        <!-- Customer Name -->

                        <TextBlock Text="اسم العميل"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBox x:Name="CustomerNameTextBox"
                                 Style="{StaticResource InputStyle}"
                                 Margin="0,0,0,14"/>


                        <!-- Phone -->

                        <TextBlock Text="رقم الهاتف"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBox x:Name="CustomerPhoneTextBox"
                                 Style="{StaticResource InputStyle}"/>

                    </StackPanel>

                </Border>


                <!-- =================================
                     PRODUCT CARD
                     ================================= -->

                <Border Background="#FFFFFF"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="20"
                        Margin="0,0,0,14"
                        Effect="{StaticResource CardShadow}">

                    <StackPanel>

                        <!-- Section Header -->

                        <Grid Margin="0,0,0,16">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="Auto"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <Border Grid.Column="0"
                                    Width="34"
                                    Height="34"
                                    Background="#ECFDF5"
                                    CornerRadius="9"
                                    Margin="0,0,10,0">

                                <TextBlock Text="📦"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>


                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">

                                <TextBlock Text="تفاصيل الطلب"
                                           Style="{StaticResource SectionTitleStyle}"/>

                                <TextBlock Text="اختر المنتج وحدد الكمية المطلوبة"
                                           FontSize="11"
                                           Foreground="#94A3B8"
                                           Margin="0,2,0,0"/>

                            </StackPanel>

                        </Grid>


                        <!-- Existing Product -->

                        <TextBlock Text="المنتج الموجود"
                                   Style="{StaticResource LabelStyle}"/>

                        <ComboBox x:Name="ProductComboBox"
                                  Style="{StaticResource ComboStyle}"
                                  DisplayMemberPath="ProductName"
                                  SelectedValuePath="ProductID"
                                  SelectionChanged="ProductComboBox_SelectionChanged"
                                  Margin="0,0,0,12"/>


                        <!-- Manual Product Toggle -->

                        <Border Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12"
                                Margin="0,0,0,14">

                            <CheckBox x:Name="ManualProductCheckBox"
                                      Style="{StaticResource ModernCheckBoxStyle}"
                                      Content="المنتج غير موجود — إدخال اسم المنتج يدويًا"
                                      IsChecked="False"
                                      Checked="ManualProductCheckBox_Checked"
                                      Unchecked="ManualProductCheckBox_Unchecked"/>

                        </Border>


                        <!-- Manual Product -->

                        <TextBlock Text="اسم المنتج المطلوب"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBox x:Name="ManualProductTextBox"
                                 Style="{StaticResource InputStyle}"
                                 IsEnabled="False"
                                 Margin="0,0,0,14"/>


                        <!-- Quantity -->

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <StackPanel>

                                <TextBlock Text="الكمية"
                                           Style="{StaticResource LabelStyle}"/>

                                <TextBox x:Name="QuantityTextBox"
                                         Style="{StaticResource InputStyle}"
                                         Text="1"
                                         PreviewTextInput="QuantityTextBox_PreviewTextInput"/>

                            </StackPanel>

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- =================================
                     NOTES CARD
                     ================================= -->

                <Border Background="#FFFFFF"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="20"
                        Margin="0,0,0,6"
                        Effect="{StaticResource CardShadow}">

                    <StackPanel>

                        <Grid Margin="0,0,0,14">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="Auto"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <Border Grid.Column="0"
                                    Width="34"
                                    Height="34"
                                    Background="#FFF7ED"
                                    CornerRadius="9"
                                    Margin="0,0,10,0">

                                <TextBlock Text="📝"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>


                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">

                                <TextBlock Text="ملاحظات"
                                           Style="{StaticResource SectionTitleStyle}"/>

                                <TextBlock Text="أي تفاصيل إضافية تخص الطلبية"
                                           FontSize="11"
                                           Foreground="#94A3B8"
                                           Margin="0,2,0,0"/>

                            </StackPanel>

                        </Grid>


                        <TextBox x:Name="NoteTextBox"
                                 Height="90"
                                 FontSize="14"
                                 Foreground="#0F172A"
                                 Background="#FFFFFF"
                                 BorderBrush="#CBD5E1"
                                 BorderThickness="1"
                                 Padding="13"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 VerticalContentAlignment="Top"
                                 HorizontalContentAlignment="Stretch"/>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>


        <!-- =========================================
             BOTTOM ACTIONS
             ========================================= -->

        <Border Grid.Row="2"
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="14"
                Padding="14"
                Margin="0,16,0,0">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="12"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>


                <!-- Cancel -->

                <Button Grid.Column="0"
                        Content="إلغاء"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="CancelButton_Click"/>


                <!-- Save -->

                <Button Grid.Column="2"
                        Content="حفظ الطلبية"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="SaveButton_Click"/>

            </Grid>

        </Border>

    </Grid>

</Window>