<Window x:Class="WpfApp1.Views.AddDeviceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إضافة جهاز"
        Height="720"
        Width="880"
        MinHeight="650"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="#F8FAFC"
        ResizeMode="NoResize"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- =========================================================
             COLORS
             ========================================================= -->

        <SolidColorBrush x:Key="TextBrush"
                         Color="#0F172A"/>

        <SolidColorBrush x:Key="SecondaryTextBrush"
                         Color="#64748B"/>

        <SolidColorBrush x:Key="LabelBrush"
                         Color="#334155"/>

        <SolidColorBrush x:Key="BorderBrushSoft"
                         Color="#CBD5E1"/>

        <SolidColorBrush x:Key="InputBackground"
                         Color="#F8FAFC"/>

        <SolidColorBrush x:Key="PrimaryBrush"
                         Color="#2563EB"/>

        <SolidColorBrush x:Key="PrimaryHoverBrush"
                         Color="#1D4ED8"/>

        <SolidColorBrush x:Key="PrimaryPressedBrush"
                         Color="#1E40AF"/>

        <SolidColorBrush x:Key="CancelBrush"
                         Color="#E2E8F0"/>

        <SolidColorBrush x:Key="CancelHoverBrush"
                         Color="#CBD5E1"/>

        <SolidColorBrush x:Key="CancelPressedBrush"
                         Color="#94A3B8"/>


        <!-- =========================================================
             SHADOW
             ========================================================= -->

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="18"
                          ShadowDepth="2"
                          Direction="270"
                          Opacity="0.08"/>


        <!-- =========================================================
             PRIMARY BUTTON
             ========================================================= -->

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="{StaticResource PrimaryBrush}"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Padding"
                    Value="18,0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="{StaticResource PrimaryHoverBrush}"/>

                </Trigger>

                <Trigger Property="IsPressed"
                         Value="True">

                    <Setter Property="Background"
                            Value="{StaticResource PrimaryPressedBrush}"/>

                </Trigger>

                <Trigger Property="IsEnabled"
                         Value="False">

                    <Setter Property="Opacity"
                            Value="0.55"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- =========================================================
             SECONDARY BUTTON
             ========================================================= -->

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="{StaticResource CancelBrush}"/>

            <Setter Property="Foreground"
                    Value="#334155"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Padding"
                    Value="18,0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="{StaticResource CancelHoverBrush}"/>

                </Trigger>

                <Trigger Property="IsPressed"
                         Value="True">

                    <Setter Property="Background"
                            Value="{StaticResource CancelPressedBrush}"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- =========================================================
             FORM TEXTBOX
             ========================================================= -->

        <Style x:Key="FormTextBoxStyle"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Padding"
                    Value="11,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Background"
                    Value="{StaticResource InputBackground}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrushSoft}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextBrush}"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="1"
                                          VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter Property="BorderBrush"
                                        Value="#94A3B8"/>

                            </Trigger>

                            <Trigger Property="IsFocused"
                                     Value="True">

                                <Setter Property="BorderBrush"
                                        Value="#2563EB"/>

                                <Setter Property="BorderThickness"
                                        Value="1.5"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter Property="Opacity"
                                        Value="0.65"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- =========================================================
             FORM COMBOBOX
             ========================================================= -->

        <Style x:Key="FormComboBoxStyle"
               TargetType="ComboBox">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Padding"
                    Value="10,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Background"
                    Value="{StaticResource InputBackground}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrushSoft}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextBrush}"/>

        </Style>


        <!-- =========================================================
             FIELD LABEL
             ========================================================= -->

        <Style x:Key="FieldLabelStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="{StaticResource LabelBrush}"/>

            <Setter Property="Margin"
                    Value="0,0,0,7"/>

        </Style>

    </Window.Resources>


    <!-- =============================================================
         MAIN CONTAINER
         ============================================================= -->

    <Grid Margin="25">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>


        <!-- =========================================================
             HEADER
             ========================================================= -->

        <Grid Grid.Row="0"
              Margin="0,0,0,20">

            <StackPanel>

                <StackPanel Orientation="Horizontal">

                    <!-- Icon -->

                    <Border Width="46"
                            Height="46"
                            Background="#EFF6FF"
                            CornerRadius="12"
                            Margin="0,0,12,0">

                        <TextBlock Text="+"
                                   FontSize="25"
                                   FontWeight="SemiBold"
                                   Foreground="#2563EB"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>


                    <!-- Title -->

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="إضافة جهاز جديد"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"/>

                        <TextBlock Text="أدخل بيانات الجهاز لإضافته إلى المخزون"
                                   FontSize="13"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Margin="0,4,0,0"/>

                    </StackPanel>

                </StackPanel>

            </StackPanel>

        </Grid>


        <!-- =========================================================
             FORM CARD
             ========================================================= -->

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="14"
                Padding="24"
                Effect="{StaticResource CardShadow}">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>


                    <!-- =================================================
                         ROW 0
                         ================================================= -->

                    <!-- Device Name -->

                    <StackPanel Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,0,10,17">

                        <TextBlock Text="اسم الجهاز *"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <TextBox x:Name="DeviceNameTextBox"
                                 Style="{StaticResource FormTextBoxStyle}"/>

                    </StackPanel>


                    <!-- Serial Number -->

                    <StackPanel Grid.Row="0"
                                Grid.Column="1"
                                Margin="10,0,0,17">

                        <TextBlock Text="الرقم التسلسلي"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <TextBox x:Name="SerialNumberTextBox"
                                 Style="{StaticResource FormTextBoxStyle}"/>

                    </StackPanel>


                    <!-- =================================================
                         ROW 1
                         ================================================= -->

                    <!-- Device Type -->

                    <StackPanel Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,0,10,17">

                        <TextBlock Text="نوع الجهاز *"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <ComboBox x:Name="DeviceTypeComboBox"
                                  Style="{StaticResource FormComboBoxStyle}">

                            <ComboBoxItem Content="جديد"
                                          IsSelected="True"/>

                            <ComboBoxItem Content="مستعمل"/>

                        </ComboBox>

                    </StackPanel>


                    <!-- Device Status -->

                    <StackPanel Grid.Row="1"
                                Grid.Column="1"
                                Margin="10,0,0,17">

                        <TextBlock Text="حالة الجهاز"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <ComboBox x:Name="DeviceStatusComboBox"
                                  Style="{StaticResource FormComboBoxStyle}"
                                  IsEnabled="False">

                            <ComboBoxItem Content="متاح"
                                          IsSelected="True"/>

                        </ComboBox>

                    </StackPanel>


                    <!-- =================================================
                         ROW 2
                         ================================================= -->

                    <!-- RAM -->

                    <StackPanel Grid.Row="2"
                                Grid.Column="0"
                                Margin="0,0,10,17">

                        <TextBlock Text="RAM"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <TextBox x:Name="RAMTextBox"
                                 Style="{StaticResource FormTextBoxStyle}"/>

                    </StackPanel>


                    <!-- Storage -->

                    <StackPanel Grid.Row="2"
                                Grid.Column="1"
                                Margin="10,0,0,17">

                        <TextBlock Text="Storage"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <TextBox x:Name="StorageTextBox"
                                 Style="{StaticResource FormTextBoxStyle}"/>

                    </StackPanel>


                    <!-- =================================================
                         ROW 3
                         ================================================= -->

                    <!-- Accessories -->

                    <StackPanel Grid.Row="3"
                                Grid.Column="0"
                                Margin="0,0,10,17">

                        <TextBlock Text="الملحقات"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <TextBox x:Name="AccessoriesTextBox"
                                 Style="{StaticResource FormTextBoxStyle}"/>

                    </StackPanel>


                    <!-- Customer Name -->

                    <StackPanel Grid.Row="3"
                                Grid.Column="1"
                                Margin="10,0,0,17">

                        <TextBlock Text="اسم العميل"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <TextBox x:Name="CustomerNameTextBox"
                                 Style="{StaticResource FormTextBoxStyle}"/>

                    </StackPanel>


                    <!-- =================================================
                         ROW 4
                         ================================================= -->

                    <!-- Customer Phone -->

                    <StackPanel Grid.Row="4"
                                Grid.Column="0"
                                Margin="0,0,10,17">

                        <TextBlock Text="رقم العميل"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <TextBox x:Name="CustomerPhoneTextBox"
                                 Style="{StaticResource FormTextBoxStyle}"/>

                    </StackPanel>


                    <!-- Purchase Price -->

                    <StackPanel Grid.Row="4"
                                Grid.Column="1"
                                Margin="10,0,0,17">

                        <TextBlock Text="سعر الشراء"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <TextBox x:Name="PurchasePriceTextBox"
                                 Style="{StaticResource FormTextBoxStyle}"/>

                    </StackPanel>


                    <!-- =================================================
                         ROW 5
                         ================================================= -->

                    <!-- Selling Price -->

                    <StackPanel Grid.Row="5"
                                Grid.Column="0"
                                Margin="0,0,10,0">

                        <TextBlock Text="سعر البيع"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <TextBox x:Name="SellingPriceTextBox"
                                 Style="{StaticResource FormTextBoxStyle}"/>

                    </StackPanel>


                    <!-- Notes -->

                    <StackPanel Grid.Row="5"
                                Grid.Column="1"
                                Margin="10,0,0,0">

                        <TextBlock Text="ملاحظات"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <TextBox x:Name="NotesTextBox"
                                 Style="{StaticResource FormTextBoxStyle}"/>

                    </StackPanel>

                </Grid>

            </ScrollViewer>

        </Border>


        <!-- =========================================================
             FOOTER / ACTIONS
             ========================================================= -->

        <Grid Grid.Row="2"
              Margin="0,18,0,0">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>


            <!-- Required Fields Hint -->

            <TextBlock Grid.Column="0"
                       Text="* الحقول المطلوبة"
                       FontSize="12"
                       Foreground="#94A3B8"
                       VerticalAlignment="Center"/>


            <!-- Buttons -->

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">

                <Button Content="إلغاء"
                        Width="110"
                        Height="44"
                        Margin="0,0,10,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="CancelButton_Click"/>

                <Button Content="حفظ الجهاز"
                        Width="145"
                        Height="44"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="SaveButton_Click"/>

            </StackPanel>

        </Grid>

    </Grid>

</Window>