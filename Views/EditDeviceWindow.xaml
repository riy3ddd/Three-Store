<Window x:Class="WpfApp1.Views.EditDeviceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تعديل الجهاز"
        Height="720"
        Width="900"
        MinHeight="650"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="#F5F7FA"
        ResizeMode="NoResize">

    <Window.Resources>

        <!-- ========================= -->
        <!-- TextBox -->
        <!-- ========================= -->

        <Style TargetType="TextBox">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="Padding"
                    Value="12,0"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Foreground"
                    Value="#1F2937"/>

            <Setter Property="Background"
                    Value="#F9FAFB"/>

            <Setter Property="BorderBrush"
                    Value="#E5E7EB"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>


        <!-- ========================= -->
        <!-- ComboBox -->
        <!-- ========================= -->

        <Style TargetType="ComboBox">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Foreground"
                    Value="#1F2937"/>

            <Setter Property="Background"
                    Value="#F9FAFB"/>

            <Setter Property="BorderBrush"
                    Value="#E5E7EB"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>


        <!-- ========================= -->
        <!-- Buttons -->
        <!-- ========================= -->

        <Style x:Key="CancelButtonStyle"
               TargetType="Button">

            <Setter Property="Width"
                    Value="115"/>

            <Setter Property="Height"
                    Value="44"/>

            <Setter Property="Background"
                    Value="#F3F4F6"/>

            <Setter Property="Foreground"
                    Value="#374151"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <Style x:Key="SaveButtonStyle"
               TargetType="Button">

            <Setter Property="Width"
                    Value="155"/>

            <Setter Property="Height"
                    Value="44"/>

            <Setter Property="Background"
                    Value="#2563EB"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <!-- ========================= -->
    <!-- MAIN -->
    <!-- ========================= -->

    <Grid Margin="25">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>


        <!-- ========================= -->
        <!-- HEADER -->
        <!-- ========================= -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">

            <TextBlock Text="تعديل بيانات الجهاز"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#1F2937"/>

            <TextBlock Text="قم بتعديل بيانات الجهاز ثم اضغط حفظ التعديلات"
                       FontSize="14"
                       Foreground="#6B7280"
                       Margin="0,6,0,0"/>

        </StackPanel>


        <!-- ========================= -->
        <!-- FORM CARD -->
        <!-- ========================= -->

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="14"
                Padding="28">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="24"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>


                    <!-- ========================= -->
                    <!-- ROW 0 -->
                    <!-- ========================= -->

                    <!-- اسم الجهاز -->

                    <StackPanel Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,0,0,18">

                        <TextBlock Text="اسم الجهاز *"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"
                                   Margin="0,0,0,7"/>

                        <TextBox x:Name="DeviceNameTextBox"/>

                    </StackPanel>


                    <!-- الرقم التسلسلي -->

                    <StackPanel Grid.Row="0"
                                Grid.Column="2"
                                Margin="0,0,0,18">

                        <TextBlock Text="الرقم التسلسلي"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"
                                   Margin="0,0,0,7"/>

                        <TextBox x:Name="SerialNumberTextBox"/>

                    </StackPanel>


                    <!-- ========================= -->
                    <!-- ROW 1 -->
                    <!-- ========================= -->

                    <!-- نوع الجهاز -->

                    <StackPanel Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,0,0,18">

                        <TextBlock Text="نوع الجهاز"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"
                                   Margin="0,0,0,7"/>

                        <ComboBox x:Name="DeviceTypeComboBox">

                            <ComboBoxItem Content="جديد"/>

                            <ComboBoxItem Content="مستعمل"/>

                        </ComboBox>

                    </StackPanel>


                    <!-- الحالة -->

                    <StackPanel Grid.Row="1"
                                Grid.Column="2"
                                Margin="0,0,0,18">

                        <TextBlock Text="الحالة"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"
                                   Margin="0,0,0,7"/>

                        <ComboBox x:Name="DeviceStatusComboBox">

                            <ComboBoxItem Content="متاح"/>

                            <ComboBoxItem Content="مباع"/>

                        </ComboBox>

                    </StackPanel>


                    <!-- ========================= -->
                    <!-- ROW 2 -->
                    <!-- ========================= -->

                    <!-- RAM -->

                    <StackPanel Grid.Row="2"
                                Grid.Column="0"
                                Margin="0,0,0,18">

                        <TextBlock Text="RAM"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"
                                   Margin="0,0,0,7"/>

                        <TextBox x:Name="RAMTextBox"/>

                    </StackPanel>


                    <!-- Storage -->

                    <StackPanel Grid.Row="2"
                                Grid.Column="2"
                                Margin="0,0,0,18">

                        <TextBlock Text="Storage"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"
                                   Margin="0,0,0,7"/>

                        <TextBox x:Name="StorageTextBox"/>

                    </StackPanel>


                    <!-- ========================= -->
                    <!-- ROW 3 -->
                    <!-- ========================= -->

                    <!-- الملحقات -->

                    <StackPanel Grid.Row="3"
                                Grid.Column="0"
                                Margin="0,0,0,18">

                        <TextBlock Text="الملحقات"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"
                                   Margin="0,0,0,7"/>

                        <TextBox x:Name="AccessoriesTextBox"/>

                    </StackPanel>


                    <!-- اسم العميل -->

                    <StackPanel Grid.Row="3"
                                Grid.Column="2"
                                Margin="0,0,0,18">

                        <TextBlock Text="اسم العميل"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"
                                   Margin="0,0,0,7"/>

                        <TextBox x:Name="CustomerNameTextBox"/>

                    </StackPanel>


                    <!-- ========================= -->
                    <!-- ROW 4 -->
                    <!-- ========================= -->

                    <!-- رقم العميل -->

                    <StackPanel Grid.Row="4"
                                Grid.Column="0"
                                Margin="0,0,0,18">

                        <TextBlock Text="رقم العميل"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"
                                   Margin="0,0,0,7"/>

                        <TextBox x:Name="CustomerPhoneTextBox"/>

                    </StackPanel>


                    <!-- سعر الشراء -->

                    <StackPanel Grid.Row="4"
                                Grid.Column="2"
                                Margin="0,0,0,18">

                        <TextBlock Text="سعر الشراء"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"
                                   Margin="0,0,0,7"/>

                        <TextBox x:Name="PurchasePriceTextBox"/>

                    </StackPanel>


                    <!-- ========================= -->
                    <!-- ROW 5 -->
                    <!-- ========================= -->

                    <!-- سعر البيع -->

                    <StackPanel Grid.Row="5"
                                Grid.Column="0"
                                Margin="0,0,0,18">

                        <TextBlock Text="سعر البيع"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"
                                   Margin="0,0,0,7"/>

                        <TextBox x:Name="SellingPriceTextBox"/>

                    </StackPanel>


                    <!-- الملاحظات -->

                    <StackPanel Grid.Row="5"
                                Grid.Column="2"
                                Margin="0,0,0,18">

                        <TextBlock Text="ملاحظات"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"
                                   Margin="0,0,0,7"/>

                        <TextBox x:Name="NotesTextBox"
                                 Height="42"
                                 VerticalContentAlignment="Center"/>

                    </StackPanel>

                </Grid>

            </ScrollViewer>

        </Border>


        <!-- ========================= -->
        <!-- FOOTER BUTTONS -->
        <!-- ========================= -->

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    Margin="0,18,0,0">


            <!-- إلغاء -->

            <Button Content="إلغاء"
                    Style="{StaticResource CancelButtonStyle}"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click"/>


            <!-- حفظ -->

            <Button Content="حفظ التعديلات"
                    Style="{StaticResource SaveButtonStyle}"
                    Click="SaveButton_Click"/>

        </StackPanel>

    </Grid>

</Window>