<Window x:Class="WpfApp1.AddUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Three Store - إضافة عضو جديد"
        Height="670"
        Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Background="#F8FAFC">

    <Window.Resources>
        <!-- Style مشترك لحقول الإدخال لضمان المظهر العصري والنظيف -->
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontFamily" Value="Calibri"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="1.5" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type PasswordBox}">
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type PasswordBox}">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="1.5" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Border Background="White"
                CornerRadius="16"
                Padding="28,24">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="4" BlurRadius="16" Opacity="0.06"/>
            </Border.Effect>

            <StackPanel>

                <!-- رأس الصفحة -->
                <TextBlock Text="إضافة عضو جديد"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#0F172A"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="قم بإدخال بيانات الحساب والصلاحيات بدقة"
                           FontSize="18"
                           Foreground="#64748B"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,24"/>

                <!-- اسم المستخدم -->
                <TextBlock Text="اسم المستخدم"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#334155"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="UsernameTextBox"/>

                <!-- كلمة المرور -->
                <TextBlock Text="كلمة المرور"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#334155"
                           Margin="0,14,0,6"/>
                <PasswordBox x:Name="PasswordBox"/>

                <!-- تأكيد كلمة المرور -->
                <TextBlock Text="تأكيد كلمة المرور"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#334155"
                           Margin="0,14,0,6"/>
                <PasswordBox x:Name="ConfirmPasswordBox"/>

                <!-- الصلاحية -->
                <TextBlock Text="صلاحية العضو"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#334155"
                           Margin="0,14,0,6"/>

                <ComboBox x:Name="RoleComboBox"
          Height="45"
          FontSize="16"
          FontFamily="Calibri"
          SelectedIndex="1"
          VerticalContentAlignment="Center"
          Padding="10,0">

                    <ComboBoxItem Content="مشرف النظام (Admin)"
                  Tag="Admin"/>

                    <ComboBoxItem Content="موظف (Employee)"
                  Tag="Employee"/>

                </ComboBox>
                <!-- رسالة الخطأ (مخفية افتراضياً أو تظهر عند الحاجة) -->
                <TextBlock x:Name="ErrorTextBlock"
                           Foreground="#EF4444"
                           FontSize="13"
                           FontWeight="Medium"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0"/>

                <!-- أزرار الإجراءات -->
                <Button Content="حفظ وإنشاء الحساب"
                        Height="48"
                        Margin="0,20,0,0"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="19"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="AddButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1D4ED8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>
        </Border>
    </Grid>
</Window>